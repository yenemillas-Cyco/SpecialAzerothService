<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== WoW Classic — Gold / Brown / Dark Purple ===== -->

    <SolidColorBrush x:Key="GoldBrush" Color="#C9A44A"/>
    <SolidColorBrush x:Key="BrightGoldBrush" Color="#FFD100"/>
    <SolidColorBrush x:Key="PanelBg" Color="#CC0E0E1A"/>
    <SolidColorBrush x:Key="PanelBg2" Color="#DD151525"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#886B5A33"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E8D5A3"/>
    <SolidColorBrush x:Key="SubtextBrush" Color="#9B8B6E"/>
    <SolidColorBrush x:Key="EpicBrush" Color="#A335EE"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#6B5A33"/>
    <SolidColorBrush x:Key="InnerBorderBrush" Color="#443D2A"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#8B6914"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#BB080810"/>
    <SolidColorBrush x:Key="SelectionBgBrush" Color="#1A1208"/>
    <SolidColorBrush x:Key="SelectionActiveBgBrush" Color="#2A6B2A"/>
    <SolidColorBrush x:Key="HighlightBgBrush" Color="#33C9A44A"/>
    <SolidColorBrush x:Key="CloseHoverBgBrush" Color="#CC8B1A1A"/>

    <RadialGradientBrush x:Key="WindowBgBrush" Center="0.5,0.3" RadiusX="0.8" RadiusY="0.9">
        <GradientStop Color="#2A1F14" Offset="0"/>
        <GradientStop Color="#1A1208" Offset="0.5"/>
        <GradientStop Color="#0D0A06" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="TitleBarBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#22C9A44A" Offset="0"/>
        <GradientStop Color="Transparent" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GoldSepBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="Transparent" Offset="0"/>
        <GradientStop Color="#C9A44A" Offset="0.3"/>
        <GradientStop Color="#C9A44A" Offset="0.7"/>
        <GradientStop Color="Transparent" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TitleTextBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFD100" Offset="0"/>
        <GradientStop Color="#FF8C00" Offset="0.5"/>
        <GradientStop Color="#FFD100" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WowButtonBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8B1A1A" Offset="0"/>
        <GradientStop Color="#5C0E0E" Offset="0.5"/>
        <GradientStop Color="#3D0808" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WowButtonHoverBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A52222" Offset="0"/>
        <GradientStop Color="#7A1414" Offset="0.5"/>
        <GradientStop Color="#5C0E0E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WowButtonPressedBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4A0A0A" Offset="0"/>
        <GradientStop Color="#3D0808" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StoneButtonBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A2535" Offset="0"/>
        <GradientStop Color="#1A1525" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PillBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1E1A28" Offset="0"/>
        <GradientStop Color="#141020" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PillActiveBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2E2840" Offset="0"/>
        <GradientStop Color="#1E1830" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ComboDropdownBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1E1A28" Offset="0"/>
        <GradientStop Color="#0E0A14" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MonitorCardBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1E1A28" Offset="0"/>
        <GradientStop Color="#12101C" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== STYLES ===== -->

    <Style x:Key="WowButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource BrightGoldBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="24,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                            BorderThickness="2" BorderBrush="{StaticResource AccentBorderBrush}"
                            Background="{StaticResource WowButtonBgBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrightGoldBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WowButtonHoverBgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WowButtonPressedBgBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StoneButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="3" Padding="{TemplateBinding Padding}"
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                            Background="{StaticResource StoneButtonBgBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WowPill" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="3" Padding="16,7"
                            BorderThickness="1" BorderBrush="{StaticResource InnerBorderBrush}"
                            Background="{StaticResource PillBgBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrightGoldBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PillActiveBgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Bd" CornerRadius="3" Padding="10,5"
                            BorderThickness="1" BorderBrush="{StaticResource InnerBorderBrush}"
                            Background="{StaticResource PillBgBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrightGoldBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PillActiveBgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Background" Value="{StaticResource PillBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleBtn" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Border" CornerRadius="3"
                                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                            Background="{StaticResource PillBgBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="▾" FontSize="10"
                                                       Foreground="{StaticResource GoldBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ToggleButton.Background>
                                <StaticResource ResourceKey="PillBgBrush"/>
                            </ToggleButton.Background>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="6,3,20,3" VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border x:Name="DropDown" CornerRadius="3" Margin="0,2,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200"
                                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                    Background="{StaticResource ComboDropdownBgBrush}">
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HighlightBgBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrightGoldBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SelectionCheck" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Bd" Width="18" Height="18" CornerRadius="3"
                            BorderThickness="1.5" BorderBrush="{StaticResource BorderBrush}"
                            Background="{StaticResource SelectionBgBrush}">
                        <TextBlock x:Name="Check" Text="✓" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="Transparent"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionActiveBgBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                            <Setter TargetName="Check" Property="Foreground" Value="{StaticResource BrightGoldBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrightGoldBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle button style (stone look, glows when active) — for ToggleButton -->
    <Style x:Key="StoneToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                            BorderThickness="1.5" BorderBrush="{StaticResource BorderBrush}"
                            Background="{StaticResource StoneButtonBgBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WowButtonBgBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrightGoldBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            <Setter Property="Foreground" Value="{StaticResource BrightGoldBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same toggle look for RadioButton (exclusive mode selection) -->
    <Style x:Key="StoneRadioToggle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                            BorderThickness="1.5" BorderBrush="{StaticResource BorderBrush}"
                            Background="{StaticResource StoneButtonBgBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WowButtonBgBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrightGoldBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            <Setter Property="Foreground" Value="{StaticResource BrightGoldBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinCtrlBtn" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HighlightBgBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrightGoldBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinCtrlBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3"
                            Width="32" Height="26">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CloseHoverBgBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrightGoldBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ScrollBars (bandeau Carto, listes, etc.) ===== -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#221C14"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#8B7355"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#C9A44A"/>
    <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" Color="#FFD100"/>

    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBd" Background="{StaticResource ScrollBarThumbBrush}"
                            CornerRadius="4" Margin="2,1"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource ScrollBarThumbHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource ScrollBarThumbPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource ScrollBarTrackBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InnerBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
