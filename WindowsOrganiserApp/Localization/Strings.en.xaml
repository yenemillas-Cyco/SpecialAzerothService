    <!-- Help window -->
    <sys:String x:Key="Help_Title">📖  User Guide</sys:String>
    <sys:String x:Key="Help_Close">Close</sys:String>

    <sys:String x:Key="Help_S1_Title">⚔  Window List</sys:String>
    <sys:String x:Key="Help_S1_Body">The application automatically detects all open WoW windows at launch and after each refresh.</sys:String>
    <sys:String x:Key="Help_S1_B1">☑ WoW only: checked by default, only detects WoW windows. Uncheck to organize all Windows applications</sys:String>
    <sys:String x:Key="Help_S1_B2">☑ Check / uncheck a window to include it in the layout</sys:String>
    <sys:String x:Key="Help_S1_B3">✏ Click on the name to rename it (preserved after refresh)</sys:String>
    <sys:String x:Key="Help_S1_B4">👑 Leader: designate the main window for a monitor (dominant area in Main mode)</sys:String>
    <sys:String x:Key="Help_S1_B5">⛶ Fullscreen: toggle fullscreen, second click restores position</sys:String>
    <sys:String x:Key="Help_S1_B6">🖥 Monitor: choose which display to place each window on</sys:String>
    <sys:String x:Key="Help_S1_B7">↕ Drag and drop to reorder windows</sys:String>

    <sys:String x:Key="Help_S2_Title">🏰  Main Mode</sys:String>
    <sys:String x:Key="Help_S2_Body">The Leader window takes the dominant area of the screen, other windows fill the remaining space.</sys:String>
    <sys:String x:Key="Help_S2_Size">Size (L / M / S)</sys:String>
    <sys:String x:Key="Help_S2_SizeL">• Large — leader takes 75% of the screen</sys:String>
    <sys:String x:Key="Help_S2_SizeM">• Medium — leader takes 67% of the screen</sys:String>
    <sys:String x:Key="Help_S2_SizeS">• Small — leader takes 50% of the screen</sys:String>
    <sys:String x:Key="Help_S2_Pos">Position (↖ ↗ ↘ ↙)</sys:String>
    <sys:String x:Key="Help_S2_PosBody">Choose which corner of the screen to place the leader. Secondary windows fill the remaining space.</sys:String>
    <sys:String x:Key="Help_S2_Zones">Zones</sys:String>
    <sys:String x:Key="Help_S2_ZoneLat">• Sidebar — secondary windows stack vertically beside the leader</sys:String>
    <sys:String x:Key="Help_S2_ZoneBand">• Banner — secondary windows align horizontally above/below the leader</sys:String>
    <sys:String x:Key="Help_S2_ZoneBoth">• Both — mixed layout: sidebar + banner (advanced grid)</sys:String>

    <sys:String x:Key="Help_S3_Title">⊞  Split Mode</sys:String>
    <sys:String x:Key="Help_S3_Body">All windows share equal size, arranged in a regular grid.</sys:String>
    <sys:String x:Key="Help_S3_Ori">Orientation</sys:String>
    <sys:String x:Key="Help_S3_OriH">• ▥ Side by side (Horizontal) — favors columns</sys:String>
    <sys:String x:Key="Help_S3_OriV">• ▤ Stacked (Vertical) — favors rows</sys:String>

    <sys:String x:Key="Help_S4_Title">⚙  Advanced Mode</sys:String>
    <sys:String x:Key="Help_S4_Body">Advanced mode gives you full control over position and size of each window via an interactive canvas representing your desktop.</sys:String>
    <sys:String x:Key="Help_S4_Canvas">Interactive Canvas</sys:String>
    <sys:String x:Key="Help_S4_C1">• Monitors are displayed with their name above their area</sys:String>
    <sys:String x:Key="Help_S4_C2">• Drag a window to move it (✥ cursor)</sys:String>
    <sys:String x:Key="Help_S4_C3">• Grab corners to resize</sys:String>
    <sys:String x:Key="Help_S4_C4">• Auto-snap to monitor edges and other windows</sys:String>
    <sys:String x:Key="Help_S4_List">Window List</sys:String>
    <sys:String x:Key="Help_S4_L1">• ☑ Check / uncheck to show or hide on canvas</sys:String>
    <sys:String x:Key="Help_S4_L2">• ✏ Click name to rename</sys:String>
    <sys:String x:Key="Help_S4_L3">• 👑 Leader button to set as main window</sys:String>
    <sys:String x:Key="Help_S4_L4">• 🖥 Change assigned monitor via dropdown</sys:String>
    <sys:String x:Key="Help_S4_Fine">Fine-tuning</sys:String>
    <sys:String x:Key="Help_S4_F1">• X, Y, W, H: position and size in pixels</sys:String>
    <sys:String x:Key="Help_S4_Auto">Auto positioning</sys:String>
    <sys:String x:Key="Help_S4_A1">• ▣ Main — classic layout</sys:String>
    <sys:String x:Key="Help_S4_A2">• ▥ Split V — side by side</sys:String>
    <sys:String x:Key="Help_S4_A3">• ▤ Split H — stacked</sys:String>
    <sys:String x:Key="Help_S4_Tools">Tools</sys:String>
    <sys:String x:Key="Help_S4_T1">• ✂ Copy size — memorize size</sys:String>
    <sys:String x:Key="Help_S4_T2">• 🖌 Paste size — apply memorized size</sys:String>
    <sys:String x:Key="Help_S4_T3">• ⇔⇕ Apply to all — apply to all windows</sys:String>
    <sys:String x:Key="Help_S4_T4">• 🔀 Swap — exchange position of two windows</sys:String>
    <sys:String x:Key="Help_S4_Presets">Presets</sys:String>
    <sys:String x:Key="Help_S4_P1">• Save a named layout to restore later</sys:String>
    <sys:String x:Key="Help_S4_P2">• Load or delete existing presets</sys:String>
    <sys:String x:Key="Help_S4_Leader">Auto leader selection</sys:String>
    <sys:String x:Key="Help_S4_LeaderBody">• When entering advanced mode, the largest window is automatically set as leader</sys:String>

    <sys:String x:Key="Help_S5_Title">🖥  Multi-monitor</sys:String>
    <sys:String x:Key="Help_S5_Body">All connected monitors are automatically detected. Each monitor has its own configuration panel.</sys:String>
    <sys:String x:Key="Help_S5_B1">• Independent mode choice per monitor</sys:String>
    <sys:String x:Key="Help_S5_B2">• Separate options for each monitor</sys:String>
    <sys:String x:Key="Help_S5_B3">• Real-time mini preview</sys:String>
    <sys:String x:Key="Help_S5_B4">• Side-by-side panels with scrolling</sys:String>
    <sys:String x:Key="Help_S5_B5">• Assign each window to the desired monitor</sys:String>
    <sys:String x:Key="Help_S5_B6">• Advanced mode: canvas shows all monitor outlines</sys:String>

    <sys:String x:Key="Help_S6_Title">👁  Preview</sys:String>
    <sys:String x:Key="Help_S6_Body">Each monitor panel includes a mini preview showing position and size of each window. The preview updates automatically.</sys:String>

    <sys:String x:Key="Help_S7_Title">⚔  Apply layout</sys:String>
    <sys:String x:Key="Help_S7_Body">Click "⚔ Apply" to move and resize all selected windows according to the defined configuration.</sys:String>

    <sys:String x:Key="Help_Footer">Developed by Cyco — yenemillas@gmail.com</sys:String>

</ResourceDictionary>
