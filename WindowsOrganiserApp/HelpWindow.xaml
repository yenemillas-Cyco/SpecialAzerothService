<Window x:Class="WindowsOrganiserApp.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aide — Special Azeroth Service"
        Height="650" Width="620"
        MinHeight="400" MinWidth="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrightGoldBrush}"/>
            <Setter Property="Margin" Value="0,18,0,6"/>
        </Style>

        <Style x:Key="SubTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource GoldBrush}"/>
            <Setter Property="Margin" Value="8,10,0,4"/>
        </Style>

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="12,2,0,2"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <Style x:Key="Bullet" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="20,1,0,1"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource AccentBorderBrush}"
            Background="{DynamicResource WindowBgBrush}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Padding="16,10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="📖  Guide d'utilisation" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource BrightGoldBrush}" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                            FontSize="14" Foreground="{DynamicResource SubtextBrush}" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="Close_Click" Padding="6,2"/>
                </Grid>
            </Border>

            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="2" Margin="20,0"
                    Background="{DynamicResource GoldSepBrush}"/>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,20,10">
                <StackPanel>

                    <!-- LISTE DES FENÊTRES -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="⚔  Liste des fenêtres"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="L'application détecte automatiquement toutes les fenêtres WoW ouvertes au lancement et après chaque rafraîchissement."/>
                    <TextBlock Style="{StaticResource Bullet}" Text="☑ WoW uniquement : coché par défaut, ne détecte que les fenêtres WoW. Décocher pour organiser toutes les fenêtres Windows"/>

                    <TextBlock Style="{StaticResource Bullet}" Text="☑ Cocher / décocher une fenêtre pour l'inclure dans la disposition"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="✏ Cliquer sur le nom pour le renommer (conservé après rafraîchissement)"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="👑 Leader : désigner la fenêtre principale d'un écran (zone dominante en mode Principal)"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="⛶ Plein écran : bascule en plein écran, un second clic restaure la position"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="🖥 Écran : choisir sur quel moniteur placer chaque fenêtre"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="↕ Glisser-déposer pour réorganiser l'ordre des fenêtres"/>

                    <Border Style="{StaticResource Sep}"/>

                    <!-- MODE PRINCIPAL -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="🏰  Mode Principal"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="La fenêtre Leader occupe la zone dominante de l'écran, les autres fenêtres se répartissent autour."/>

                    <TextBlock Style="{StaticResource SubTitle}" Text="Taille (G / M / P)"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• Grand — le leader occupe 75% de l'écran"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• Moyen — le leader occupe 67% de l'écran"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• Petit — le leader occupe 50% de l'écran"/>

                    <TextBlock Style="{StaticResource SubTitle}" Text="Position (↖ ↗ ↘ ↙)"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="Choisir dans quel coin de l'écran placer le leader. Les secondaires occupent l'espace restant."/>

                    <TextBlock Style="{StaticResource SubTitle}" Text="Zones"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• Latéral — les secondaires s'empilent verticalement à côté du leader"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• Bandeau — les secondaires s'alignent horizontalement sous ou sur le leader"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• Les deux — disposition mixte : latéral + bandeau (grille avancée)"/>

                    <Border Style="{StaticResource Sep}"/>

                    <!-- MODE FRACTIONNÉ -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="⊞  Mode Fractionné"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="Toutes les fenêtres ont la même taille, réparties en grille régulière."/>

                    <TextBlock Style="{StaticResource SubTitle}" Text="Orientation"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• ▥ Côte à côte (Horizontal) — privilégie les colonnes (ex. 6 fenêtres → 3 colonnes × 2 lignes)"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• ▤ Empilé (Vertical) — privilégie les lignes (ex. 6 fenêtres → 2 colonnes × 3 lignes)"/>

                    <Border Style="{StaticResource Sep}"/>

                    <!-- MODE AVANCÉ -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="⚙  Mode Avancé"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="Le mode avancé offre un contrôle total sur la position et la taille de chaque fenêtre via un canvas interactif représentant votre bureau."/>

                    <TextBlock Style="{StaticResource SubTitle}" Text="Canvas interactif"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• Les écrans sont affichés avec leur nom au-dessus de leur zone"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• Glisser une fenêtre pour la déplacer (curseur ✥)"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• Attraper les coins pour redimensionner"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• Aimantation automatique aux bords des écrans et des autres fenêtres"/>

                    <TextBlock Style="{StaticResource SubTitle}" Text="Liste des fenêtres"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• ☑ Cocher / décocher pour afficher ou masquer une fenêtre sur le canvas"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• ✏ Cliquer sur le nom pour renommer"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• 👑 Bouton Leader pour définir la fenêtre principale"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• 🖥 Changer l'écran assigné via le menu déroulant de chaque fenêtre"/>

                    <TextBlock Style="{StaticResource SubTitle}" Text="Réglage fin"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• X, Y, L, H : saisir manuellement la position et la taille en pixels de la fenêtre sélectionnée"/>

                    <TextBlock Style="{StaticResource SubTitle}" Text="Positionnement auto"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• ▣ Principal — applique le layout classique (leader + secondaires)"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• ▥ Fractionné V — fenêtres côte à côte"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• ▤ Fractionné H — fenêtres empilées"/>

                    <TextBlock Style="{StaticResource SubTitle}" Text="Outils"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• ✂ Copier taille — mémorise la taille de la fenêtre sélectionnée"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• 🖌 Coller taille — applique la taille mémorisée à la fenêtre sélectionnée"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• ⇔⇕ Appliquer à toutes — applique la taille de la fenêtre sélectionnée à toutes les autres"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• 🔀 Inverser — échange la position de deux fenêtres (cliquer, puis cliquer la cible)"/>

                    <TextBlock Style="{StaticResource SubTitle}" Text="Configurations (presets)"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• Sauvegarder un agencement nommé pour le restaurer plus tard"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• Charger ou supprimer des presets existants"/>

                    <TextBlock Style="{StaticResource SubTitle}" Text="Auto-sélection du leader"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• À l'entrée en mode avancé, la plus grande fenêtre est automatiquement définie comme leader"/>

                    <Border Style="{StaticResource Sep}"/>

                    <!-- MULTI-ÉCRAN -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="🖥  Multi-écran"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="Tous les moniteurs connectés sont détectés automatiquement. Chaque écran dispose de son propre panneau de configuration :"/>

                    <TextBlock Style="{StaticResource Bullet}" Text="• Choix indépendant du mode (Principal / Fractionné) par écran"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• Options de taille, position et zones propres à chaque écran"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• Aperçu miniature en temps réel par écran"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• Les panneaux s'affichent côte à côte avec défilement horizontal"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• Assigner chaque fenêtre à l'écran souhaité via le menu déroulant dans la liste"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="• En mode avancé : le canvas affiche tous les écrans avec leurs contours, les noms sont au-dessus de chaque zone"/>

                    <Border Style="{StaticResource Sep}"/>

                    <!-- APERÇU -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="👁  Aperçu"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="Chaque panneau d'écran inclut un aperçu miniature montrant le contour de l'écran, la position et la taille de chaque fenêtre assignée, ainsi que son nom. L'aperçu se met à jour automatiquement à chaque changement d'option."/>

                    <Border Style="{StaticResource Sep}"/>

                    <!-- APPLIQUER -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="⚔  Appliquer le layout"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="Cliquer sur « ⚔ Appliquer » pour déplacer et redimensionner toutes les fenêtres sélectionnées selon la configuration définie. Chaque écran applique sa propre disposition indépendamment."/>

                    <TextBlock Style="{StaticResource Body}" Margin="12,16,0,4" Foreground="{DynamicResource SubtextBrush}" FontStyle="Italic"
                               Text="Développé par Cyco — yenemillas@gmail.com"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="16,8">
                <Button Content="Fermer" HorizontalAlignment="Center"
                        Style="{DynamicResource WowButton}"
                        FontSize="13" FontWeight="Bold" Cursor="Hand"
                        Padding="24,8" Click="Close_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
