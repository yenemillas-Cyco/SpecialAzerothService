<Window x:Class="WindowsOrganiserApp.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aide — Special Azeroth Service"
        Height="650" Width="620"
        MinHeight="400" MinWidth="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrightGoldBrush}"/>
            <Setter Property="Margin" Value="0,18,0,6"/>
        </Style>

        <Style x:Key="SubTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource GoldBrush}"/>
            <Setter Property="Margin" Value="8,10,0,4"/>
        </Style>

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="12,2,0,2"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <Style x:Key="Bullet" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="20,1,0,1"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource AccentBorderBrush}"
            Background="{DynamicResource WindowBgBrush}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Padding="16,10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="{DynamicResource Help_Title}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource BrightGoldBrush}" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                            FontSize="14" Foreground="{DynamicResource SubtextBrush}" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="Close_Click" Padding="6,2"/>
                </Grid>
            </Border>

            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="2" Margin="20,0"
                    Background="{DynamicResource GoldSepBrush}"/>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,20,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Help_S1_Title}"/>
                    <TextBlock Style="{StaticResource Body}" Text="{DynamicResource Help_S1_Body}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S1_B1}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S1_B2}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S1_B3}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S1_B4}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S1_B5}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S1_B6}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S1_B7}"/>
                    <Border Style="{StaticResource Sep}"/>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Help_S2_Title}"/>
                    <TextBlock Style="{StaticResource Body}" Text="{DynamicResource Help_S2_Body}"/>
                    <TextBlock Style="{StaticResource SubTitle}" Text="{DynamicResource Help_S2_Size}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S2_SizeL}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S2_SizeM}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S2_SizeS}"/>
                    <TextBlock Style="{StaticResource SubTitle}" Text="{DynamicResource Help_S2_Pos}"/>
                    <TextBlock Style="{StaticResource Body}" Text="{DynamicResource Help_S2_PosBody}"/>
                    <TextBlock Style="{StaticResource SubTitle}" Text="{DynamicResource Help_S2_Zones}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S2_ZoneLat}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S2_ZoneBand}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S2_ZoneBoth}"/>
                    <Border Style="{StaticResource Sep}"/>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Help_S3_Title}"/>
                    <TextBlock Style="{StaticResource Body}" Text="{DynamicResource Help_S3_Body}"/>
                    <TextBlock Style="{StaticResource SubTitle}" Text="{DynamicResource Help_S3_Ori}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S3_OriH}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S3_OriV}"/>
                    <Border Style="{StaticResource Sep}"/>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Help_S4_Title}"/>
                    <TextBlock Style="{StaticResource Body}" Text="{DynamicResource Help_S4_Body}"/>
                    <TextBlock Style="{StaticResource SubTitle}" Text="{DynamicResource Help_S4_Canvas}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S4_C1}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S4_C2}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S4_C3}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S4_C4}"/>
                    <TextBlock Style="{StaticResource SubTitle}" Text="{DynamicResource Help_S4_List}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S4_L1}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S4_L2}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S4_L3}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S4_L4}"/>
                    <TextBlock Style="{StaticResource SubTitle}" Text="{DynamicResource Help_S4_Fine}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S4_F1}"/>
                    <TextBlock Style="{StaticResource SubTitle}" Text="{DynamicResource Help_S4_Auto}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S4_A1}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S4_A2}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S4_A3}"/>
                    <TextBlock Style="{StaticResource SubTitle}" Text="{DynamicResource Help_S4_Tools}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S4_T1}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S4_T2}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S4_T3}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S4_T4}"/>
                    <TextBlock Style="{StaticResource SubTitle}" Text="{DynamicResource Help_S4_Presets}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S4_P1}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S4_P2}"/>
                    <TextBlock Style="{StaticResource SubTitle}" Text="{DynamicResource Help_S4_Leader}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S4_LeaderBody}"/>
                    <Border Style="{StaticResource Sep}"/>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Help_S5_Title}"/>
                    <TextBlock Style="{StaticResource Body}" Text="{DynamicResource Help_S5_Body}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S5_B1}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S5_B2}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S5_B3}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S5_B4}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S5_B5}"/>
                    <TextBlock Style="{StaticResource Bullet}" Text="{DynamicResource Help_S5_B6}"/>
                    <Border Style="{StaticResource Sep}"/>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Help_S6_Title}"/>
                    <TextBlock Style="{StaticResource Body}" Text="{DynamicResource Help_S6_Body}"/>
                    <Border Style="{StaticResource Sep}"/>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Help_S7_Title}"/>
                    <TextBlock Style="{StaticResource Body}" Text="{DynamicResource Help_S7_Body}"/>

                    <TextBlock Style="{StaticResource Body}" Margin="12,16,0,4" Foreground="{DynamicResource SubtextBrush}" FontStyle="Italic"
                               Text="{DynamicResource Help_Footer}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="16,8">
                <Button Content="{DynamicResource Help_Close}" HorizontalAlignment="Center"
                        Style="{DynamicResource WowButton}"
                        FontSize="13" FontWeight="Bold" Cursor="Hand"
                        Padding="24,8" Click="Close_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
