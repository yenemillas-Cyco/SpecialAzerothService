<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="CraftToolbarIconButton" TargetType="Button" BasedOn="{StaticResource StoneButton}">
        <Setter Property="Padding" Value="4"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="Height" Value="28"/>
    </Style>

    <Style x:Key="CraftRecipeAddIconButton" TargetType="Button" BasedOn="{StaticResource CraftToolbarIconButton}">
        <Setter Property="Padding" Value="5"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="Height" Value="34"/>
    </Style>

    <Style x:Key="CraftToolbarImage" TargetType="Image">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

</ResourceDictionary>
