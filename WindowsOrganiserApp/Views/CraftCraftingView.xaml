<UserControl x:Class="WindowsOrganiserApp.Views.CraftCraftingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:WindowsOrganiserApp.Converters"
             xmlns:ctrl="clr-namespace:WindowsOrganiserApp.Controls"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1100"
             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
             FontSize="13">
    <UserControl.Resources>
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVis"/>
        <conv:HexColorToBrushConverter x:Key="HexToBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CraftListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="3" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28D4A017"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#60D4A017"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="#10D4A017"/>
            <Setter Property="BorderBrush" Value="#40806030"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="QtyButton" TargetType="Button" BasedOn="{StaticResource StoneButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Ligne matériau manquant (compacte) -->
        <DataTemplate x:Key="FarmRowCompact">
            <DockPanel Margin="0,0,0,6" MinHeight="28">
                <TextBlock DockPanel.Dock="Right" FontFamily="Georgia" FontSize="12" FontWeight="SemiBold"
                           Foreground="#FF9070" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Run Text="×"/><Run Text="{Binding ToFarm, Mode=OneWay}"/>
                </TextBlock>
                <ctrl:WowItemSlot DockPanel.Dock="Left" DataContext="{Binding WowItem}"
                                  Width="26" Height="26" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding DisplayName}" FontFamily="Georgia" FontSize="12"
                           Foreground="{Binding NameQualityColor, Converter={StaticResource HexToBrush}}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="VendorBillLineTemplate">
            <Grid Margin="0,0,0,5" MinHeight="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ctrl:WowItemSlot Grid.Column="0" DataContext="{Binding WowItem}"
                                  Width="22" Height="22" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontFamily="Georgia" FontSize="12"
                               Foreground="{Binding NameQualityColor, Converter={StaticResource HexToBrush}}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock FontFamily="Georgia" FontSize="10"
                               Foreground="{DynamicResource SubtextBrush}">
                        <Run Text="×"/><Run Text="{Binding ToFarm, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <ctrl:WowCurrencyControl Grid.Column="2" CopperTotal="{Binding VendorUnitPriceCopper}"
                                         IconSize="11" AmountFontSize="10" VerticalAlignment="Center"
                                         HorizontalAlignment="Left" Margin="12,0,10,0"
                                         Visibility="{Binding HasVendorPrice, Converter={StaticResource BoolToVis}}"/>
                <ctrl:WowCurrencyControl Grid.Column="3" CopperTotal="{Binding VendorLineTotalCopper}"
                                         IconSize="12" AmountFontSize="11" VerticalAlignment="Center"
                                         HorizontalAlignment="Right" MinWidth="56"/>
            </Grid>
        </DataTemplate>

        <!-- Ligne objet dans carte perso -->
        <DataTemplate x:Key="PickupChipTemplate">
            <DockPanel Margin="0,0,0,4" MinHeight="26">
                <TextBlock DockPanel.Dock="Right" FontFamily="Georgia" FontSize="11"
                           Foreground="#C0A060" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Run Text="×" Foreground="#FFD700"/><Run Text="{Binding Quantity, Mode=OneWay}"/>
                    <Run Text=" "/><Run Text="{Binding SourceLabel, Mode=OneWay}"/>
                </TextBlock>
                <ctrl:WowItemSlot DockPanel.Dock="Left" DataContext="{Binding WowItem}"
                                  Width="24" Height="24" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding DisplayName}" FontFamily="Georgia" FontSize="11"
                           Foreground="{Binding NameQualityColor, Converter={StaticResource HexToBrush}}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </DataTemplate>

        <!-- Carte perso -->
        <DataTemplate x:Key="CharacterCardTemplate">
            <Border Margin="0,0,0,6" Padding="6,5" CornerRadius="5"
                    Background="#1AD4A017" BorderBrush="#55A08040" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount, StringFormat={}{0} obj.}"
                                   FontFamily="Georgia" FontSize="10"
                                   Foreground="{DynamicResource SubtextBrush}" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="{Binding HeaderText}" FontFamily="Georgia" FontSize="13"
                                       FontWeight="Bold" Foreground="{DynamicResource BrightGoldBrush}"/>
                            <TextBlock Text="{Binding SubheaderText}" FontFamily="Georgia" FontSize="10"
                                       Foreground="{DynamicResource SubtextBrush}"
                                       Visibility="{Binding HasSubheader, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PickupChipTemplate}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Ligne craft -->
        <DataTemplate x:Key="CraftItemRowTemplate">
            <DockPanel Margin="4,2,0,4" MinHeight="32">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="✕" Style="{StaticResource StoneButton}" FontSize="11"
                            Width="26" Height="26" Padding="0" Margin="0,0,4,0"
                            ToolTip="Retirer de la liste"
                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                    <Button Content="−" Style="{StaticResource QtyButton}"
                            Command="{Binding DataContext.DecrementItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                    <Grid Width="36" Height="28" Margin="2,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Quantity}" TextAlignment="Center"
                                   VerticalAlignment="Center" FontFamily="Georgia" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#FFD700" Cursor="Hand"
                                   ToolTip="Cliquer pour saisir la quantité"
                                   PreviewMouseLeftButtonDown="CraftQtyDisplay_PreviewMouseLeftButtonDown">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingQuantity}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Text="{Binding EditQuantityText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="36" Height="26" FontFamily="Georgia" FontSize="14"
                                 FontWeight="SemiBold" Foreground="#FFD700"
                                 Background="#30FFFFFF" BorderBrush="#60D4A017" BorderThickness="1"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 Padding="0" Loaded="CraftQtyTextBox_Loaded"
                                 KeyDown="CraftQtyTextBox_KeyDown" LostFocus="CraftQtyTextBox_LostFocus">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingQuantity}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                    <Button Content="＋" Style="{StaticResource QtyButton}"
                            Command="{Binding DataContext.IncrementItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                </StackPanel>
                <ctrl:WowItemSlot DockPanel.Dock="Left" DataContext="{Binding WowItem}"
                                  Width="32" Height="32" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding DisplayName}" FontFamily="Georgia" FontSize="13"
                           Foreground="{Binding NameQualityColor, Converter={StaticResource HexToBrush}}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" MinWidth="160"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- Listes -->
        <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="＋" Style="{DynamicResource StoneButton}" FontSize="14"
                                Command="{Binding CreateListCommand}" Padding="6,2" MinWidth="30" Height="28"
                                ToolTip="Nouvelle liste" Margin="0,0,4,0"/>
                        <Button Content="✕" Style="{DynamicResource StoneButton}" FontSize="11"
                                Command="{Binding DeleteListCommand}" Padding="6,2" MinWidth="30" Height="28"
                                ToolTip="Supprimer la liste sélectionnée"/>
                    </StackPanel>
                    <TextBlock Text="Listes" Style="{StaticResource SectionTitle}"
                               Foreground="{DynamicResource BrightGoldBrush}" VerticalAlignment="Center"/>
                </DockPanel>
                <Button DockPanel.Dock="Bottom" Content="Importer…" Style="{DynamicResource StoneButton}"
                        FontSize="11" Command="{Binding ImportListCommand}" Padding="6,3" Margin="0,6,0,0"
                        HorizontalAlignment="Stretch" ToolTip="Importer une liste JSON"/>
                <ListBox x:Name="ListsListBox" ItemsSource="{Binding ListSummaries}"
                         SelectedItem="{Binding SelectedList}"
                         ItemContainerStyle="{StaticResource CraftListItem}"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel MinHeight="24">
                                <TextBlock Text="{Binding ItemCount}" DockPanel.Dock="Right" FontSize="10"
                                           Foreground="{DynamicResource SubtextBrush}" Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                                <Grid VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               ToolTip="Cliquer pour renommer"
                                               PreviewMouseLeftButtonDown="ListName_PreviewMouseLeftButtonDown">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Georgia" FontSize="13" Height="24"
                                             VerticalContentAlignment="Center" Padding="2,0"
                                             KeyDown="RenameTextBox_KeyDown"
                                             LostFocus="RenameTextBox_LostFocus"
                                             Loaded="RenameTextBox_Loaded">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Zone principale -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*" MinWidth="160"/>
                </Grid.ColumnDefinitions>

                <!-- Col. 1 — À crafter -->
                <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="＋" Style="{DynamicResource StoneButton}"
                                    FontSize="14" Padding="6,2" MinWidth="32" Height="28" Margin="4,0,0,0"
                                    ToolTip="Catalogue métiers — ajouter une recette"
                                    Command="{Binding OpenProfessionPickerCommand}"/>
                            <Button DockPanel.Dock="Right" Content="📜" Style="{DynamicResource StoneButton}"
                                    FontSize="13" Padding="6,2" MinWidth="32" Height="28" Margin="4,0,0,0"
                                    ToolTip="Quêtes — T3, E'ko Winterspring…"
                                    Command="{Binding OpenQuestPickerCommand}"/>
                            <Button DockPanel.Dock="Right" Content="↑" Style="{DynamicResource StoneButton}"
                                    FontSize="14" Padding="6,2" MinWidth="32" Height="28"
                                    ToolTip="Guide montée 1-300 — charger un métier (WowIsClassic)"
                                    Command="{Binding OpenLevelingPickerCommand}"/>
                            <TextBlock Text="À crafter" Style="{StaticResource SectionTitle}"
                                       Foreground="{DynamicResource BrightGoldBrush}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding ForceCraftOutputs}"
                                      Style="{DynamicResource SelectionCheck}"
                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                      ToolTip="Force la fabrication des objets de sortie (ignore le stock d'objet déjà craft)."/>
                            <Border Width="16" Height="16" Margin="0,0,12,0"
                                    CornerRadius="2" BorderBrush="#50705020" BorderThickness="1">
                                <Image Source="https://wow.zamimg.com/images/wow/icons/small/inv_hammer_09.jpg"
                                       Stretch="UniformToFill"/>
                            </Border>

                            <TextBlock Text="Bank:" FontFamily="Georgia" FontSize="11"
                                       Foreground="{DynamicResource SubtextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Grid Width="220" VerticalAlignment="Center"
                                  ToolTip="Propriétaires des comptes utilisés pour rechercher les composants.">
                                <ToggleButton x:Name="StockAccountsDropDown" ClickMode="Press"
                                              Padding="6,3" HorizontalContentAlignment="Stretch"
                                              Background="{DynamicResource PillBgBrush}"
                                              BorderBrush="{DynamicResource BorderBrush}"
                                              BorderThickness="1" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd" CornerRadius="3"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush"
                                                            Value="{DynamicResource GoldBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush"
                                                            Value="{DynamicResource GoldBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding SelectedStockAccountsText, Mode=OneWay}"
                                                   FontSize="10" Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="▾" FontSize="10"
                                                   Foreground="{DynamicResource GoldBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </ToggleButton>
                                <Popup x:Name="StockAccountsPopup" Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=StockAccountsDropDown}"
                                       IsOpen="{Binding IsChecked, ElementName=StockAccountsDropDown}"
                                       StaysOpen="True" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border MinWidth="{Binding ActualWidth, ElementName=StockAccountsDropDown}"
                                            MaxHeight="200" CornerRadius="3" Margin="0,2,0,0"
                                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                            Background="{DynamicResource ComboDropdownBgBrush}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding StockAccounts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="8,4">
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      Style="{DynamicResource SelectionCheck}"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,8,0" Cursor="Hand"/>
                                                            <TextBlock Text="{Binding OwnerName}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ProfessionGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProfessionLabel, StringFormat={}{0}}"
                                                       FontFamily="Georgia" FontSize="12" FontWeight="Bold"
                                                       Foreground="#C0A060" Margin="0,8,0,2"/>
                                            <ItemsControl ItemsSource="{Binding Items}"
                                                          ItemTemplate="{StaticResource CraftItemRowTemplate}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Col. 2 — Par perso -->
                <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="À prendre — par perso" Style="{StaticResource SectionTitle}"
                                   Foreground="{DynamicResource BrightGoldBrush}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Aucun composant sur tes persos (Carto Moi + WowSync)."
                                           FontFamily="Georgia" FontSize="11"
                                           Foreground="{DynamicResource SubtextBrush}" TextWrapping="Wrap"
                                           Margin="0,0,0,6"
                                           Visibility="{Binding HasNoCharacterPickupGroups, Converter={StaticResource BoolToVis}}"/>
                                <ItemsControl ItemsSource="{Binding CharacterPickupGroups}"
                                              ItemTemplate="{StaticResource CharacterCardTemplate}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Col. 3 — À farmer / Marchand -->
                <Border Grid.Column="4" Style="{StaticResource PanelBorder}"
                        Background="#14FF9070" BorderBrush="#50FF9070">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <TextBlock DockPanel.Dock="Top" Text="À farmer" Style="{StaticResource SectionTitle}"
                                       Foreground="#FF9070"/>
                            <TextBlock DockPanel.Dock="Top" Text="Rien à farmer."
                                       FontFamily="Georgia" FontSize="11"
                                       Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,6"
                                       Visibility="{Binding HasNoToFarmItems, Converter={StaticResource BoolToVis}}"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ToFarmRows}"
                                              ItemTemplate="{StaticResource FarmRowCompact}"/>
                            </ScrollViewer>
                        </DockPanel>
                        <Border Grid.Row="1" Height="1" Margin="0,8" Background="#40C0A060"/>
                        <DockPanel Grid.Row="2" Margin="0,4,0,0">
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"
                                        Visibility="{Binding HasVendorBuyItems, Converter={StaticResource BoolToVis}}">
                                <Border Padding="0,6,0,0" BorderBrush="#50C0A060" BorderThickness="0,1,0,0">
                                    <DockPanel>
                                        <ctrl:WowCurrencyControl DockPanel.Dock="Right"
                                                                  CopperTotal="{Binding VendorBuyTotalCopper}"
                                                                  IconSize="14" AmountFontSize="12"
                                                                  VerticalAlignment="Center"/>
                                        <TextBlock Text="Total" FontFamily="Georgia" FontSize="13"
                                                   FontWeight="Bold" Foreground="#FFD700"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Marchand" Style="{StaticResource SectionTitle}"
                                       Foreground="#C0A060"/>
                            <TextBlock DockPanel.Dock="Top" Text="Rien chez les marchands."
                                       FontFamily="Georgia" FontSize="11"
                                       Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,6"
                                       Visibility="{Binding HasNoVendorBuyItems, Converter={StaticResource BoolToVis}}"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding VendorBuyRows}"
                                              ItemTemplate="{StaticResource VendorBillLineTemplate}"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1" Margin="0,4,0,0" Padding="8,6" CornerRadius="4"
                    Background="#18D4A017" BorderBrush="#40806030" BorderThickness="1"
                    Visibility="{Binding IsComputing, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" FontFamily="Georgia" FontSize="11"
                                   Foreground="#C0A060" VerticalAlignment="Center"
                                   Text="{Binding ComputeProgress, StringFormat={}{0:0}%}"/>
                        <TextBlock Text="{Binding ComputeStatus}" FontFamily="Georgia" FontSize="11"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <ProgressBar Height="8" Minimum="0" Maximum="100"
                                 Value="{Binding ComputeProgress}"
                                 Foreground="#C0A060" Background="#30FFFFFF"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2" Margin="0,4,0,0" FontSize="11"
                       Foreground="{DynamicResource SubtextBrush}" Text="{Binding StatusText}"
                       TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</UserControl>
