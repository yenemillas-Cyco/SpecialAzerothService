<Window x:Class="WindowsOrganiserApp.Views.CraftLevelingPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:WindowsOrganiserApp.Controls"
        xmlns:conv="clr-namespace:WindowsOrganiserApp.Converters"
        Title="Guide montée 1-300"
        Height="680" Width="900"
        MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <conv:HexColorToBrushConverter x:Key="HexToBrush"/>
        <Style x:Key="GuideListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28D4A017"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#60D4A017"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StepRowBorder" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderBrush" Value="#30A08050"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8" Padding="2"
            Background="{DynamicResource SelectionBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource PanelBg2}" CornerRadius="6,6,0,0" Padding="12,10"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource StoneButton}"
                            Padding="10,4" FontSize="12" Click="Close_Click" ToolTip="Fermer"/>
                    <TextBlock Text="Montée 1-300 — charger un métier"
                               FontFamily="Georgia" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrightGoldBrush}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <TextBlock Grid.Row="1" Margin="14,8,14,4" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource SubtextBrush}"
                       Text="Guides WowIsClassic : choisissez un métier à gauche, prévisualisez les recettes, puis chargez la liste complète dans votre liste active."/>

            <Grid Grid.Row="2" Margin="10,4,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" MinWidth="200"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="4" Padding="8"
                        Background="#18D4A017" BorderBrush="#40806030" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Métier" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,6"/>
                        <ListBox ItemsSource="{Binding Guides}"
                                 SelectedItem="{Binding SelectedGuide}"
                                 ItemContainerStyle="{StaticResource GuideListItem}"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <ctrl:WowItemSlot DockPanel.Dock="Left"
                                                          DataContext="{Binding IconItem}"
                                                          Width="28" Height="28" Margin="0,0,10,0"
                                                          VerticalAlignment="Top"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrightGoldBrush}"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                       Foreground="{DynamicResource SubtextBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="4" Padding="8"
                        Background="#10D4A017" BorderBrush="#40806030" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding PreviewTitle}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,6"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False">
                            <ItemsControl ItemsSource="{Binding StepRows}" IsTabStop="False" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StepRowBorder}">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding QuantityLabel}"
                                                           MinWidth="36" TextAlignment="Right"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#C0A060"
                                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                <ctrl:WowItemSlot DockPanel.Dock="Left"
                                                                  DataContext="{Binding IconItem}"
                                                                  Width="32" Height="32" Margin="0,0,10,0"
                                                                  VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontFamily="Georgia" FontSize="13"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{Binding NameQualityColor, Converter={StaticResource HexToBrush}}"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" Padding="12,8" Background="{DynamicResource PanelBg2}" CornerRadius="0,0,6,6">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Charger le guide" MinWidth="120" Height="32"
                            Style="{DynamicResource StoneButton}" Margin="12,0,0,0"
                            Command="{Binding LoadGuideCommand}"
                            ToolTip="Ajouter toutes les recettes du métier sélectionné à la liste active"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                               Foreground="{DynamicResource SubtextBrush}" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
