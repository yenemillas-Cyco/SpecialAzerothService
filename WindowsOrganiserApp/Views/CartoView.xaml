<UserControl x:Class="WindowsOrganiserApp.Views.CartoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WindowsOrganiserApp.Converters"
             xmlns:carto="clr-namespace:WindowsOrganiserApp.Models.Carto">

    <UserControl.Resources>
        <conv:WowClassColorConverter x:Key="ClassColorConv"/>
        <conv:CooldownRemainingConverter x:Key="CdConv"/>
        <conv:ListSummaryConverter x:Key="ListSummaryConv"/>
        <conv:AccountIdToNameConverter x:Key="AccountConv"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Map area -->
        <DockPanel Grid.Column="0">
            <!-- Toolbar: zoom + overlay toggles -->
            <WrapPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,0,0,4"
                       Background="{DynamicResource PanelBg}">
                    <Button Content="➕" Style="{DynamicResource StoneButton}" FontSize="12" Padding="8,4"
                            Command="{Binding ZoomInCommand}"/>
                    <Button Content="➖" Style="{DynamicResource StoneButton}" FontSize="12" Padding="8,4" Margin="4,0"
                            Command="{Binding ZoomOutCommand}"/>
                    <Button Content="↺" Style="{DynamicResource StoneButton}" FontSize="12" Padding="8,4"
                            Command="{Binding ResetZoomCommand}"/>
                    <TextBlock Text="{Binding MapZoom, StringFormat='x{0:F1}'}" FontSize="11"
                               Foreground="{DynamicResource SubtextBrush}" VerticalAlignment="Center" Margin="8,0,8,0"/>

                    <Border Background="{DynamicResource PanelBg2}" CornerRadius="3" Padding="4,2" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Noms" IsChecked="{Binding ShowZoneNames}" FontSize="10"
                                      Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <CheckBox Content="FR" IsChecked="{Binding UseFrencNames}" FontSize="10"
                                      Foreground="{DynamicResource SubtextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <CheckBox Content="Levels" IsChecked="{Binding ShowZoneLevels}" FontSize="10"
                                      Foreground="{DynamicResource SubtextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBg2}" CornerRadius="3" Padding="4,2" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="FP Alliance" IsChecked="{Binding ShowAllianceFlightPaths}" FontSize="10"
                                      Foreground="#4488FF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <CheckBox Content="FP Horde" IsChecked="{Binding ShowHordeFlightPaths}" FontSize="10"
                                      Foreground="#FF4444" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBg2}" CornerRadius="3" Padding="4,2" Margin="2,0">
                        <CheckBox Content="📋 Tableau" IsChecked="{Binding ShowTableView}" FontSize="10"
                                  Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center"/>
                    </Border>

                    <Border Background="#44FF0000" CornerRadius="3" Padding="6,2" Margin="8,0,0,0"
                            Visibility="{Binding IsPlacingCharacter, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="🎯 Cliquez sur la carte pour placer" FontSize="10"
                                   Foreground="#FFFF6666"/>
                    </Border>
                </WrapPanel>

            <!-- Content: map or table -->
            <Grid>
                <!-- Map canvas -->
                <Border x:Name="MapBorder" Background="Black" ClipToBounds="True"
                        MouseLeftButtonDown="MapCanvas_MouseDown"
                        MouseRightButtonDown="MapCanvas_RightMouseDown"
                        MouseMove="MapCanvas_MouseMove"
                        MouseLeftButtonUp="MapCanvas_MouseUp"
                        MouseWheel="MapCanvas_MouseWheel">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowTableView}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid x:Name="MapContainer" Background="Transparent">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="MapScale"
                                                ScaleX="{Binding MapZoom}"
                                                ScaleY="{Binding MapZoom}"
                                                CenterX="0" CenterY="0"/>
                                <TranslateTransform x:Name="MapTranslate"
                                                    X="{Binding MapOffsetX}"
                                                    Y="{Binding MapOffsetY}"/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Image x:Name="MapImage" Source="/Assets/wow_map_vanilla.png"
                               Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Canvas x:Name="MapCanvas" IsHitTestVisible="True"
                                Width="{Binding ActualWidth, ElementName=MapImage}"
                                Height="{Binding ActualHeight, ElementName=MapImage}"
                                HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <!-- Character tooltip popup -->
                <Popup x:Name="CharPopup" Placement="Mouse" StaysOpen="True" AllowsTransparency="True">
                    <Border Background="#F0181310" BorderBrush="#DD996600" BorderThickness="1.5"
                            CornerRadius="6" Padding="10" MaxWidth="360" MaxHeight="500">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="CharPopupContent"/>
                        </ScrollViewer>
                    </Border>
                </Popup>

                <!-- Table view -->
                <DataGrid x:Name="SummaryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          ItemsSource="{Binding FilteredCharacters}"
                          Background="{DynamicResource PanelBg2}" Foreground="{DynamicResource TextBrush}"
                          BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                          RowBackground="{DynamicResource PanelBg}" AlternatingRowBackground="{DynamicResource PanelBg2}"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource InnerBorderBrush}"
                          HeadersVisibility="Column" CanUserSortColumns="True"
                          FontSize="11" RowHeight="26" ColumnHeaderHeight="28"
                          SelectionMode="Single" MouseDoubleClick="SummaryGrid_DoubleClick">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowTableView}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#FF2A2520"/>
                            <Setter Property="Foreground" Value="#FFE0D8C8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="BorderBrush" Value="#FF444038"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="110"/>
                        <DataGridTextColumn Header="Classe" Binding="{Binding Class}" Width="80"/>
                        <DataGridTextColumn Header="Lv" Binding="{Binding Level}" Width="35"/>
                        <DataGridTextColumn Header="Compte" Binding="{Binding AccountId, Converter={StaticResource AccountConv}}" Width="80"/>
                        <DataGridTextColumn Header="💎" Binding="{Binding ShardCount}" Width="35"/>
                        <DataGridTextColumn Header="Métiers" Width="130"
                                            Binding="{Binding Professions, Converter={StaticResource ListSummaryConv}, ConverterParameter=prof}"/>
                        <DataGridTextColumn Header="CDs" Width="110"
                                            Binding="{Binding Cooldowns, Converter={StaticResource ListSummaryConv}, ConverterParameter=cd}"/>
                        <DataGridTextColumn Header="Quêtes" Width="90"
                                            Binding="{Binding QuestItems, Converter={StaticResource ListSummaryConv}, ConverterParameter=qi}"/>
                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DockPanel>

        <!-- Right panel -->
        <Border Grid.Column="2" Background="{DynamicResource PanelBg}" CornerRadius="6"
                Padding="10" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Filters -->
                    <TextBlock Text="⚔ Filtres" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrightGoldBrush}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource PanelBg2}" CornerRadius="4" Padding="8,6" Margin="0,0,0,8"
                            BorderThickness="1" BorderBrush="{DynamicResource InnerBorderBrush}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nom" FontSize="10"
                                           Foreground="{DynamicResource SubtextBrush}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                <TextBox Grid.Row="0" Grid.Column="1" FontSize="11" Padding="4,2" Margin="0,0,0,4"
                                         Text="{Binding FilterName, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Classe" FontSize="10"
                                           Foreground="{DynamicResource SubtextBrush}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" FontSize="11" Height="26" Margin="0,0,0,4"
                                          ItemsSource="{Binding WowClasses}"
                                          SelectedItem="{Binding FilterClass}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Level" FontSize="10"
                                           Foreground="{DynamicResource SubtextBrush}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBox Width="40" FontSize="11" Padding="2" Text="{Binding FilterLevelMin, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                    <TextBlock Text=" — " FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SubtextBrush}"/>
                                    <TextBox Width="40" FontSize="11" Padding="2" Text="{Binding FilterLevelMax, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Compte" FontSize="10"
                                           Foreground="{DynamicResource SubtextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" FontSize="11" Height="26"
                                          ItemsSource="{Binding Accounts}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding FilterAccountId}"/>
                            </Grid>
                            <Button Content="✕ Effacer filtres" Style="{DynamicResource StoneButton}" FontSize="10"
                                    Padding="6,3" Margin="0,6,0,0" HorizontalAlignment="Left"
                                    Command="{Binding ClearFiltersCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Accounts -->
                    <TextBlock Text="👤 Comptes" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrightGoldBrush}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource PanelBg2}" CornerRadius="4" Padding="8,6" Margin="0,0,0,8"
                            BorderThickness="1" BorderBrush="{DynamicResource InnerBorderBrush}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Accounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,3">
                                            <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource StoneButton}"
                                                    FontSize="9" Padding="4,1" Click="RemoveAccount_Click"/>
                                            <TextBlock Text="{Binding Name}" FontSize="11"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,4,0,0">
                                <Button DockPanel.Dock="Right" Content="+" Style="{DynamicResource StoneButton}"
                                        FontSize="10" Padding="6,2" Margin="4,0,0,0" Click="AddAccount_Click"/>
                                <TextBox x:Name="NewAccountBox" FontSize="11" Padding="4,2"
                                         KeyDown="NewAccountBox_KeyDown"
                                         Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Add character -->
                    <TextBlock Text="➕ Nouveau personnage" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrightGoldBrush}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource PanelBg2}" CornerRadius="4" Padding="8,6" Margin="0,0,0,8"
                            BorderThickness="1" BorderBrush="{DynamicResource InnerBorderBrush}">
                        <StackPanel>
                            <TextBox FontSize="11" Padding="4,3" Margin="0,0,0,4"
                                     Text="{Binding NewCharName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Tag" Value="Nom du personnage..."/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" FontSize="11" Height="26"
                                          ItemsSource="{Binding WowClasses}"
                                          SelectedItem="{Binding NewCharClass}"/>
                                <TextBox Grid.Column="1" FontSize="11" Padding="4,3" Margin="4,0,0,0"
                                         Text="{Binding NewCharLevel, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            </Grid>
                            <ComboBox FontSize="11" Height="26" Margin="0,0,0,4"
                                      ItemsSource="{Binding Accounts}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding NewCharAccountId}"/>
                            <Button Content="📍 Placer sur la carte" Style="{DynamicResource StoneButton}" FontSize="11"
                                    Padding="8,4" HorizontalAlignment="Stretch"
                                    Command="{Binding StartPlaceCharacterCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Selected character detail -->
                    <TextBlock Text="📋 Détails du personnage" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrightGoldBrush}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource PanelBg2}" CornerRadius="4" Padding="8,6" Margin="0,0,0,8"
                            BorderThickness="1" BorderBrush="{DynamicResource InnerBorderBrush}">
                        <StackPanel>
                            <TextBlock FontSize="12" FontWeight="Bold" Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource BrightGoldBrush}"/>
                                        <Setter Property="Text" Value="Aucune sélection"/>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock x:Name="SelectedCharInfo" FontSize="11"
                                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>

                            <!-- Notes -->
                            <TextBlock Text="Notes:" FontSize="10" Foreground="{DynamicResource SubtextBrush}" Margin="0,6,0,2"/>
                            <TextBox FontSize="11" Padding="4,3" MinHeight="40" AcceptsReturn="True" TextWrapping="Wrap"
                                     Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            <Button Content="💾 Sauver note" Style="{DynamicResource StoneButton}" FontSize="10"
                                    Padding="6,3" Margin="0,4,0,0" HorizontalAlignment="Left"
                                    Command="{Binding SaveNoteCommand}"/>

                            <!-- Cooldowns -->
                            <TextBlock Text="⏱ Cooldowns" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource GoldBrush}" Margin="0,8,0,2"/>
                            <ItemsControl x:Name="CooldownsList"/>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <ComboBox x:Name="CdTypeCombo" FontSize="10" Height="24" Width="120"
                                          ItemsSource="{Binding CooldownTypes}"/>
                                <Button Content="+" Style="{DynamicResource StoneButton}" FontSize="10" Padding="6,2" Margin="4,0,0,0"
                                        Click="AddCooldown_Click"/>
                            </StackPanel>

                            <!-- Quest Items -->
                            <TextBlock Text="🏆 Items de quête" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource GoldBrush}" Margin="0,8,0,2"/>
                            <ItemsControl x:Name="QuestItemsList"/>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <ComboBox x:Name="QiTypeCombo" FontSize="10" Height="24" Width="140"
                                          ItemsSource="{Binding QuestItemTypes}"/>
                                <Button Content="+" Style="{DynamicResource StoneButton}" FontSize="10" Padding="6,2" Margin="4,0,0,0"
                                        Click="AddQuestItem_Click"/>
                            </StackPanel>

                            <!-- Professions -->
                            <TextBlock Text="🔨 Métiers" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource GoldBrush}" Margin="0,8,0,2"/>
                            <ItemsControl x:Name="ProfessionsList"/>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <ComboBox x:Name="ProfTypeCombo" FontSize="10" Height="24" Width="140"
                                          ItemsSource="{Binding ProfessionTypes}"/>
                                <Button Content="+" Style="{DynamicResource StoneButton}" FontSize="10" Padding="6,2" Margin="4,0,0,0"
                                        Click="AddProfession_Click"/>
                            </StackPanel>

                            <!-- Actions -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="🗑 Supprimer" Style="{DynamicResource StoneButton}" FontSize="10" Padding="6,3"
                                        Click="RemoveCharacter_Click"/>
                                <Button Content="↕ Déplacer" Style="{DynamicResource StoneButton}" FontSize="10" Padding="6,3" Margin="4,0,0,0"
                                        Click="MoveCharacter_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
