<UserControl x:Class="WindowsOrganiserApp.Views.CartoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WindowsOrganiserApp.Converters"
             xmlns:carto="clr-namespace:WindowsOrganiserApp.Models.Carto"
             xmlns:cartoUi="clr-namespace:WindowsOrganiserApp.Controls"
             Focusable="True">

    <UserControl.Resources>
        <conv:WowClassColorConverter x:Key="ClassColorConv"/>
        <conv:CooldownRemainingConverter x:Key="CdConv"/>
        <conv:ListSummaryConverter x:Key="ListSummaryConv"/>
        <conv:AccountIdToNameConverter x:Key="AccountConv"/>
        <conv:CharacterSyncGoldConverter x:Key="GoldConv"/>
        <conv:CharacterStatusConverter x:Key="StatusConv"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToOnlineBrushConverter x:Key="BoolToOnlineBrush"/>
        <conv:BoolToOnlineTooltipConverter x:Key="BoolToOnlineTooltip"/>

        <Style x:Key="CartoSideHeaderBorder" TargetType="Border">
            <Setter Property="Background" Value="#30181008"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#55AA8833"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="CartoSideTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrightGoldBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CartoZoneListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="5" Padding="8,6" Background="#1A221810"
                                BorderBrush="#3344AA66" BorderThickness="1" Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#282A3018"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#55AADD99"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38382010"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CCFFD766"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CartoDungeonListItem" TargetType="ListBoxItem" BasedOn="{StaticResource CartoZoneListItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="5" Padding="8,6" Background="#1A181028"
                                BorderBrush="#335544AA" BorderThickness="1" Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28182838"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8899BBEE"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30202848"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CCBB99FF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CartoThinClose" TargetType="Button">
            <Setter Property="Content" Value="×"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="Fermer"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BrightGoldBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="RootColGap" Width="0"/>
            <ColumnDefinition x:Name="RootColDock" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- Barre d'outils pleine largeur (au-dessus carte + volets) -->
        <Border x:Name="CartoToolbarHost" Grid.Row="0" Grid.ColumnSpan="3"
                Background="{DynamicResource PanelBg}" Padding="6,4" Margin="0,0,0,2">
                <DockPanel LastChildFill="True">
                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ToggleButton x:Name="BtnPanelRoster" Content="Personnages" Style="{DynamicResource StoneToggle}"
                                      FontSize="10" Padding="10,4" Margin="4,0,0,0"
                                      Checked="PanelRoster_Checked" Unchecked="PanelRoster_Unchecked"
                                      ToolTip="Liste des personnages à droite"/>
                        <ToggleButton x:Name="BtnPanelSearch" Content="Objets" Style="{DynamicResource StoneToggle}"
                                      FontSize="10" Padding="10,4" Margin="4,0,0,0"
                                      Checked="PanelSearch_Checked" Unchecked="PanelSearch_Unchecked"
                                      ToolTip="Recherche d'objets"/>
                        <ToggleButton x:Name="BtnPanelTimers" Content="Timers" Style="{DynamicResource StoneToggle}"
                                      FontSize="10" Padding="10,4" Margin="4,0,0,0"
                                      Checked="PanelTimers_Checked" Unchecked="PanelTimers_Unchecked"
                                      ToolTip="Timers sur la carte"/>
                        <ToggleButton x:Name="BtnPanelZones" Content="Zones" Style="{DynamicResource StoneToggle}"
                                      FontSize="10" Padding="10,4" Margin="4,0,0,0"
                                      Checked="PanelZones_Checked" Unchecked="PanelZones_Unchecked"
                                      ToolTip="Calibrer les zones et repères donjons"/>
                        <ToggleButton x:Name="BtnPanelSettings" Content="Paramètres" Style="{DynamicResource StoneToggle}"
                                      FontSize="10" Padding="10,4" Margin="4,0,0,0"
                                      Checked="PanelSettings_Checked" Unchecked="PanelSettings_Unchecked"
                                      ToolTip="Comptes WTF, utilisateurs et amis"/>
                    </WrapPanel>

                    <WrapPanel VerticalAlignment="Center">
                    <Button Content="＋" Style="{DynamicResource StoneButton}" FontSize="12" Padding="8,4" Margin="0,0,2,0"
                            Click="MapZoomIn_Click" ToolTip="Zoom avant"/>
                    <Button Content="－" Style="{DynamicResource StoneButton}" FontSize="12" Padding="8,4" Margin="0,0,2,0"
                            Click="MapZoomOut_Click" ToolTip="Zoom arrière"/>
                    <Button Content="Centrer" Style="{DynamicResource StoneButton}" FontSize="10" Padding="8,4" Margin="0,0,6,0"
                            Click="MapResetView_Click" ToolTip="Réinitialiser la vue"/>
                    <TextBlock Text="{Binding MapZoom, StringFormat='×{0:F1}'}" FontSize="10"
                               Foreground="{DynamicResource SubtextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="0,0,8,0"/>

                    <Button Content="Actualiser" Style="{DynamicResource StoneButton}" FontSize="10" Padding="10,4" Margin="0,0,6,0"
                            Command="{Binding RefreshWowSyncCommand}"
                            ToolTip="Relire les personnages (WowSync / WTF)"/>
                    <CheckBox Content="Liste" IsChecked="{Binding ShowTableView}" FontSize="10" Margin="0,0,8,0"
                              Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center"
                              ToolTip="Vue liste à la place de la carte"/>

                    <Border Background="#44FF0000" CornerRadius="3" Padding="8,3" Margin="6,0,0,0"
                            Visibility="{Binding IsPlacingCharacter, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Clic carte = placer le perso" FontSize="10" Foreground="#FFFF8888"/>
                    </Border>
                    <Border Background="#4400AAFF" CornerRadius="3" Padding="8,3" Margin="6,0,0,0"
                            Visibility="{Binding IsPlacingTimer, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Clic carte = placer le timer" FontSize="10" Foreground="#FF88CCFF"/>
                    </Border>
                    <Border Background="#44AA44FF" CornerRadius="3" Padding="8,3" Margin="6,0,0,0"
                            Visibility="{Binding IsPlacingDungeonMarker, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Clic carte = repère donjon" FontSize="10" Foreground="#FFCCAAFF"/>
                    </Border>
                    <Border Background="#3322AA44" CornerRadius="3" Padding="8,3" Margin="6,0,0,0"
                            Visibility="{Binding IsZonesPanelOpen, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ZonePanelStatusMessage}" FontSize="10" Foreground="#FFAAEE88"
                                   MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </WrapPanel>
                </DockPanel>
        </Border>

        <!-- Carte (priorité) ou liste -->
        <Grid Grid.Row="1" Grid.Column="0" MinHeight="120">
                <Border x:Name="MapBorder" Background="#FF0A0A0A" ClipToBounds="True"
                        VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                        AllowDrop="True"
                        MouseRightButtonDown="MapCanvas_RightMouseDown"
                        PreviewMouseMove="MapCanvas_MouseMove"
                        PreviewMouseLeftButtonUp="MapCanvas_MouseUp"
                        PreviewMouseRightButtonDown="MapBorder_PreviewMouseRightButtonDown"
                        MouseLeave="MapBorder_MouseLeave"
                        DragOver="MapBorder_DragOver"
                        Drop="MapBorder_Drop">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowTableView}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid x:Name="MapHostGrid">
                    <ScrollViewer x:Name="MapScroll"
                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Focusable="False"
                                  PanningMode="None"
                                  PreviewMouseWheel="MapCanvas_MouseWheel">
                        <Border x:Name="MapContentFrame" Padding="20,0,20,0"
                                Background="Transparent"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid x:Name="MapContainer" Background="Transparent"
                              HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="MapScale"
                                                    ScaleX="{Binding MapZoom}"
                                                    ScaleY="{Binding MapZoom}"
                                                    CenterX="0" CenterY="0"/>
                                    <TranslateTransform x:Name="MapTranslate"
                                                        X="{Binding MapOffsetX}"
                                                        Y="{Binding MapOffsetY}"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Top">
                                <Image x:Name="MapImage"
                                       Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Canvas x:Name="MapCanvas" IsHitTestVisible="True"
                                        Width="{Binding ActualWidth, ElementName=MapImage}"
                                        Height="{Binding ActualHeight, ElementName=MapImage}"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            </Grid>
                            <!-- Capitales 3×2 -->
                            <Grid x:Name="CapitalsDock" Grid.Column="1" Visibility="Collapsed"
                                  VerticalAlignment="Top" HorizontalAlignment="Left">
                                <UniformGrid x:Name="CapitalsGrid" Rows="2" Columns="3"
                                             HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Border x:Name="CapitalHost_1454" Tag="1454" Margin="0" Padding="0"
                                            Background="Transparent" BorderThickness="0">
                                        <Grid x:Name="CapitalMapHost_1454">
                                            <Image x:Name="CapitalImage_1454" Stretch="Uniform"/>
                                            <Canvas x:Name="CapitalCanvas_1454" Background="Transparent"
                                                    IsHitTestVisible="True"/>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="CapitalHost_1456" Tag="1456" Margin="0" Padding="0"
                                            Background="Transparent" BorderThickness="0">
                                        <Grid x:Name="CapitalMapHost_1456">
                                            <Image x:Name="CapitalImage_1456" Stretch="Uniform"/>
                                            <Canvas x:Name="CapitalCanvas_1456" Background="Transparent"
                                                    IsHitTestVisible="True"/>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="CapitalHost_1458" Tag="1458" Margin="0" Padding="0"
                                            Background="Transparent" BorderThickness="0">
                                        <Grid x:Name="CapitalMapHost_1458">
                                            <Image x:Name="CapitalImage_1458" Stretch="Uniform"/>
                                            <Canvas x:Name="CapitalCanvas_1458" Background="Transparent"
                                                    IsHitTestVisible="True"/>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="CapitalHost_1453" Tag="1453" Margin="0" Padding="0"
                                            Background="Transparent" BorderThickness="0">
                                        <Grid x:Name="CapitalMapHost_1453">
                                            <Image x:Name="CapitalImage_1453" Stretch="Uniform"/>
                                            <Canvas x:Name="CapitalCanvas_1453" Background="Transparent"
                                                    IsHitTestVisible="True"/>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="CapitalHost_1455" Tag="1455" Margin="0" Padding="0"
                                            Background="Transparent" BorderThickness="0">
                                        <Grid x:Name="CapitalMapHost_1455">
                                            <Image x:Name="CapitalImage_1455" Stretch="Uniform"/>
                                            <Canvas x:Name="CapitalCanvas_1455" Background="Transparent"
                                                    IsHitTestVisible="True"/>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="CapitalHost_1457" Tag="1457" Margin="0" Padding="0"
                                            Background="Transparent" BorderThickness="0">
                                        <Grid x:Name="CapitalMapHost_1457">
                                            <Image x:Name="CapitalImage_1457" Stretch="Uniform"/>
                                            <Canvas x:Name="CapitalCanvas_1457" Background="Transparent"
                                                    IsHitTestVisible="True"/>
                                        </Grid>
                                    </Border>
                                </UniformGrid>
                            </Grid>
                        </Grid>
                        </Border>
                    </ScrollViewer>
                    <Border x:Name="MapLoadingOverlay" Background="#99000000"
                            Visibility="Collapsed" IsHitTestVisible="False"
                            VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <TextBlock Text="Chargement…" FontSize="13"
                                   Foreground="{DynamicResource BrightGoldBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    </Grid>
                </Border>


                <!-- Character tooltip popup (déplaçable via la barre du haut) -->
                <Popup x:Name="CharPopup" Placement="Absolute"
                       PlacementTarget="{Binding ElementName=RootGrid}"
                       StaysOpen="False" AllowsTransparency="True"
                       Closed="CharPopup_Closed">
                    <Border x:Name="CharPopupBorder" Background="#F5141008" CornerRadius="10"
                            MinWidth="420" Width="500" MaxHeight="680"
                            BorderThickness="1.5">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#CC996600" Offset="0"/>
                                <GradientStop Color="#88664400" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6" Color="Black"/>
                        </Border.Effect>
                        <DockPanel>
                            <Border x:Name="CharPopupDragBar" DockPanel.Dock="Top"
                                    Background="#22181008" CornerRadius="8,8,0,0"
                                    Padding="10,8" Cursor="SizeAll"
                                    BorderBrush="#44AA8833" BorderThickness="0,0,0,1"
                                    MouseLeftButtonDown="CharPopupDragBar_MouseLeftButtonDown"
                                    MouseMove="CharPopupDragBar_MouseMove"
                                    MouseLeftButtonUp="CharPopupDragBar_MouseLeftButtonUp">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource CartoThinClose}"
                                            Click="CharPopupClose_Click"
                                            ToolTip="Fermer (Échap ou clic sur la carte)"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock x:Name="CharPopupTitle" FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource BrightGoldBrush}"/>
                                        <TextBlock Text="Échap ou clic sur la carte pour fermer"
                                                   FontSize="9" Foreground="{DynamicResource SubtextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border x:Name="CharPopupHeroHost" DockPanel.Dock="Top"
                                    Background="#2A2218" BorderBrush="#55AA8833"
                                    BorderThickness="0,0,0,1"/>
                            <StackPanel x:Name="CharPopupActionsHost" DockPanel.Dock="Top"
                                        Margin="12,8,12,0" Orientation="Horizontal"/>
                            <Border DockPanel.Dock="Top" Margin="12,6,12,0"
                                    Background="#221A1008" CornerRadius="4" Padding="8,6"
                                    BorderBrush="#44332218" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Note" FontSize="9" Foreground="{DynamicResource SubtextBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBox x:Name="CharPopupNoteBox" FontSize="10" MinHeight="36" MaxHeight="80"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             Background="{DynamicResource SelectionBgBrush}"
                                             Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                             Padding="6,4" CaretBrush="White"/>
                                </StackPanel>
                            </Border>
                            <ScrollViewer DockPanel.Dock="Top" Margin="12,8,12,12"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="CharPopupContent"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Popup>

                <!-- Table view -->
                <DataGrid x:Name="SummaryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding FilteredCharacters}"
                          Background="{DynamicResource PanelBg2}" Foreground="{DynamicResource TextBrush}"
                          BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                          RowBackground="{DynamicResource PanelBg}" AlternatingRowBackground="{DynamicResource PanelBg2}"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource InnerBorderBrush}"
                          HeadersVisibility="Column" CanUserSortColumns="True"
                          FontSize="11" RowHeight="26" ColumnHeaderHeight="28"
                          SelectionMode="Single" MouseDoubleClick="SummaryGrid_DoubleClick">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowTableView}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground"
                                    Value="{Binding Class, Converter={StaticResource ClassColorConv}}"/>
                            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FF3A3520"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#FF2A2520"/>
                            <Setter Property="Foreground" Value="#FFE0D8C8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="BorderBrush" Value="#FF444038"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="100"/>
                        <DataGridTextColumn Header="Classe" Binding="{Binding Class}" Width="75"/>
                        <DataGridTextColumn Header="Lv" Binding="{Binding Level}" Width="30"/>
                        <DataGridTextColumn Header="Or" Binding="{Binding ., Converter={StaticResource GoldConv}}" Width="95"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource StatusConv}}" Width="60"/>
                        <DataGridTextColumn Header="Compte" Binding="{Binding AccountId, Converter={StaticResource AccountConv}}" Width="75"/>
                        <DataGridTextColumn Header="💎" Binding="{Binding ShardCount}" Width="30"/>
                        <DataGridTextColumn Header="Métiers" Width="130"
                                            Binding="{Binding Professions, Converter={StaticResource ListSummaryConv}, ConverterParameter=prof}"/>
                        <DataGridTextColumn Header="CDs" Width="110"
                                            Binding="{Binding Cooldowns, Converter={StaticResource ListSummaryConv}, ConverterParameter=cd}"/>
                        <DataGridTextColumn Header="Quêtes" Width="90"
                                            Binding="{Binding QuestItems, Converter={StaticResource ListSummaryConv}, ConverterParameter=qi}"/>
                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
        </Grid>

        <!-- Volets droite : pas de cadre global, un cadre par volet seulement -->
        <Grid x:Name="RightDockHost" Grid.Row="1" Grid.Column="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

                <!-- Volet personnages -->
                <Border x:Name="CharacterRosterHost" Grid.Column="0"
                        Width="{x:Static cartoUi:CartoRosterPanelUi.PanelWidth}"
                        Margin="0,0,4,0"
                        Background="#14100806" BorderThickness="1" CornerRadius="6" ClipToBounds="True"
                        BorderBrush="#44AA8833">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top" Padding="10,7" Margin="0,0,0,1"
                                BorderBrush="#33AA8833" BorderThickness="0,0,0,1"
                                Background="#221A1008">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚔" FontSize="13" Margin="0,0,6,0"
                                               Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Personnages" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrightGoldBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="BtnRosterCollapse" Grid.Column="1"
                                        Style="{StaticResource CartoThinClose}"
                                        Click="CloseRosterPanel_Click"
                                        ToolTip="Fermer le volet personnages"/>
                            </Grid>
                        </Border>
                        <ScrollViewer x:Name="CharacterRosterScroller" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                                      MaxHeight="720" Padding="4,4,6,6">
                            <StackPanel x:Name="CharacterRosterRoot" HorizontalAlignment="Stretch"/>
                        </ScrollViewer>
                        <ListBox x:Name="CharacterRosterList" Visibility="Collapsed"
                                 ItemsSource="{Binding FilteredCharacters}"
                                 SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}"
                                 MouseDoubleClick="CharacterRosterList_MouseDoubleClick"/>
                    </DockPanel>
                </Border>

                <!-- Volet recherche (à côté des persos) -->
                <Border x:Name="ItemSearchPanel" Grid.Column="1" Width="336" Margin="0,0,4,0"
                        Background="#18141008" BorderThickness="1" CornerRadius="6" ClipToBounds="True"
                        BorderBrush="#55AA8833" Visibility="Collapsed">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Top" Style="{StaticResource CartoSideHeaderBorder}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource CartoThinClose}"
                                                Click="CloseItemSearchPanel_Click"/>
                                        <TextBlock Text="Recherche d'objets" Style="{StaticResource CartoSideTitle}"/>
                                    </DockPanel>
                                </Border>
                                <StackPanel Margin="8,6,8,8">
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource StoneButton}"
                                                FontSize="11" Padding="8,4" Margin="6,0,0,0"
                                                Command="{Binding ClearItemSearchCommand}" ToolTip="Effacer"/>
                                        <TextBox Text="{Binding ItemSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12" Padding="6,4" VerticalContentAlignment="Center"
                                                 Background="{DynamicResource SelectionBgBrush}"
                                                 Foreground="{DynamicResource TextBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                 Tag="Feuillerêve, Thorium…"/>
                                    </DockPanel>
                                    <TextBlock Text="Min. 2 caractères — inventaire, banque, courrier"
                                               FontSize="9" Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,6"/>
                                    <ListBox ItemsSource="{Binding ItemSearchResults}" MaxHeight="480"
                                             Background="#120E08" BorderBrush="#55AA8833" BorderThickness="1"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button Background="Transparent" BorderThickness="0" Padding="6,4" Cursor="Hand"
                                                        HorizontalContentAlignment="Stretch"
                                                        Command="{Binding DataContext.SelectItemSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding ItemName}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource BrightGoldBrush}"/>
                                                            <TextBlock Text="{Binding DisplayLine}" FontSize="10"
                                                                       Foreground="{DynamicResource SubtextBrush}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding AccountName}" FontSize="9"
                                                                   Foreground="{DynamicResource SubtextBrush}" VerticalAlignment="Center"
                                                                   Margin="8,0,0,0"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,1"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#18FFD700"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                <!-- Volet timers (à côté des persos) -->
                <Border x:Name="TimersPanelHost" Grid.Column="2" Width="348"
                        Background="#18141008" BorderThickness="1" CornerRadius="6" ClipToBounds="True"
                        BorderBrush="#55AA8833" Visibility="Collapsed">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top" Style="{StaticResource CartoSideHeaderBorder}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource CartoThinClose}"
                                        Click="CloseTimersPanel_Click"/>
                                <Button DockPanel.Dock="Right" Content="＋" Style="{DynamicResource StoneButton}"
                                        FontSize="14" Padding="8,4" MinWidth="28" Margin="0,0,8,0"
                                        Click="ActionTimer_Click" ToolTip="Nouveau timer"/>
                                <TextBlock Text="Timers" Style="{StaticResource CartoSideTitle}"/>
                            </DockPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="720" Padding="6,4,6,6">
                            <ItemsControl x:Name="TimerList" ItemsSource="{Binding Timers}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,4">
                                            <!-- Buttons outside, no background -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Margin="4,0,0,0">
                                                <Button Content="▶" FontSize="10" Padding="4,2" ToolTip="Reprendre"
                                                        Foreground="#80FF80" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Click="TimerResume_Click" Loaded="TimerPlayPauseBtn_Loaded"/>
                                                <Button Content="⏸" FontSize="10" Padding="4,2" ToolTip="Pause"
                                                        Foreground="#FFD700" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Click="TimerStop_Click" Loaded="TimerPlayPauseBtn_Loaded"/>
                                                <Button Content="↻" FontSize="10" Padding="4,2" ToolTip="Relancer"
                                                        Foreground="LightSkyBlue" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Click="TimerRestart_Click"/>
                                                <Button Content="✕" FontSize="10" Padding="4,2" ToolTip="Supprimer"
                                                        Foreground="#FF6B6B" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Click="TimerRemove_Click"/>
                                            </StackPanel>
                                            <!-- Progress bar + info on one line -->
                                            <Border CornerRadius="4" Padding="0" BorderThickness="1"
                                                    Height="32" Tag="timerCard" Loaded="TimerCard_Loaded">
                                                <Border.BorderBrush>
                                                    <SolidColorBrush Color="#33AADDFF"/>
                                                </Border.BorderBrush>
                                                <Border.Background>
                                                    <SolidColorBrush Color="#18182838"/>
                                                </Border.Background>
                                                <Grid ClipToBounds="True">
                                                    <Border x:Name="TimerProgressBar" CornerRadius="4"
                                                            HorizontalAlignment="Left" Opacity="0.15">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="DeepSkyBlue"/>
                                                        </Border.Background>
                                                    </Border>
                                                    <DockPanel Margin="8,0">
                                                        <!-- Countdown right-aligned -->
                                                        <TextBlock DockPanel.Dock="Right" FontSize="12" FontWeight="Bold"
                                                                   Foreground="DeepSkyBlue" VerticalAlignment="Center"
                                                                   Tag="{Binding}"/>
                                                        <!-- Label + duration -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBox FontSize="12" FontWeight="SemiBold"
                                                                     Foreground="{DynamicResource TextBrush}"
                                                                     Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                                     VerticalAlignment="Center"
                                                                     Background="Transparent" BorderThickness="0"
                                                                     Padding="0" MinWidth="40"
                                                                     LostFocus="TimerLabel_Changed"
                                                                     VerticalContentAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                        Opacity="0.7" Margin="10,0,0,0"
                                                                        Loaded="TimerDurationPanel_Loaded">
                                                                <TextBox Width="26" Height="22" FontSize="10" Padding="1,0"
                                                                         TextAlignment="Center" Tag="h"
                                                                         LostFocus="TimerDuration_Changed"
                                                                         Background="Transparent"
                                                                         Foreground="{DynamicResource SubtextBrush}"
                                                                         BorderBrush="{DynamicResource BorderBrush}"
                                                                         BorderThickness="0,0,0,1"
                                                                         VerticalContentAlignment="Center"/>
                                                                <TextBlock Text="h" FontSize="10" Foreground="{DynamicResource SubtextBrush}"
                                                                           VerticalAlignment="Center" Margin="1,0,3,0"/>
                                                                <TextBox Width="26" Height="22" FontSize="10" Padding="1,0"
                                                                         TextAlignment="Center" Tag="m"
                                                                         LostFocus="TimerDuration_Changed"
                                                                         Background="Transparent"
                                                                         Foreground="{DynamicResource SubtextBrush}"
                                                                         BorderBrush="{DynamicResource BorderBrush}"
                                                                         BorderThickness="0,0,0,1"
                                                                         VerticalContentAlignment="Center"/>
                                                                <TextBlock Text="m" FontSize="10" Foreground="{DynamicResource SubtextBrush}"
                                                                           VerticalAlignment="Center" Margin="1,0,3,0"/>
                                                                <TextBox Width="26" Height="22" FontSize="10" Padding="1,0"
                                                                         TextAlignment="Center" Tag="s"
                                                                         LostFocus="TimerDuration_Changed"
                                                                         Background="Transparent"
                                                                         Foreground="{DynamicResource SubtextBrush}"
                                                                         BorderBrush="{DynamicResource BorderBrush}"
                                                                         BorderThickness="0,0,0,1"
                                                                         VerticalContentAlignment="Center"/>
                                                                <TextBlock Text="s" FontSize="10" Foreground="{DynamicResource SubtextBrush}"
                                                                           VerticalAlignment="Center" Margin="1,0,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Grid>
                                            </Border>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Volet zones & donjons -->
                <Border x:Name="ZonesPanelHost" Grid.Column="3" Width="328" Margin="0,0,4,0"
                        Background="#12181014" BorderThickness="1" CornerRadius="6" ClipToBounds="True"
                        BorderBrush="#55AAEE88" Visibility="Collapsed">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top" Padding="10,8" Margin="0,0,0,1"
                                BorderBrush="#44AAEE88" BorderThickness="0,0,0,1"
                                Background="#1E281810">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource CartoThinClose}"
                                        Click="CloseZonesPanel_Click"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🗺" FontSize="13" Margin="0,0,6,0"
                                               Foreground="#FFAAEE88" VerticalAlignment="Center"/>
                                    <TextBlock Text="Zones" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrightGoldBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ZonePanelStatusMessage}"
                                   FontSize="9" Foreground="{DynamicResource SubtextBrush}"
                                   TextWrapping="Wrap" Margin="10,6,10,8" MinHeight="28"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,6,8,4">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="＋" Style="{DynamicResource StoneButton}"
                                            FontSize="14" Padding="8,4" MinWidth="30" Margin="6,0,0,0"
                                            Command="{Binding AddWorldZoneFromPanelCommand}"
                                            ToolTip="Ajouter une zone (ou clic sur la carte)"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Zones ouvertes" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#FFAAEE88"/>
                                        <TextBlock Text="Rectangles sur la carte monde" FontSize="9"
                                                   Foreground="{DynamicResource SubtextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <ComboBox x:Name="ZoneAddCombo" Height="26" FontSize="10" Margin="0,0,0,4"
                                          ItemsSource="{Binding ZoneCatalogItems}"
                                          SelectedValuePath="MapId"
                                          SelectedValue="{Binding ZoneToAddMapId, Mode=TwoWay}"
                                          ToolTip="Zone à ajouter sur la carte">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type carto:ZoneCatalogListItem}">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="10"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="Tout afficher sur la carte" Style="{DynamicResource StoneButton}"
                                        FontSize="9" Padding="6,3" Margin="0,0,0,6" HorizontalAlignment="Left"
                                        Command="{Binding ClearZoneMapFocusCommand}"
                                        ToolTip="Désélectionner pour réafficher toutes les zones"/>
                                <ListBox x:Name="ZoneRectsListBox"
                                         ItemsSource="{Binding WorldZoneRects}"
                                         SelectedItem="{Binding SelectedZoneRect, Mode=TwoWay}"
                                         MaxHeight="220" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseDown="ZoneRectsListBox_PreviewMouseDown"
                                         ItemContainerStyle="{StaticResource CartoZoneListItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type carto:CartoZoneRectItem}">
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Content="✕"
                                                        Style="{DynamicResource StoneButton}"
                                                        FontSize="11" Padding="6,2" MinWidth="26" Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.DeleteZoneCommand, ElementName=RootGrid}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Supprimer cette zone"
                                                        Click="ZoneListDelete_Click"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock FontSize="9" Foreground="{DynamicResource SubtextBrush}" Margin="0,2,0,0">
                                                        <Run Text="Carte "/><Run Text="{Binding MapId, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding Width, StringFormat={}{0:P0}, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Height="1" Background="#33AA8833" Margin="0,10,0,10"/>

                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="＋" Style="{DynamicResource StoneButton}"
                                            FontSize="14" Padding="8,4" MinWidth="30" Margin="6,0,0,0"
                                            Command="{Binding StartPlaceDungeonMarkerCommand}"
                                            ToolTip="Placer un repère donjon sur la carte"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Donjons" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#FFBBAAEE"/>
                                        <TextBlock Text="Combo + ＋ pour placer — liste = repères déjà posés" FontSize="9"
                                                   Foreground="{DynamicResource SubtextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                                <ComboBox x:Name="DungeonAddCombo" Height="26" FontSize="10" Margin="0,0,0,4"
                                          ItemsSource="{Binding DungeonCatalogItems}"
                                          SelectedValuePath="Key"
                                          SelectedValue="{Binding DungeonToPlaceKey, Mode=TwoWay}"
                                          ToolTip="Donjon à placer">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type carto:DungeonCatalogListItem}">
                                            <TextBlock Text="{Binding DisplayLabel}" FontSize="10"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="Tout afficher sur la carte" Style="{DynamicResource StoneButton}"
                                        FontSize="9" Padding="6,3" Margin="0,0,0,6" HorizontalAlignment="Left"
                                        Command="{Binding ClearDungeonMapFocusCommand}"
                                        ToolTip="Désélectionner pour réafficher tous les repères"/>
                                <ListBox x:Name="DungeonMarkersListBox"
                                         ItemsSource="{Binding DungeonMarkers}"
                                         SelectedItem="{Binding SelectedDungeonMarker, Mode=TwoWay}"
                                         MaxHeight="240" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseDown="DungeonMarkersListBox_PreviewMouseDown"
                                         ItemContainerStyle="{StaticResource CartoDungeonListItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type carto:CartoDungeonMarker}">
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Content="✕"
                                                        Style="{DynamicResource StoneButton}"
                                                        FontSize="11" Padding="6,2" MinWidth="26" Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.ClearDungeonMarkerCommand, ElementName=RootGrid}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Retirer le repère sur la carte"
                                                        Click="DungeonListDelete_Click"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="{Binding PositionHint}" FontSize="9"
                                                               Foreground="{DynamicResource SubtextBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Height="1" Background="#33AA8833" Margin="0,10,0,10"/>

                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FFFFAA66" Margin="0,0,0,4">
                                    <Run Text="Non placés sur la carte ("/>
                                    <Run Text="{Binding UnplacedCharacters.Count, Mode=OneWay}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                                <TextBlock Text="Zone WowSync — pour repérer instances / zones non calibrées"
                                           FontSize="9" Foreground="{DynamicResource SubtextBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <ListBox ItemsSource="{Binding UnplacedCharacters}"
                                         MaxHeight="200" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type carto:CartoUnplacedCharacterItem}">
                                            <Button Style="{StaticResource StoneButton}" Padding="6,4" Margin="0,0,0,3"
                                                    HorizontalContentAlignment="Left"
                                                    Command="{Binding DataContext.SelectUnplacedCharacterCommand, ElementName=RootGrid}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding SummaryLine}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock FontSize="9" Foreground="{DynamicResource SubtextBrush}" Margin="0,2,0,0">
                                                        <Run Text="{Binding AccountName, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding ZoneDisplay, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="9" Foreground="#FFCC9966" Margin="0,1,0,0">
                                                        <Run Text="map "/>
                                                        <Run Text="{Binding MapId, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding CoordsDisplay, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding ReasonDisplay, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Volet paramètres (comptes WTF) -->
                <Border x:Name="SettingsPanelHost" Grid.Column="4" Width="384" Margin="0,0,0,0"
                        Background="#18141008" BorderThickness="1" CornerRadius="6" ClipToBounds="True"
                        BorderBrush="#55AA8833" Visibility="Collapsed">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top" Style="{StaticResource CartoSideHeaderBorder}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource CartoThinClose}"
                                        Click="CloseSettingsPanel_Click"/>
                                <TextBlock Text="Paramètres" Style="{StaticResource CartoSideTitle}"/>
                            </DockPanel>
                        </Border>
                        <Border DockPanel.Dock="Bottom" Padding="8,6,8,8" Background="#22181008"
                                BorderBrush="#55AA8833" BorderThickness="0,1,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Enregistrer" Style="{DynamicResource WowButton}"
                                        FontSize="10" Padding="12,5" Margin="6,0,0,0" Click="SaveAccountSettings_Click"/>
                                <Button DockPanel.Dock="Right" Content="Annuler" Style="{DynamicResource StoneButton}"
                                        FontSize="10" Padding="10,5" Click="CloseSettingsPanel_Click"/>
                                <Button Content="Rescan WTF" Style="{DynamicResource StoneButton}" FontSize="10" Padding="10,5"
                                        Click="RefreshAccountSettings_Click" ToolTip="Rescanner les dossiers WTF"/>
                            </DockPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,6,8,8">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource SubtextBrush}"
                                           Margin="0,0,0,8">
                                    Dossiers WTF : assignez chaque compte à un utilisateur (ex. Moi, Eloi).
                                </TextBlock>
                                <TextBlock Text="Amis" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrightGoldBrush}" Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" FontSize="9" Foreground="{DynamicResource SubtextBrush}"
                                           Margin="0,0,0,6">
                                    Regrouper les comptes d'autres joueurs (affichés en bleu dans le roster).
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding FriendCartoUsers}" Margin="0,0,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type carto:CartoUser}">
                                            <Border Background="#1A2848" CornerRadius="4" Padding="8,5" Margin="0,0,0,4"
                                                    BorderBrush="#4466AA" BorderThickness="1">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource StoneButton}"
                                                            FontSize="10" Padding="6,2" Foreground="OrangeRed"
                                                            Command="{Binding DataContext.RemoveFriendCartoUserCommand, ElementName=RootGrid}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Retirer cet ami"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="CornflowerBlue" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" FontSize="11" Padding="4,3" Margin="0,0,6,0"
                                             Text="{Binding NewFriendUserName, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{DynamicResource SelectionBgBrush}"
                                             Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                             ToolTip="Nom de l'ami"/>
                                    <Button Grid.Column="1" Content="Ajouter" Style="{DynamicResource StoneButton}"
                                            FontSize="10" Padding="10,4"
                                            Command="{Binding AddFriendCartoUserCommand}"/>
                                </Grid>
                                <TextBlock Text="{Binding FriendUserStatusMessage}" FontSize="9"
                                           Foreground="{DynamicResource SubtextBrush}" TextWrapping="Wrap"
                                           Margin="0,0,0,10" MinHeight="14"/>
                                <TextBlock Text="Comptes WTF" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrightGoldBrush}" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding AccountSettingRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#221A1008" CornerRadius="4" Padding="8,6" Margin="0,0,0,6"
                                                    BorderBrush="#55443322" BorderThickness="1"
                                                    ToolTip="{Binding SourceFolder}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SourceFolder}" FontSize="9"
                                                               Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,4"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="110"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontSize="12" Padding="4,3" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                 Background="{DynamicResource SelectionBgBrush}"
                                                                 Foreground="{DynamicResource TextBrush}"
                                                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                                        <cartoUi:WowCurrencyControl Grid.Column="1"
                                                                                       CopperTotal="{Binding GoldCopper}"
                                                                                       IconSize="14" AmountFontSize="10"
                                                                                       VerticalAlignment="Center"
                                                                                       Margin="0,0,8,0"/>
                                                        <ComboBox Grid.Column="2" FontSize="10" Height="26"
                                                                  ItemsSource="{Binding DataContext.CartoUsers, ElementName=RootGrid}"
                                                                  DisplayMemberPath="Name"
                                                                  SelectedValuePath="Id"
                                                                  SelectedValue="{Binding UserId, UpdateSourceTrigger=PropertyChanged}"
                                                                  SelectionChanged="AccountUserCombo_SelectionChanged">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type carto:CartoUser}">
                                                                    <TextBlock Text="{Binding Name}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
        </Grid>

        <!-- Add Character Popup -->
        <Popup x:Name="PopupAddChar" Placement="Center" StaysOpen="False" AllowsTransparency="True"
               PlacementTarget="{Binding ElementName=RootGrid}">
                    <Border Background="#F0141008" CornerRadius="8" Padding="14"
                            BorderThickness="1.5" MinWidth="280" MaxWidth="320">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#CC996600" Offset="0"/>
                                <GradientStop Color="#88664400" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.7" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="➕ Nouveau personnage" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource BrightGoldBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="Nom" FontSize="10" Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,2"/>
                            <TextBox FontSize="11" Padding="4,3" Margin="0,0,0,6"
                                     Text="{Binding NewCharName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="55"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" FontSize="11" Height="26"
                                          ItemsSource="{Binding WowClasses}" SelectedItem="{Binding NewCharClass}"/>
                                <TextBox Grid.Column="1" FontSize="11" Padding="4,3" Margin="4,0,0,0"
                                         Text="{Binding NewCharLevel, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" FontSize="11" Height="26" Margin="0,0,2,0"
                                          ItemsSource="{Binding Accounts}" DisplayMemberPath="Name"
                                          SelectedValuePath="Id" SelectedValue="{Binding NewCharAccountId}"/>
                                <ComboBox Grid.Column="1" FontSize="11" Height="26" Margin="2,0,0,0"
                                          ItemsSource="{Binding CharacterStatusValues}"
                                          SelectedItem="{Binding NewCharStatus}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource StatusConv}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
        </Popup>

        <!-- Add Timer Popup -->
        <Popup x:Name="PopupAddTimer" Placement="Center" StaysOpen="False" AllowsTransparency="True"
               PlacementTarget="{Binding ElementName=RootGrid}">
                    <Border Background="#F0141008" CornerRadius="8" Padding="14"
                            BorderThickness="1.5" MinWidth="250">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#CC996600" Offset="0"/>
                                <GradientStop Color="#88664400" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.7" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="⏱ Nouveau timer" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource BrightGoldBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="Nom du timer" FontSize="10" Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,2"/>
                            <TextBox FontSize="11" Padding="4,3" Margin="0,0,0,6"
                                     Text="{Binding NewTimerLabel, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            <TextBlock Text="Durée" FontSize="10" Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox Width="40" FontSize="11" Padding="3" TextAlignment="Center"
                                         Text="{Binding NewTimerHours, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                <TextBlock Text="h" FontSize="10" Foreground="{DynamicResource SubtextBrush}"
                                           VerticalAlignment="Center" Margin="3,0,8,0"/>
                                <TextBox Width="40" FontSize="11" Padding="3" TextAlignment="Center"
                                         Text="{Binding NewTimerMinutes, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                <TextBlock Text="m" FontSize="10" Foreground="{DynamicResource SubtextBrush}"
                                           VerticalAlignment="Center" Margin="3,0,8,0"/>
                                <TextBox Width="40" FontSize="11" Padding="3" TextAlignment="Center"
                                         Text="{Binding NewTimerSeconds, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                <TextBlock Text="s" FontSize="10" Foreground="{DynamicResource SubtextBrush}"
                                           VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </StackPanel>
                            <Button Content="Créer" Style="{DynamicResource StoneButton}" FontSize="11"
                                    Padding="8,5" HorizontalAlignment="Stretch"
                                    Command="{Binding StartPlaceTimerCommand}" Click="PopupClose_Click"/>
                        </StackPanel>
                    </Border>
        </Popup>

    </Grid>
</UserControl>
