<UserControl x:Class="WindowsOrganiserApp.Views.CartoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WindowsOrganiserApp.Converters"
             xmlns:carto="clr-namespace:WindowsOrganiserApp.Models.Carto">

    <UserControl.Resources>
        <conv:WowClassColorConverter x:Key="ClassColorConv"/>
        <conv:CooldownRemainingConverter x:Key="CdConv"/>
        <conv:ListSummaryConverter x:Key="ListSummaryConv"/>
        <conv:AccountIdToNameConverter x:Key="AccountConv"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Map area -->
        <DockPanel Grid.Column="0">
            <!-- Toolbar: zoom + overlay toggles -->
            <WrapPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,0,0,4"
                       Background="{DynamicResource PanelBg}">
                    <Button Content="➕" Style="{DynamicResource StoneButton}" FontSize="12" Padding="8,4"
                            Command="{Binding ZoomInCommand}"/>
                    <Button Content="➖" Style="{DynamicResource StoneButton}" FontSize="12" Padding="8,4" Margin="4,0"
                            Command="{Binding ZoomOutCommand}"/>
                    <Button Content="↺" Style="{DynamicResource StoneButton}" FontSize="12" Padding="8,4"
                            Command="{Binding ResetZoomCommand}"/>
                    <TextBlock Text="{Binding MapZoom, StringFormat='x{0:F1}'}" FontSize="11"
                               Foreground="{DynamicResource SubtextBrush}" VerticalAlignment="Center" Margin="8,0,8,0"/>

                    <Border Background="{DynamicResource PanelBg2}" CornerRadius="3" Padding="4,2" Margin="2,0">
                        <CheckBox Content="📋 Tableau" IsChecked="{Binding ShowTableView}" FontSize="10"
                                  Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center"/>
                    </Border>

                    <Border Background="#44FF0000" CornerRadius="3" Padding="6,2" Margin="8,0,0,0"
                            Visibility="{Binding IsPlacingCharacter, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="🎯 Cliquez pour placer le personnage" FontSize="10"
                                   Foreground="#FFFF6666"/>
                    </Border>
                    <Border Background="#4400AAFF" CornerRadius="3" Padding="6,2" Margin="4,0,0,0"
                            Visibility="{Binding IsPlacingTimer, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⏱ Cliquez pour placer le timer" FontSize="10"
                                   Foreground="#FF66CCFF"/>
                    </Border>
                </WrapPanel>

            <!-- Content: map or table -->
            <Grid>
                <!-- Map canvas -->
                <Border x:Name="MapBorder" Background="Black" ClipToBounds="True"
                        MouseLeftButtonDown="MapCanvas_MouseDown"
                        MouseRightButtonDown="MapCanvas_RightMouseDown"
                        MouseMove="MapCanvas_MouseMove"
                        MouseLeftButtonUp="MapCanvas_MouseUp"
                        MouseWheel="MapCanvas_MouseWheel">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowTableView}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid x:Name="MapContainer" Background="Transparent">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="MapScale"
                                                ScaleX="{Binding MapZoom}"
                                                ScaleY="{Binding MapZoom}"
                                                CenterX="0" CenterY="0"/>
                                <TranslateTransform x:Name="MapTranslate"
                                                    X="{Binding MapOffsetX}"
                                                    Y="{Binding MapOffsetY}"/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Image x:Name="MapImage" Source="/Assets/wow_map_vanilla.png"
                               Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Canvas x:Name="MapCanvas" IsHitTestVisible="True"
                                Width="{Binding ActualWidth, ElementName=MapImage}"
                                Height="{Binding ActualHeight, ElementName=MapImage}"
                                HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <!-- Character tooltip popup -->
                <Popup x:Name="CharPopup" Placement="Mouse" StaysOpen="True" AllowsTransparency="True">
                    <Border Background="#F5141008" CornerRadius="8" Padding="10"
                            MaxWidth="380" MaxHeight="520"
                            BorderThickness="1.5">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#CC996600" Offset="0"/>
                                <GradientStop Color="#88664400" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6" Color="Black"/>
                        </Border.Effect>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="CharPopupContent"/>
                        </ScrollViewer>
                    </Border>
                </Popup>

                <!-- Table view -->
                <DataGrid x:Name="SummaryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          ItemsSource="{Binding FilteredCharacters}"
                          Background="{DynamicResource PanelBg2}" Foreground="{DynamicResource TextBrush}"
                          BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                          RowBackground="{DynamicResource PanelBg}" AlternatingRowBackground="{DynamicResource PanelBg2}"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource InnerBorderBrush}"
                          HeadersVisibility="Column" CanUserSortColumns="True"
                          FontSize="11" RowHeight="26" ColumnHeaderHeight="28"
                          SelectionMode="Single" MouseDoubleClick="SummaryGrid_DoubleClick">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowTableView}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground"
                                    Value="{Binding Class, Converter={StaticResource ClassColorConv}}"/>
                            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FF3A3520"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#FF2A2520"/>
                            <Setter Property="Foreground" Value="#FFE0D8C8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="BorderBrush" Value="#FF444038"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="110"/>
                        <DataGridTextColumn Header="Classe" Binding="{Binding Class}" Width="80"/>
                        <DataGridTextColumn Header="Lv" Binding="{Binding Level}" Width="35"/>
                        <DataGridTextColumn Header="Compte" Binding="{Binding AccountId, Converter={StaticResource AccountConv}}" Width="80"/>
                        <DataGridTextColumn Header="💎" Binding="{Binding ShardCount}" Width="35"/>
                        <DataGridTextColumn Header="Métiers" Width="130"
                                            Binding="{Binding Professions, Converter={StaticResource ListSummaryConv}, ConverterParameter=prof}"/>
                        <DataGridTextColumn Header="CDs" Width="110"
                                            Binding="{Binding Cooldowns, Converter={StaticResource ListSummaryConv}, ConverterParameter=cd}"/>
                        <DataGridTextColumn Header="Quêtes" Width="90"
                                            Binding="{Binding QuestItems, Converter={StaticResource ListSummaryConv}, ConverterParameter=qi}"/>
                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DockPanel>

        <!-- Right panel -->
        <Border Grid.Column="2" Background="{DynamicResource PanelBg}" CornerRadius="6"
                Padding="6" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Filters -->
                    <Expander IsExpanded="True" Margin="0,0,0,4">
                        <Expander.Header>
                            <TextBlock Text="⚔ Filtres" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrightGoldBrush}"/>
                        </Expander.Header>
                        <StackPanel Margin="0,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nom" FontSize="10"
                                           Foreground="{DynamicResource SubtextBrush}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                <TextBox Grid.Row="0" Grid.Column="1" FontSize="11" Padding="4,2" Margin="0,0,0,4"
                                         Text="{Binding FilterName, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Classe" FontSize="10"
                                           Foreground="{DynamicResource SubtextBrush}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" FontSize="11" Height="26" Margin="0,0,0,4"
                                          ItemsSource="{Binding WowClasses}" SelectedItem="{Binding FilterClass}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Level" FontSize="10"
                                           Foreground="{DynamicResource SubtextBrush}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBox Width="40" FontSize="11" Padding="2" Text="{Binding FilterLevelMin, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                    <TextBlock Text=" — " FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SubtextBrush}"/>
                                    <TextBox Width="40" FontSize="11" Padding="2" Text="{Binding FilterLevelMax, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                </StackPanel>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Compte" FontSize="10"
                                           Foreground="{DynamicResource SubtextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" FontSize="11" Height="26"
                                          ItemsSource="{Binding Accounts}" DisplayMemberPath="Name"
                                          SelectedValuePath="Id" SelectedValue="{Binding FilterAccountId}"/>
                            </Grid>
                            <Button Content="✕ Effacer" Style="{DynamicResource StoneButton}" FontSize="10"
                                    Padding="6,3" Margin="0,6,0,0" HorizontalAlignment="Left"
                                    Command="{Binding ClearFiltersCommand}"/>
                        </StackPanel>
                    </Expander>

                    <!-- Characters tree -->
                    <Expander IsExpanded="True" Margin="0,0,0,4">
                        <Expander.Header>
                            <TextBlock Text="👥 Personnages" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrightGoldBrush}"/>
                        </Expander.Header>
                        <TreeView x:Name="CharTreeView" Margin="0,4,0,0" MaxHeight="280"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{DynamicResource TextBrush}"
                                  MouseDoubleClick="CharTreeView_DoubleClick"/>
                    </Expander>

                    <!-- Timers -->
                    <Expander IsExpanded="True" Margin="0,0,0,4">
                        <Expander.Header>
                            <TextBlock Text="⏱ Timers" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrightGoldBrush}"/>
                        </Expander.Header>
                        <StackPanel Margin="0,4,0,0">
                            <TextBox FontSize="10" Padding="4,2" Margin="0,0,0,4"
                                     Text="{Binding NewTimerLabel, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                     ToolTip="Nom du timer"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBox Width="32" FontSize="10" Padding="2" TextAlignment="Center"
                                         Text="{Binding NewTimerHours, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ToolTip="Heures"/>
                                <TextBlock Text="h" FontSize="9" Foreground="{DynamicResource SubtextBrush}"
                                           VerticalAlignment="Center" Margin="2,0,6,0"/>
                                <TextBox Width="32" FontSize="10" Padding="2" TextAlignment="Center"
                                         Text="{Binding NewTimerMinutes, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ToolTip="Minutes"/>
                                <TextBlock Text="m" FontSize="9" Foreground="{DynamicResource SubtextBrush}"
                                           VerticalAlignment="Center" Margin="2,0,6,0"/>
                                <TextBox Width="32" FontSize="10" Padding="2" TextAlignment="Center"
                                         Text="{Binding NewTimerSeconds, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ToolTip="Secondes"/>
                                <TextBlock Text="s" FontSize="9" Foreground="{DynamicResource SubtextBrush}"
                                           VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </StackPanel>
                            <Button Content="⏱ Placer un timer" Style="{DynamicResource StoneButton}" FontSize="10"
                                    Padding="6,3" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                    Command="{Binding StartPlaceTimerCommand}"/>
                            <ItemsControl x:Name="TimerList" ItemsSource="{Binding Timers}" Margin="0,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PanelBg2}" CornerRadius="3"
                                                Padding="6,4" Margin="0,0,0,3"
                                                BorderThickness="1" BorderBrush="{DynamicResource InnerBorderBrush}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="▶" FontSize="9" Padding="3,1" ToolTip="Reprendre"
                                                                Style="{DynamicResource StoneButton}" Foreground="LimeGreen"
                                                                Click="TimerResume_Click" Loaded="TimerPlayPauseBtn_Loaded"/>
                                                        <Button Content="⏸" FontSize="9" Padding="3,1" Margin="2,0,0,0" ToolTip="Pause"
                                                                Style="{DynamicResource StoneButton}" Foreground="Gold"
                                                                Click="TimerStop_Click" Loaded="TimerPlayPauseBtn_Loaded"/>
                                                        <Button Content="↻" FontSize="9" Padding="3,1" Margin="2,0,0,0" ToolTip="Relancer depuis 0"
                                                                Style="{DynamicResource StoneButton}" Click="TimerRestart_Click"/>
                                                        <Button Content="✕" FontSize="9" Padding="3,1" Margin="2,0,0,0" ToolTip="Supprimer"
                                                                Style="{DynamicResource StoneButton}" Foreground="OrangeRed"
                                                                Click="TimerRemove_Click"/>
                                                    </StackPanel>
                                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextBrush}"
                                                               Text="{Binding Label}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <!-- Duration edit + countdown -->
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                            Loaded="TimerDurationPanel_Loaded">
                                                    <TextBox Width="28" FontSize="9" Padding="1" TextAlignment="Center"
                                                             Tag="h" LostFocus="TimerDuration_Changed"
                                                             Background="{DynamicResource SelectionBgBrush}"
                                                             Foreground="{DynamicResource TextBrush}"
                                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                             ToolTip="Heures"/>
                                                    <TextBlock Text="h" FontSize="8" Foreground="{DynamicResource SubtextBrush}"
                                                               VerticalAlignment="Center" Margin="1,0,4,0"/>
                                                    <TextBox Width="28" FontSize="9" Padding="1" TextAlignment="Center"
                                                             Tag="m" LostFocus="TimerDuration_Changed"
                                                             Background="{DynamicResource SelectionBgBrush}"
                                                             Foreground="{DynamicResource TextBrush}"
                                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                             ToolTip="Minutes"/>
                                                    <TextBlock Text="m" FontSize="8" Foreground="{DynamicResource SubtextBrush}"
                                                               VerticalAlignment="Center" Margin="1,0,4,0"/>
                                                    <TextBox Width="28" FontSize="9" Padding="1" TextAlignment="Center"
                                                             Tag="s" LostFocus="TimerDuration_Changed"
                                                             Background="{DynamicResource SelectionBgBrush}"
                                                             Foreground="{DynamicResource TextBrush}"
                                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                             ToolTip="Secondes"/>
                                                    <TextBlock Text="s" FontSize="8" Foreground="{DynamicResource SubtextBrush}"
                                                               VerticalAlignment="Center" Margin="1,0,6,0"/>
                                                    <TextBlock FontSize="9" Foreground="LightSkyBlue" VerticalAlignment="Center"
                                                               Tag="{Binding}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <!-- Add character -->
                    <Expander IsExpanded="True" Margin="0,0,0,4">
                        <Expander.Header>
                            <TextBlock Text="➕ Nouveau personnage" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrightGoldBrush}"/>
                        </Expander.Header>
                        <StackPanel Margin="0,4,0,0">
                            <TextBox FontSize="11" Padding="4,3" Margin="0,0,0,4"
                                     Text="{Binding NewCharName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" FontSize="11" Height="26"
                                          ItemsSource="{Binding WowClasses}" SelectedItem="{Binding NewCharClass}"/>
                                <TextBox Grid.Column="1" FontSize="11" Padding="4,3" Margin="4,0,0,0"
                                         Text="{Binding NewCharLevel, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            </Grid>
                            <ComboBox FontSize="11" Height="26" Margin="0,0,0,4"
                                      ItemsSource="{Binding Accounts}" DisplayMemberPath="Name"
                                      SelectedValuePath="Id" SelectedValue="{Binding NewCharAccountId}"/>
                            <Button Content="📍 Placer sur la carte" Style="{DynamicResource StoneButton}" FontSize="11"
                                    Padding="8,4" HorizontalAlignment="Stretch"
                                    Command="{Binding StartPlaceCharacterCommand}"/>
                        </StackPanel>
                    </Expander>

                    <!-- Accounts -->
                    <Expander IsExpanded="False" Margin="0,0,0,4">
                        <Expander.Header>
                            <TextBlock Text="👤 Comptes" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrightGoldBrush}"/>
                        </Expander.Header>
                        <StackPanel Margin="0,4,0,0">
                            <ItemsControl ItemsSource="{Binding Accounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,3">
                                            <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource StoneButton}"
                                                    FontSize="9" Padding="4,1" Click="RemoveAccount_Click"/>
                                            <TextBlock Text="{Binding Name}" FontSize="11"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,4,0,0">
                                <Button DockPanel.Dock="Right" Content="+" Style="{DynamicResource StoneButton}"
                                        FontSize="10" Padding="6,2" Margin="4,0,0,0" Click="AddAccount_Click"/>
                                <TextBox x:Name="NewAccountBox" FontSize="11" Padding="4,2"
                                         KeyDown="NewAccountBox_KeyDown"
                                         Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            </DockPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Import / Export -->
                    <Expander IsExpanded="False" Margin="0,0,0,4">
                        <Expander.Header>
                            <TextBlock Text="📦 Partage" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrightGoldBrush}"/>
                        </Expander.Header>
                        <StackPanel Margin="0,4,0,0">
                            <Button Content="📤 Exporter" Style="{DynamicResource StoneButton}" FontSize="10"
                                    Padding="6,3" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                    Command="{Binding ExportDataCommand}"/>
                            <Button Content="📥 Importer (ami)" Style="{DynamicResource StoneButton}" FontSize="10"
                                    Padding="6,3" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                    Command="{Binding ImportDataCommand}"/>
                            <Button Content="🗑 Supprimer importés" Style="{DynamicResource StoneButton}" FontSize="10"
                                    Padding="6,3" HorizontalAlignment="Stretch" Foreground="#FFCC6666"
                                    Command="{Binding ClearImportedCommand}"/>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
