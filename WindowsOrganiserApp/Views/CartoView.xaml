<UserControl x:Class="WindowsOrganiserApp.Views.CartoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WindowsOrganiserApp.Converters"
             xmlns:carto="clr-namespace:WindowsOrganiserApp.Models.Carto">

    <UserControl.Resources>
        <conv:WowClassColorConverter x:Key="ClassColorConv"/>
        <conv:CooldownRemainingConverter x:Key="CdConv"/>
        <conv:ListSummaryConverter x:Key="ListSummaryConv"/>
        <conv:AccountIdToNameConverter x:Key="AccountConv"/>
        <conv:CharacterStatusConverter x:Key="StatusConv"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToOnlineBrushConverter x:Key="BoolToOnlineBrush"/>
        <conv:BoolToOnlineTooltipConverter x:Key="BoolToOnlineTooltip"/>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Map area -->
        <DockPanel Grid.Column="0">
            <!-- Toolbar: zoom + filters + toggles -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBg}" Padding="4,3" Margin="0,0,0,2">
                <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Zoom -->
                    <Button Content="➕" Style="{DynamicResource StoneButton}" FontSize="11" Padding="6,3"
                            Command="{Binding ZoomInCommand}"/>
                    <Button Content="➖" Style="{DynamicResource StoneButton}" FontSize="11" Padding="6,3" Margin="2,0"
                            Command="{Binding ZoomOutCommand}"/>
                    <Button Content="↺" Style="{DynamicResource StoneButton}" FontSize="11" Padding="6,3"
                            Command="{Binding ResetZoomCommand}"/>
                    <TextBlock Text="{Binding MapZoom, StringFormat='x{0:F1}'}" FontSize="10"
                               Foreground="{DynamicResource SubtextBrush}" VerticalAlignment="Center" Margin="4,0,6,0"/>

                    <!-- Separator -->
                    <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}" Margin="4,0"/>

                    <!-- Filters inline -->
                    <TextBlock Text="Nom" FontSize="12" Foreground="{DynamicResource SubtextBrush}"
                               VerticalAlignment="Center" Margin="2,0,3,0"/>
                    <TextBox Width="75" Height="28" FontSize="12" Padding="3,0" Margin="0,0,5,0"
                             VerticalContentAlignment="Center"
                             Text="{Binding FilterName, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                    <TextBlock Text="Classe" FontSize="12" Foreground="{DynamicResource SubtextBrush}"
                               VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox Width="90" Height="28" FontSize="12" Margin="0,0,5,0"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding WowClasses}" SelectedItem="{Binding FilterClass}"/>
                    <TextBlock Text="Lv." FontSize="12" Foreground="{DynamicResource SubtextBrush}"
                               VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <TextBox Width="34" Height="28" FontSize="12" Padding="2,0" TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Text="{Binding FilterLevelMin, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                    <TextBlock Text="-" FontSize="12" Foreground="{DynamicResource SubtextBrush}"
                               VerticalAlignment="Center" Margin="2,0"/>
                    <TextBox Width="34" Height="28" FontSize="12" Padding="2,0" Margin="0,0,5,0" TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Text="{Binding FilterLevelMax, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                    <TextBlock Text="Compte" FontSize="12" Foreground="{DynamicResource SubtextBrush}"
                               VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox Width="90" Height="28" FontSize="12" Margin="0,0,5,0"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding Accounts}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding FilterAccountId}"/>
                    <TextBlock Text="Status" FontSize="12" Foreground="{DynamicResource SubtextBrush}"
                               VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox Width="80" Height="28" FontSize="12" Margin="0,0,5,0"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding CharacterStatusValues}"
                              SelectedItem="{Binding FilterStatus}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource StatusConv}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="✕" Style="{DynamicResource StoneButton}" FontSize="12" Height="28" Padding="6,0" Margin="2,0"
                            Command="{Binding ClearFiltersCommand}" ToolTip="Effacer les filtres"/>

                    <!-- Separator -->
                    <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}" Margin="4,0"/>

                    <!-- Table toggle -->
                    <Border Background="{DynamicResource PanelBg2}" CornerRadius="3" Padding="4,2" Margin="2,0">
                        <CheckBox Content="📋 Tableau" IsChecked="{Binding ShowTableView}" FontSize="10"
                                  Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Placement indicators -->
                    <Border Background="#44FF0000" CornerRadius="3" Padding="6,2" Margin="4,0,0,0"
                            Visibility="{Binding IsPlacingCharacter, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="🎯 Cliquez pour placer" FontSize="10" Foreground="#FFFF6666"/>
                    </Border>
                    <Border Background="#4400AAFF" CornerRadius="3" Padding="6,2" Margin="4,0,0,0"
                            Visibility="{Binding IsPlacingTimer, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⏱ Cliquez pour placer" FontSize="10" Foreground="#FF66CCFF"/>
                    </Border>
                </WrapPanel>
            </Border>

            <!-- Content: map or table -->
            <Grid>
                <!-- Map canvas -->
                <Border x:Name="MapBorder" Background="Black" ClipToBounds="True"
                        MouseLeftButtonDown="MapCanvas_MouseDown"
                        MouseRightButtonDown="MapCanvas_RightMouseDown"
                        MouseMove="MapCanvas_MouseMove"
                        MouseLeftButtonUp="MapCanvas_MouseUp"
                        MouseWheel="MapCanvas_MouseWheel">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowTableView}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid x:Name="MapContainer" Background="Transparent">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="MapScale"
                                                ScaleX="{Binding MapZoom}"
                                                ScaleY="{Binding MapZoom}"
                                                CenterX="0" CenterY="0"/>
                                <TranslateTransform x:Name="MapTranslate"
                                                    X="{Binding MapOffsetX}"
                                                    Y="{Binding MapOffsetY}"/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Image x:Name="MapImage" Source="/Assets/wow_map_vanilla.png"
                               Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Canvas x:Name="MapCanvas" IsHitTestVisible="True"
                                Width="{Binding ActualWidth, ElementName=MapImage}"
                                Height="{Binding ActualHeight, ElementName=MapImage}"
                                HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <!-- Character tooltip popup -->
                <Popup x:Name="CharPopup" Placement="Mouse" StaysOpen="True" AllowsTransparency="True">
                    <Border Background="#F5141008" CornerRadius="8" Padding="10"
                            MaxWidth="380" MaxHeight="520"
                            BorderThickness="1.5">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#CC996600" Offset="0"/>
                                <GradientStop Color="#88664400" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6" Color="Black"/>
                        </Border.Effect>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="CharPopupContent"/>
                        </ScrollViewer>
                    </Border>
                </Popup>

                <!-- Table view -->
                <DataGrid x:Name="SummaryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          ItemsSource="{Binding FilteredCharacters}"
                          Background="{DynamicResource PanelBg2}" Foreground="{DynamicResource TextBrush}"
                          BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                          RowBackground="{DynamicResource PanelBg}" AlternatingRowBackground="{DynamicResource PanelBg2}"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource InnerBorderBrush}"
                          HeadersVisibility="Column" CanUserSortColumns="True"
                          FontSize="11" RowHeight="26" ColumnHeaderHeight="28"
                          SelectionMode="Single" MouseDoubleClick="SummaryGrid_DoubleClick">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowTableView}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground"
                                    Value="{Binding Class, Converter={StaticResource ClassColorConv}}"/>
                            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FF3A3520"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#FF2A2520"/>
                            <Setter Property="Foreground" Value="#FFE0D8C8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="BorderBrush" Value="#FF444038"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="100"/>
                        <DataGridTextColumn Header="Classe" Binding="{Binding Class}" Width="75"/>
                        <DataGridTextColumn Header="Lv" Binding="{Binding Level}" Width="30"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource StatusConv}}" Width="60"/>
                        <DataGridTextColumn Header="Compte" Binding="{Binding AccountId, Converter={StaticResource AccountConv}}" Width="75"/>
                        <DataGridTextColumn Header="💎" Binding="{Binding ShardCount}" Width="30"/>
                        <DataGridTextColumn Header="Métiers" Width="130"
                                            Binding="{Binding Professions, Converter={StaticResource ListSummaryConv}, ConverterParameter=prof}"/>
                        <DataGridTextColumn Header="CDs" Width="110"
                                            Binding="{Binding Cooldowns, Converter={StaticResource ListSummaryConv}, ConverterParameter=cd}"/>
                        <DataGridTextColumn Header="Quêtes" Width="90"
                                            Binding="{Binding QuestItems, Converter={StaticResource ListSummaryConv}, ConverterParameter=qi}"/>
                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DockPanel>

        <!-- Right panel -->
        <Border Grid.Column="2" Background="{DynamicResource PanelBg}" CornerRadius="6"
                Padding="6" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- ══ Action bar ══ -->
                        <Border Background="{DynamicResource PanelBg2}" CornerRadius="4" Padding="4" Margin="0,0,0,6"
                                BorderThickness="1" BorderBrush="{DynamicResource InnerBorderBrush}">
                            <UniformGrid Columns="4">
                                <Button x:Name="BtnActionChar" Content="➕ Perso" Style="{DynamicResource StoneButton}"
                                        FontSize="10" Padding="4,5" Margin="1" Click="ActionChar_Click"
                                        ToolTip="Ajouter un personnage"/>
                                <Button x:Name="BtnActionAccount" Content="👤 Compte" Style="{DynamicResource StoneButton}"
                                        FontSize="10" Padding="4,5" Margin="1" Click="ActionAccount_Click"
                                        ToolTip="Ajouter un compte"/>
                                <Button x:Name="BtnActionTimer" Content="⏱ Timer" Style="{DynamicResource StoneButton}"
                                        FontSize="10" Padding="4,5" Margin="1" Click="ActionTimer_Click"
                                        ToolTip="Ajouter un timer"/>
                                <Button x:Name="BtnActionFriend" Content="🌐 Ami" Style="{DynamicResource StoneButton}"
                                        FontSize="10" Padding="4,5" Margin="1" Click="ActionFriend_Click"
                                        ToolTip="Ajouter un ami"/>
                            </UniformGrid>
                        </Border>

                        <!-- Characters tree -->
                        <Expander IsExpanded="True" Margin="0,0,0,4">
                            <Expander.Header>
                                <TextBlock Text="👥 Personnages" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrightGoldBrush}"/>
                            </Expander.Header>
                            <TreeView x:Name="CharTreeView" Margin="0,4,0,0" MaxHeight="350"
                                      Background="Transparent" BorderThickness="0"
                                      Foreground="{DynamicResource TextBrush}"
                                      MouseDoubleClick="CharTreeView_DoubleClick"/>
                        </Expander>

                        <!-- Timers -->
                        <Expander IsExpanded="True" Margin="0,0,0,4">
                            <Expander.Header>
                                <TextBlock Text="⏱ Timers" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrightGoldBrush}"/>
                            </Expander.Header>
                            <ItemsControl x:Name="TimerList" ItemsSource="{Binding Timers}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,4">
                                            <!-- Buttons outside, no background -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Margin="4,0,0,0">
                                                <Button Content="▶" FontSize="10" Padding="2,1" ToolTip="Reprendre"
                                                        Foreground="#80FF80" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Click="TimerResume_Click" Loaded="TimerPlayPauseBtn_Loaded"/>
                                                <Button Content="⏸" FontSize="10" Padding="2,1" ToolTip="Pause"
                                                        Foreground="#FFD700" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Click="TimerStop_Click" Loaded="TimerPlayPauseBtn_Loaded"/>
                                                <Button Content="↻" FontSize="10" Padding="2,1" ToolTip="Relancer"
                                                        Foreground="LightSkyBlue" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Click="TimerRestart_Click"/>
                                                <Button Content="✕" FontSize="10" Padding="2,1" ToolTip="Supprimer"
                                                        Foreground="#FF6B6B" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Click="TimerRemove_Click"/>
                                            </StackPanel>
                                            <!-- Progress bar + info on one line -->
                                            <Border CornerRadius="4" Padding="0" BorderThickness="1"
                                                    Height="32" Tag="timerCard" Loaded="TimerCard_Loaded">
                                                <Border.BorderBrush>
                                                    <SolidColorBrush Color="#33AADDFF"/>
                                                </Border.BorderBrush>
                                                <Border.Background>
                                                    <SolidColorBrush Color="#18182838"/>
                                                </Border.Background>
                                                <Grid ClipToBounds="True">
                                                    <Border x:Name="TimerProgressBar" CornerRadius="4"
                                                            HorizontalAlignment="Left" Opacity="0.15">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="DeepSkyBlue"/>
                                                        </Border.Background>
                                                    </Border>
                                                    <DockPanel Margin="8,0">
                                                        <!-- Countdown right-aligned -->
                                                        <TextBlock DockPanel.Dock="Right" FontSize="12" FontWeight="Bold"
                                                                   Foreground="DeepSkyBlue" VerticalAlignment="Center"
                                                                   Tag="{Binding}"/>
                                                        <!-- Label + duration -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBox FontSize="12" FontWeight="SemiBold"
                                                                     Foreground="{DynamicResource TextBrush}"
                                                                     Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                                     VerticalAlignment="Center"
                                                                     Background="Transparent" BorderThickness="0"
                                                                     Padding="0" MinWidth="40"
                                                                     LostFocus="TimerLabel_Changed"
                                                                     VerticalContentAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                        Opacity="0.7" Margin="10,0,0,0"
                                                                        Loaded="TimerDurationPanel_Loaded">
                                                                <TextBox Width="26" Height="22" FontSize="10" Padding="1,0"
                                                                         TextAlignment="Center" Tag="h"
                                                                         LostFocus="TimerDuration_Changed"
                                                                         Background="Transparent"
                                                                         Foreground="{DynamicResource SubtextBrush}"
                                                                         BorderBrush="{DynamicResource BorderBrush}"
                                                                         BorderThickness="0,0,0,1"
                                                                         VerticalContentAlignment="Center"/>
                                                                <TextBlock Text="h" FontSize="10" Foreground="{DynamicResource SubtextBrush}"
                                                                           VerticalAlignment="Center" Margin="1,0,3,0"/>
                                                                <TextBox Width="26" Height="22" FontSize="10" Padding="1,0"
                                                                         TextAlignment="Center" Tag="m"
                                                                         LostFocus="TimerDuration_Changed"
                                                                         Background="Transparent"
                                                                         Foreground="{DynamicResource SubtextBrush}"
                                                                         BorderBrush="{DynamicResource BorderBrush}"
                                                                         BorderThickness="0,0,0,1"
                                                                         VerticalContentAlignment="Center"/>
                                                                <TextBlock Text="m" FontSize="10" Foreground="{DynamicResource SubtextBrush}"
                                                                           VerticalAlignment="Center" Margin="1,0,3,0"/>
                                                                <TextBox Width="26" Height="22" FontSize="10" Padding="1,0"
                                                                         TextAlignment="Center" Tag="s"
                                                                         LostFocus="TimerDuration_Changed"
                                                                         Background="Transparent"
                                                                         Foreground="{DynamicResource SubtextBrush}"
                                                                         BorderBrush="{DynamicResource BorderBrush}"
                                                                         BorderThickness="0,0,0,1"
                                                                         VerticalContentAlignment="Center"/>
                                                                <TextBlock Text="s" FontSize="10" Foreground="{DynamicResource SubtextBrush}"
                                                                           VerticalAlignment="Center" Margin="1,0,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Grid>
                                            </Border>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <!-- Friends -->
                        <Expander IsExpanded="True" Margin="0,0,0,4">
                            <Expander.Header>
                                <TextBlock Text="🌐 Amis" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrightGoldBrush}"/>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding Friends}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,4" Margin="0,0,0,4"
                                                BorderThickness="1" BorderBrush="{DynamicResource InnerBorderBrush}">
                                            <Border.Background>
                                                <SolidColorBrush Color="#1A2040" Opacity="0.6"/>
                                            </Border.Background>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{DynamicResource StoneButton}"
                                                            FontSize="10" Padding="4,1" Margin="2,0,0,0"
                                                            Command="{Binding DataContext.ToggleFriendVisibilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Click="FriendVisibility_Click"
                                                            Loaded="FriendVisibilityBtn_Loaded"
                                                            ToolTip="Afficher/masquer sur la carte"/>
                                                    <Button Content="✕" Style="{DynamicResource StoneButton}"
                                                            FontSize="10" Padding="4,1" Foreground="OrangeRed" Margin="2,0,0,0"
                                                            Command="{Binding DataContext.RemoveFriendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Supprimer cet ami"/>
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center"
                                                                 Fill="{Binding IsOnline, Converter={StaticResource BoolToOnlineBrush}}"
                                                                 ToolTip="{Binding IsOnline, Converter={StaticResource BoolToOnlineTooltip}}"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="CornflowerBlue"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Guid}" FontSize="7" Foreground="{DynamicResource SubtextBrush}"
                                                               TextTrimming="CharacterEllipsis" Opacity="0.7" Margin="13,1,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>

                <!-- ══ Action Popups ══ -->

                <!-- Add Character Popup -->
                <Popup x:Name="PopupAddChar" Placement="Center" StaysOpen="False" AllowsTransparency="True"
                       PlacementTarget="{Binding ElementName=RootGrid}">
                    <Border Background="#F0141008" CornerRadius="8" Padding="14"
                            BorderThickness="1.5" MinWidth="280" MaxWidth="320">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#CC996600" Offset="0"/>
                                <GradientStop Color="#88664400" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.7" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="➕ Nouveau personnage" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource BrightGoldBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="Nom" FontSize="10" Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,2"/>
                            <TextBox FontSize="11" Padding="4,3" Margin="0,0,0,6"
                                     Text="{Binding NewCharName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="55"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" FontSize="11" Height="26"
                                          ItemsSource="{Binding WowClasses}" SelectedItem="{Binding NewCharClass}"/>
                                <TextBox Grid.Column="1" FontSize="11" Padding="4,3" Margin="4,0,0,0"
                                         Text="{Binding NewCharLevel, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" FontSize="11" Height="26" Margin="0,0,2,0"
                                          ItemsSource="{Binding Accounts}" DisplayMemberPath="Name"
                                          SelectedValuePath="Id" SelectedValue="{Binding NewCharAccountId}"/>
                                <ComboBox Grid.Column="1" FontSize="11" Height="26" Margin="2,0,0,0"
                                          ItemsSource="{Binding CharacterStatusValues}"
                                          SelectedItem="{Binding NewCharStatus}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource StatusConv}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Button Content="📍 Placer sur la carte" Style="{DynamicResource StoneButton}" FontSize="11"
                                    Padding="8,5" HorizontalAlignment="Stretch"
                                    Command="{Binding StartPlaceCharacterCommand}" Click="PopupClose_Click"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Add Account Popup -->
                <Popup x:Name="PopupAddAccount" Placement="Center" StaysOpen="False" AllowsTransparency="True"
                       PlacementTarget="{Binding ElementName=RootGrid}">
                    <Border Background="#F0141008" CornerRadius="8" Padding="14"
                            BorderThickness="1.5" MinWidth="250">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#CC996600" Offset="0"/>
                                <GradientStop Color="#88664400" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.7" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="👤 Nouveau compte" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource BrightGoldBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="Nom du compte" FontSize="10" Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,2"/>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Ajouter" Style="{DynamicResource StoneButton}"
                                        FontSize="10" Padding="10,4" Margin="6,0,0,0" Click="PopupAddAccount_Click"/>
                                <TextBox x:Name="PopupNewAccountBox" FontSize="11" Padding="4,3"
                                         KeyDown="PopupNewAccountBox_KeyDown"
                                         Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Accounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,3">
                                            <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource StoneButton}"
                                                    FontSize="10" Padding="4,1" Click="RemoveAccount_Click"/>
                                            <TextBlock Text="{Binding Name}" FontSize="11"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Add Timer Popup -->
                <Popup x:Name="PopupAddTimer" Placement="Center" StaysOpen="False" AllowsTransparency="True"
                       PlacementTarget="{Binding ElementName=RootGrid}">
                    <Border Background="#F0141008" CornerRadius="8" Padding="14"
                            BorderThickness="1.5" MinWidth="250">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#CC996600" Offset="0"/>
                                <GradientStop Color="#88664400" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.7" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="⏱ Nouveau timer" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource BrightGoldBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="Nom du timer" FontSize="10" Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,2"/>
                            <TextBox FontSize="11" Padding="4,3" Margin="0,0,0,6"
                                     Text="{Binding NewTimerLabel, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            <TextBlock Text="Durée" FontSize="10" Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox Width="40" FontSize="11" Padding="3" TextAlignment="Center"
                                         Text="{Binding NewTimerHours, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                <TextBlock Text="h" FontSize="10" Foreground="{DynamicResource SubtextBrush}"
                                           VerticalAlignment="Center" Margin="3,0,8,0"/>
                                <TextBox Width="40" FontSize="11" Padding="3" TextAlignment="Center"
                                         Text="{Binding NewTimerMinutes, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                <TextBlock Text="m" FontSize="10" Foreground="{DynamicResource SubtextBrush}"
                                           VerticalAlignment="Center" Margin="3,0,8,0"/>
                                <TextBox Width="40" FontSize="11" Padding="3" TextAlignment="Center"
                                         Text="{Binding NewTimerSeconds, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                <TextBlock Text="s" FontSize="10" Foreground="{DynamicResource SubtextBrush}"
                                           VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </StackPanel>
                            <Button Content="📍 Placer sur la carte" Style="{DynamicResource StoneButton}" FontSize="11"
                                    Padding="8,5" HorizontalAlignment="Stretch"
                                    Command="{Binding StartPlaceTimerCommand}" Click="PopupClose_Click"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Add Friend Popup -->
                <Popup x:Name="PopupAddFriend" Placement="Center" StaysOpen="False" AllowsTransparency="True"
                       PlacementTarget="{Binding ElementName=RootGrid}">
                    <Border Background="#F0141008" CornerRadius="8" Padding="14"
                            BorderThickness="1.5" MinWidth="280">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#CC996600" Offset="0"/>
                                <GradientStop Color="#88664400" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.7" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🌐 Ajouter un ami" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource BrightGoldBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="Nom" FontSize="10" Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,2"/>
                            <TextBox FontSize="11" Padding="4,3" Margin="0,0,0,6"
                                     Text="{Binding FriendNameInput, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            <TextBlock Text="Identifiant (GUID)" FontSize="10" Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,2"/>
                            <TextBox FontSize="11" Padding="4,3" Margin="0,0,0,8"
                                     Text="{Binding FriendGuidInput, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            <Button Content="Ajouter" Style="{DynamicResource StoneButton}" FontSize="11"
                                    Padding="8,5" HorizontalAlignment="Stretch"
                                    Command="{Binding AddFriendCommand}" Click="PopupClose_Click"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>
    </Grid>
</UserControl>
