<UserControl x:Class="WindowsOrganiserApp.Views.CraftProfessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:WindowsOrganiserApp.Controls"
             xmlns:conv="clr-namespace:WindowsOrganiserApp.Converters"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000"
             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
             FontSize="15">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:HexColorToBrushConverter x:Key="HexToBrush"/>
        <conv:DivideWidthConverter x:Key="DivideWidth"/>
        <Style x:Key="RecipeCardBorder" TargetType="Border">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#24D4A017"/>
            <Setter Property="BorderBrush" Value="#60A08050"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="CraftListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28D4A017"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#60D4A017"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Stretch" Background="{DynamicResource SelectionBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBox Width="260" Height="28" VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Rechercher recette, catégorie ou métier"/>
                <Button Content="✕" Style="{DynamicResource StoneButton}" Margin="6,0,0,0"
                        Command="{Binding ClearSearchCommand}" Padding="8,4" FontSize="11"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="180"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="270" MinWidth="200"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="4" Padding="10"
                    Background="#18D4A017" BorderBrush="#40806030" BorderThickness="1">
                <DockPanel>
                    <ComboBox DockPanel.Dock="Top" Height="34" FontSize="14" Margin="0,0,0,10"
                              ItemsSource="{Binding ContentTypes}"
                              SelectedItem="{Binding SelectedContentType}"
                              Foreground="{DynamicResource TextBrush}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ListBox ItemsSource="{Binding ProfessionNodes}"
                             SelectedItem="{Binding SelectedProfession}"
                             ItemContainerStyle="{StaticResource CraftListItem}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" CornerRadius="4" Padding="8"
                    Background="#18D4A017" BorderBrush="#40806030" BorderThickness="1">
                <ListBox ItemsSource="{Binding CategoryNodes}"
                         SelectedItem="{Binding SelectedCategory}"
                         ItemContainerStyle="{StaticResource CraftListItem}"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock Text="{Binding EntryCount}" DockPanel.Dock="Right"
                                           FontSize="13" Foreground="{DynamicResource SubtextBrush}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="4" CornerRadius="4" Padding="8"
                    Background="#10D4A017" BorderBrush="#40806030" BorderThickness="1">
                <ScrollViewer x:Name="RecipeScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RecipeRows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="{Binding ActualWidth, ElementName=RecipeScroll, Converter={StaticResource DivideWidth}, ConverterParameter=2;20}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RecipeCardBorder}">
                                    <Grid MinHeight="56">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ctrl:WowItemSlot Grid.Column="0" Grid.Row="0"
                                                          DataContext="{Binding IconItem}"
                                                          Width="34" Height="34" Margin="0,0,10,0"
                                                          VerticalAlignment="Top"/>

                                        <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0"
                                                    Margin="0,0,6,0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{Binding NameQualityColor, Converter={StaticResource HexToBrush}}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SkillText}"
                                                       FontSize="11" Margin="0,2,0,0"
                                                       Foreground="#C0A060"/>
                                        </StackPanel>

                                        <Button Grid.Column="3" Grid.Row="0"
                                                Command="{Binding DataContext.AddToFarmListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Ajouter à la liste active"
                                                VerticalAlignment="Top"
                                                Padding="5" MinWidth="32" Height="34"
                                                Content="＋" FontSize="16"
                                                Style="{DynamicResource StoneButton}"
                                                Visibility="{Binding CanAddToList, Converter={StaticResource BoolToVis}}"/>

                                        <ItemsControl Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="1"
                                                      ItemsSource="{Binding Reagents}" Margin="0,4,0,0">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasReagents}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,1,4,1" LastChildFill="True">
                                                        <ctrl:WowItemSlot DockPanel.Dock="Left"
                                                                          DataContext="{Binding Item}"
                                                                          Width="19" Height="19" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding LabelLine}"
                                                                   FontSize="10" VerticalAlignment="Center"
                                                                   Foreground="{Binding NameQualityColor, Converter={StaticResource HexToBrush}}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="1"
                                                      ItemsSource="{Binding BonusDrops}" Margin="0,4,0,0">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasBonusDrops}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,1,4,1" LastChildFill="True">
                                                        <TextBlock DockPanel.Dock="Left" Text="+" FontSize="10"
                                                                   Foreground="#908070" VerticalAlignment="Center"
                                                                   Margin="0,0,3,0"/>
                                                        <ctrl:WowItemSlot DockPanel.Dock="Left"
                                                                          DataContext="{Binding Item}"
                                                                          Width="18" Height="18" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="10" VerticalAlignment="Center"
                                                                   Foreground="{Binding NameQualityColor, Converter={StaticResource HexToBrush}}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,10,0,0" FontSize="13"
                   Foreground="{DynamicResource SubtextBrush}" Text="{Binding StatusText}"/>
    </Grid>
</UserControl>
