<Window x:Class="WindowsOrganiserApp.Views.CraftPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WindowsOrganiserApp.Views"
        Title="Ajouter un craft"
        Height="720" Width="1080"
        MinHeight="520" MinWidth="880"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI">
    <Border CornerRadius="8" Padding="2"
            Background="{DynamicResource SelectionBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource PanelBg2}" CornerRadius="6,6,0,0" Padding="12,10"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource StoneButton}"
                            Padding="10,4" FontSize="12" Click="Close_Click" ToolTip="Fermer"/>
                    <TextBlock Text="Métiers — ajouter à la liste active"
                               FontFamily="Georgia" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrightGoldBrush}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <views:CraftProfessionsView Grid.Row="1" Margin="10,8,10,10"
                                        DataContext="{Binding}"
                                        VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
        </Grid>
    </Border>
</Window>
