<UserControl x:Class="WindowsOrganiserApp.Views.BountyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:WindowsOrganiserApp.Converters"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVis"/>
        <conv:BoolToCompletedLabelConverter x:Key="BoolToCompletedLabel"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <DockPanel>
            <!-- ═══ TOOLBAR ═══ -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBg}" CornerRadius="6"
                    Padding="12,8" Margin="0,0,0,8" BorderThickness="1"
                    BorderBrush="{DynamicResource InnerBorderBrush}">
                <DockPanel>
                    <TextBlock Text="🏴‍☠️ Chasseur de Primes" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource BrightGoldBrush}" VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}"
                            Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="➕ Nouvelle prime" Style="{DynamicResource WowButton}"
                                FontSize="10" Padding="12,5" Margin="0,0,6,0"
                                Command="{Binding NewBountyCommand}"/>
                        <Button Content="📜 Règlement" Style="{DynamicResource WowButton}"
                                FontSize="10" Padding="12,5" Margin="0,0,6,0"
                                Click="ToggleRules_Click"/>
                        <Button Content="📋 Copier tout Discord" Style="{DynamicResource WowButton}"
                                FontSize="10" Padding="12,5"
                                Command="{Binding CopyDiscordMessageCommand}"
                                ToolTip="Copier le message complet (règlement + toutes les primes)"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══ BOUNTY LIST ═══ -->
            <Border Background="{DynamicResource PanelBg}" CornerRadius="6"
                    Padding="12" BorderThickness="1" BorderBrush="{DynamicResource InnerBorderBrush}">
                <DockPanel>
                    <!-- Column headers -->
                    <Grid DockPanel.Dock="Top" Margin="8,0,8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CIBLE" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource SubtextBrush}"/>
                        <TextBlock Grid.Column="1" Text="PRIME" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource SubtextBrush}"/>
                        <TextBlock Grid.Column="2" Text="STATUT" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource SubtextBrush}"/>
                        <TextBlock Grid.Column="3" Text="MOTIF" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource SubtextBrush}"/>
                        <TextBlock Grid.Column="4" Text="COMMANDITAIRES" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource SubtextBrush}"/>
                        <TextBlock Grid.Column="5" Text="ACTIONS" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource SubtextBrush}" HorizontalAlignment="Center"/>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,4"/>

                    <!-- List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Bounties}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,7" Margin="0,0,0,3"
                                            Background="#10FFFFFF" BorderThickness="1" BorderBrush="#15FFFFFF"
                                            Cursor="Hand" MouseLeftButtonDown="BountyRow_MouseDown">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Target name -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="💀" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding TargetName}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Total -->
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayTotal}" FontSize="13"
                                                       FontWeight="Bold" Foreground="{DynamicResource BrightGoldBrush}"
                                                       VerticalAlignment="Center"/>

                                            <!-- Status badge -->
                                            <Border Grid.Column="2" CornerRadius="3" Padding="5,2"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#30FF6B6B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Background" Value="#3080FF80"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="9" FontWeight="Bold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="WANTED"/>
                                                            <Setter Property="Foreground" Value="#FF6B6B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Text" Value="DEAD"/>
                                                                    <Setter Property="Foreground" Value="#80FF80"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Reason (largest column) -->
                                            <TextBlock Grid.Column="3" Text="{Binding Reason}" FontSize="12"
                                                       FontStyle="Italic" Foreground="{DynamicResource SubtextBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Reason}"/>

                                            <!-- Contributors -->
                                            <TextBlock Grid.Column="4" Text="{Binding ContributorNames}" FontSize="11"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- Action buttons -->
                                            <StackPanel Grid.Column="5" Orientation="Horizontal"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="✏️" FontSize="11" Padding="4,1" Margin="1,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="LightSkyBlue" Cursor="Hand"
                                                        ToolTip="Éditer"
                                                        Command="{Binding DataContext.EditBountyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="📋" FontSize="11" Padding="4,1" Margin="1,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="LightSkyBlue" Cursor="Hand"
                                                        ToolTip="Copier message Discord individuel"
                                                        Command="{Binding DataContext.CopyIndividualDiscordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="📷" FontSize="11" Padding="4,1" Margin="1,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{DynamicResource BrightGoldBrush}" Cursor="Hand"
                                                        ToolTip="Copier prompt image"
                                                        Command="{Binding DataContext.CopyImagePromptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="✕" FontSize="11" Padding="4,1" Margin="1,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#FF6B6B" Cursor="Hand"
                                                        ToolTip="Supprimer"
                                                        Command="{Binding DataContext.RemoveBountyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- ═══ EDIT POPUP ═══ -->
        <Popup x:Name="PopupEdit" Placement="Center" PlacementTarget="{Binding ElementName=RootGrid}"
               StaysOpen="True" AllowsTransparency="True"
               IsOpen="{Binding IsPopupOpen}">
            <Border CornerRadius="8" Padding="24" Width="500"
                    Background="{DynamicResource PanelBg}"
                    BorderThickness="2" BorderBrush="{DynamicResource BrightGoldBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Content="✕" FontSize="13"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#FF6B6B" Cursor="Hand" Padding="4,0"
                                Command="{Binding CancelEditCommand}"/>
                        <TextBlock Text="🎯 AVIS DE RECHERCHE" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource BrightGoldBrush}"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Nom :" FontSize="11" Width="90" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtextBrush}"/>
                        <TextBox Text="{Binding EditingBounty.TargetName, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" FontWeight="Bold"
                                 Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                 Padding="4,3"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Alt :" FontSize="11" Width="90" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtextBrush}"/>
                        <TextBox Text="{Binding EditingBounty.AltName, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                 Padding="4,3"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Classe :" FontSize="11" Width="90" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtextBrush}"/>
                        <ComboBox ItemsSource="{Binding WowClasses}"
                                  SelectedItem="{Binding EditingBounty.TargetClass}"
                                  FontSize="11" Width="130" HorizontalAlignment="Left"/>
                        <TextBlock Text="Race :" FontSize="11" Width="50" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtextBrush}" Margin="12,0,0,0"/>
                        <ComboBox ItemsSource="{Binding WowRaces}"
                                  SelectedItem="{Binding EditingBounty.TargetRace}"
                                  FontSize="11" Width="130" HorizontalAlignment="Left"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Motif :" FontSize="11" Width="90" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtextBrush}"/>
                        <TextBox Text="{Binding EditingBounty.Reason, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" FontStyle="Italic" Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                 Padding="4,3"/>
                    </DockPanel>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12"/>

                    <TextBlock Text="💰 COMMANDITAIRES" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource BrightGoldBrush}" Margin="0,0,0,6"/>

                    <ItemsControl ItemsSource="{Binding EditingContributors}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="8,4" Margin="0,0,0,3"
                                        Background="#10FFFFFF" BorderThickness="1" BorderBrush="#15FFFFFF">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" FontSize="9"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="#FF6B6B" Cursor="Hand" Padding="4,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveContributorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" — " Foreground="{DynamicResource SubtextBrush}"/>
                                            <Run Text="{Binding GoldAmount, Mode=OneWay, StringFormat='{}{0}po'}"
                                                 Foreground="{DynamicResource BrightGoldBrush}"/>
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border CornerRadius="4" Padding="10,8" Background="#08AADDFF"
                            BorderThickness="1" BorderBrush="#18AADDFF" Margin="0,0,0,14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Ajouter" Style="{DynamicResource WowButton}"
                                    FontSize="10" Padding="12,4" Margin="8,0,0,0"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding AddContributorCommand}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Commanditaire" FontSize="9" Foreground="{DynamicResource SubtextBrush}"/>
                                    <TextBox Text="{Binding NewContribName, UpdateSourceTrigger=PropertyChanged}"
                                             Width="150" Height="24" FontSize="10" Padding="4,2"
                                             Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                             VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Or (po)" FontSize="9" Foreground="{DynamicResource SubtextBrush}"/>
                                    <TextBox Text="{Binding NewContribGold, UpdateSourceTrigger=PropertyChanged}"
                                             Width="70" Height="24" FontSize="10" Padding="4,2"
                                             Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                             VerticalContentAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="💾 Sauvegarder" Style="{DynamicResource WowButton}"
                                FontSize="11" Padding="20,7" Margin="0,0,8,0"
                                Command="{Binding SaveBountyCommand}"/>
                        <Button Content="Annuler" Style="{DynamicResource WowButton}"
                                FontSize="11" Padding="16,7"
                                Command="{Binding CancelEditCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ═══ RULES POPUP ═══ -->
        <Popup x:Name="PopupRules" Placement="Center" PlacementTarget="{Binding ElementName=RootGrid}"
               StaysOpen="True" AllowsTransparency="True">
            <Border CornerRadius="8" Padding="20" Width="500"
                    Background="{DynamicResource PanelBg}"
                    BorderThickness="2" BorderBrush="{DynamicResource BrightGoldBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="✕" FontSize="12"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#FF6B6B" Cursor="Hand" Padding="4,0"
                                Click="CloseRules_Click"/>
                        <TextBlock Text="📜 Règlement" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource BrightGoldBrush}"/>
                    </DockPanel>
                    <TextBox Text="{Binding Rules, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             MinHeight="200" MaxHeight="400" FontSize="11"
                             Background="Transparent" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                             Padding="8" VerticalScrollBarVisibility="Auto"/>
                    <Button Content="Enregistrer" Style="{DynamicResource WowButton}"
                            FontSize="11" Padding="20,6" Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Click="CloseRules_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
