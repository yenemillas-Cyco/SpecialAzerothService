<UserControl x:Class="WindowsOrganiserApp.Views.BountyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:WindowsOrganiserApp.Converters"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVis"/>
        <conv:BoolToCompletedLabelConverter x:Key="BoolToCompletedLabel"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT PANEL: Bounty list ═══ -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBg}" CornerRadius="6"
                Padding="10" BorderThickness="1" BorderBrush="{DynamicResource InnerBorderBrush}">
            <DockPanel>
                <!-- Header + actions -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="🏴‍☠️ Chasseur de Primes" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource BrightGoldBrush}" HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <Border Height="1" Background="{DynamicResource GoldSepBrush}" Margin="0,0,0,8"/>
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Content="➕ Nouvelle prime" Style="{DynamicResource WowButton}"
                                FontSize="10" Padding="10,5" Margin="2"
                                Command="{Binding AddBountyCommand}"/>
                        <Button Content="📜 Règlement" Style="{DynamicResource WowButton}"
                                FontSize="10" Padding="10,5" Margin="2"
                                Click="ToggleRules_Click"/>
                        <Button Content="📋 Discord" Style="{DynamicResource WowButton}"
                                FontSize="10" Padding="10,5" Margin="2"
                                Command="{Binding CopyDiscordMessageCommand}"
                                ToolTip="Copier le message complet pour Discord"/>
                    </WrapPanel>
                </StackPanel>

                <!-- Bounty list -->
                <ListBox ItemsSource="{Binding Bounties}" SelectedItem="{Binding SelectedBounty}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="5" Padding="10,8"
                                                BorderThickness="1" Cursor="Hand"
                                                Background="#18182838" BorderBrush="#33AADDFF">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrightGoldBrush}"/>
                                                <Setter TargetName="Bd" Property="Background" Value="#28FFD700"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#20FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="✕" FontSize="10"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#FF6B6B" Cursor="Hand" Padding="4,0"
                                        VerticalAlignment="Top"
                                        Command="{Binding DataContext.RemoveBountyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource BrightGoldBrush}"/>
                                                    <Setter Property="Text" Value="{Binding DisplayTotal}"/>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💀" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding TargetName}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,3,0,0">
                                        <Border DockPanel.Dock="Left" CornerRadius="3" Padding="5,1" Margin="0,0,6,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#30FF6B6B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Background" Value="#3080FF80"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="ACTIVE"/>
                                                        <Setter Property="Foreground" Value="#FF6B6B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Text" Value="ÉLIMINÉ"/>
                                                                <Setter Property="Foreground" Value="#80FF80"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding Reason}" FontSize="9" FontStyle="Italic"
                                                   Foreground="{DynamicResource SubtextBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ═══ RIGHT PANEL: Bounty editor ═══ -->
        <Border Grid.Column="2" Background="{DynamicResource PanelBg}" CornerRadius="6"
                Padding="16" BorderThickness="1" BorderBrush="{DynamicResource InnerBorderBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- Empty state -->
                <Grid>
                    <TextBlock Text="Sélectionnez ou créez une prime" FontSize="14"
                               Foreground="{DynamicResource SubtextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SelectedBounty, Converter={StaticResource NullToVis}}"/>

                    <StackPanel Visibility="{Binding SelectedBounty, Converter={StaticResource NotNullToVis}}">
                        <!-- Target header -->
                        <Border CornerRadius="6" Padding="16,12" Margin="0,0,0,12"
                                BorderThickness="1" BorderBrush="#40FFD700">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#15FFD700" Offset="0"/>
                                    <GradientStop Color="#08FFD700" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock Text="🎯  C I B L E" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource BrightGoldBrush}" Margin="0,0,0,8"/>

                                <!-- Target name -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Nom :" FontSize="11" Width="80" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SubtextBrush}"/>
                                    <TextBox Text="{Binding SelectedBounty.TargetName, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="13" FontWeight="Bold"
                                             Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                             Padding="4,3" LostFocus="BountyField_Changed"/>
                                </DockPanel>

                                <!-- Alt name -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Alt :" FontSize="11" Width="80" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SubtextBrush}"/>
                                    <TextBox Text="{Binding SelectedBounty.AltName, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="11" Background="Transparent"
                                             Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                             Padding="4,3" LostFocus="BountyField_Changed"/>
                                </DockPanel>

                                <!-- Class + Race -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Classe :" FontSize="11" Width="80" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SubtextBrush}"/>
                                    <ComboBox ItemsSource="{Binding DataContext.WowClasses, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              Text="{Binding SelectedBounty.TargetClass, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True" FontSize="11" Width="130"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="BountyCombo_Changed"/>
                                    <TextBlock Text="Race :" FontSize="11" Width="50" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SubtextBrush}" Margin="12,0,0,0"/>
                                    <ComboBox ItemsSource="{Binding DataContext.WowRaces, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              Text="{Binding SelectedBounty.TargetRace, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True" FontSize="11" Width="130"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="BountyCombo_Changed"/>
                                </DockPanel>

                                <!-- Reason -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Motif :" FontSize="11" Width="80" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SubtextBrush}"/>
                                    <TextBox Text="{Binding SelectedBounty.Reason, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="11" FontStyle="Italic" Background="Transparent"
                                             Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                             Padding="4,3" LostFocus="BountyField_Changed"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Total -->
                        <Border CornerRadius="5" Padding="12,8" Margin="0,0,0,12"
                                Background="#15FFD700" BorderThickness="1" BorderBrush="#30FFD700">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="💰 PRIME TOTALE" FontSize="11"
                                           FontWeight="Bold" Foreground="{DynamicResource BrightGoldBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedBounty.DisplayTotal}" FontSize="16"
                                           FontWeight="Bold" Foreground="{DynamicResource BrightGoldBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- Contributors list -->
                        <TextBlock Text="👥 CONTRIBUTEURS" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource BrightGoldBrush}" Margin="0,0,0,6"/>

                        <ItemsControl ItemsSource="{Binding SelectedContributors}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="10,6" Margin="0,0,0,4"
                                            Background="#12FFFFFF" BorderThickness="1" BorderBrush="#20FFFFFF">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="✕" FontSize="9"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="#FF6B6B" Cursor="Hand" Padding="4,0"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RemoveContributorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,0,0">
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource BrightGoldBrush}"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0}po / {1} bijoux">
                                                                    <Binding Path="GoldAmount"/>
                                                                    <Binding Path="JewelAmount"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Reason}" FontSize="9" FontStyle="Italic"
                                                           Foreground="{DynamicResource SubtextBrush}" Margin="0,2,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add contributor form -->
                        <Border CornerRadius="5" Padding="12,10" Margin="0,0,0,12"
                                Background="#10AADDFF" BorderThickness="1" BorderBrush="#25AADDFF">
                            <StackPanel>
                                <TextBlock Text="➕ Ajouter un contributeur" FontSize="10" FontWeight="SemiBold"
                                           Foreground="LightSkyBlue" Margin="0,0,0,8"/>
                                <WrapPanel Margin="0,0,0,6">
                                    <StackPanel Margin="0,0,10,4">
                                        <TextBlock Text="Nom" FontSize="9" Foreground="{DynamicResource SubtextBrush}"/>
                                        <TextBox Text="{Binding NewContribName, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="120" Height="24" FontSize="10" Padding="4,2"
                                                 Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                                 VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,4">
                                        <TextBlock Text="Or (po)" FontSize="9" Foreground="{DynamicResource SubtextBrush}"/>
                                        <TextBox Text="{Binding NewContribGold, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="60" Height="24" FontSize="10" Padding="4,2"
                                                 Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                                 VerticalContentAlignment="Center" TextAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,4">
                                        <TextBlock Text="Bijoux" FontSize="9" Foreground="{DynamicResource SubtextBrush}"/>
                                        <TextBox Text="{Binding NewContribJewels, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="60" Height="24" FontSize="10" Padding="4,2"
                                                 Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                                 VerticalContentAlignment="Center" TextAlignment="Center"/>
                                    </StackPanel>
                                </WrapPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Ajouter" Style="{DynamicResource WowButton}"
                                            FontSize="10" Padding="12,4"
                                            Command="{Binding AddContributorCommand}"/>
                                    <TextBox Text="{Binding NewContribReason, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="10" Padding="4,2" Height="24"
                                             Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                             VerticalContentAlignment="Center" Margin="0,0,8,0">
                                        <TextBox.Tag>
                                            <TextBlock Text="Raison..." Foreground="{DynamicResource SubtextBrush}" FontStyle="Italic"/>
                                        </TextBox.Tag>
                                    </TextBox>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Killed by (if completed) -->
                        <Border CornerRadius="5" Padding="12,8" Margin="0,0,0,12"
                                Background="#15FF6B6B" BorderThickness="1" BorderBrush="#30FF6B6B">
                            <DockPanel>
                                <TextBlock Text="⚔️ Tué par :" FontSize="11" VerticalAlignment="Center"
                                           Foreground="#FF6B6B" Width="80"/>
                                <TextBox Text="{Binding SelectedBounty.KilledBy, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="11" Background="Transparent"
                                         Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                         Padding="4,3" LostFocus="BountyField_Changed"/>
                            </DockPanel>
                        </Border>

                        <!-- Action buttons -->
                        <WrapPanel HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button Content="{Binding SelectedBounty.IsCompleted, Converter={StaticResource BoolToCompletedLabel}}"
                                    Style="{DynamicResource WowButton}"
                                    FontSize="11" Padding="14,6" Margin="4"
                                    Command="{Binding MarkCompletedCommand}"/>
                            <Button Content="📷 Prompt image" Style="{DynamicResource WowButton}"
                                    FontSize="11" Padding="14,6" Margin="4"
                                    Command="{Binding CopyImagePromptCommand}"
                                    ToolTip="Copier un prompt pour générer l'affiche"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ═══ RULES POPUP ═══ -->
        <Popup x:Name="PopupRules" Placement="Center" PlacementTarget="{Binding ElementName=RootGrid}"
               StaysOpen="True" AllowsTransparency="True">
            <Border CornerRadius="8" Padding="20" Width="500"
                    Background="{DynamicResource PanelBg}"
                    BorderThickness="2" BorderBrush="{DynamicResource BrightGoldBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="✕" FontSize="12"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#FF6B6B" Cursor="Hand" Padding="4,0"
                                Click="CloseRules_Click"/>
                        <TextBlock Text="📜 Règlement" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource BrightGoldBrush}"/>
                    </DockPanel>
                    <TextBox Text="{Binding Rules, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             MinHeight="200" MaxHeight="400" FontSize="11"
                             Background="Transparent" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                             Padding="8" VerticalScrollBarVisibility="Auto"/>
                    <Button Content="Enregistrer" Style="{DynamicResource WowButton}"
                            FontSize="11" Padding="20,6" Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Command="{Binding SaveRulesCommand}"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
