<UserControl x:Class="WindowsOrganiserApp.Views.BountyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:WindowsOrganiserApp.Converters"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVis"/>
        <conv:BoolToCompletedLabelConverter x:Key="BoolToCompletedLabel"/>
        <conv:BountyClassColorConverter x:Key="ClassColorConv"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Row style: transparent background + class-colored left border -->
        <Style x:Key="BountyRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#18FFFFFF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cell style: remove focus highlight -->
        <Style x:Key="BountyCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Column header style -->
        <Style x:Key="BountyHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#15FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <Path x:Name="SortArrow" DockPanel.Dock="Right"
                                          Fill="{DynamicResource SubtextBrush}"
                                          Margin="4,0,0,0" VerticalAlignment="Center"
                                          Visibility="Collapsed"/>
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </DockPanel>
                            </Border>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                                   Width="4" Cursor="SizeWE"
                                   Style="{x:Null}">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent" Width="4"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0,5 L 4,0 L 8,5 Z"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0,0 L 4,5 L 8,0 Z"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <DockPanel>
            <!-- ═══ TOOLBAR ═══ -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBg}" CornerRadius="6"
                    Padding="12,8" Margin="0,0,0,8" BorderThickness="1"
                    BorderBrush="{DynamicResource InnerBorderBrush}">
                <DockPanel>
                    <TextBlock Text="🏴‍☠️ Chasseur de Primes" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource BrightGoldBrush}" VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}"
                            Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📥 Import" Style="{DynamicResource WowButton}"
                                FontSize="10" Padding="10,5" Margin="0,0,4,0"
                                Command="{Binding ImportBountiesCommand}"
                                ToolTip="Importer des primes depuis un fichier"/>
                        <Button Content="📤 Export" Style="{DynamicResource WowButton}"
                                FontSize="10" Padding="10,5"
                                Command="{Binding ExportBountiesCommand}"
                                ToolTip="Exporter les primes vers un fichier"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="➕ Nouvelle prime" Style="{DynamicResource WowButton}"
                                FontSize="10" Padding="12,5" Margin="0,0,6,0"
                                Command="{Binding NewBountyCommand}"/>
                        <Button Content="📜 Règlement" Style="{DynamicResource WowButton}"
                                FontSize="10" Padding="12,5" Margin="0,0,6,0"
                                Click="ToggleRules_Click"/>
                        <Button Content="📋 Copier règlement" Style="{DynamicResource WowButton}"
                                FontSize="10" Padding="10,5" Margin="0,0,4,0"
                                Command="{Binding CopyDiscordRulesCommand}"
                                ToolTip="Copier le règlement pour Discord"/>
                        <Button Content="📋 Copier primes" Style="{DynamicResource WowButton}"
                                FontSize="10" Padding="10,5"
                                Command="{Binding CopyDiscordBountiesCommand}"
                                ToolTip="Copier la liste des primes pour Discord"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══ BOUNTY DATAGRID ═══ -->
            <Border Background="{DynamicResource PanelBg}" CornerRadius="6"
                    Padding="4" BorderThickness="1" BorderBrush="{DynamicResource InnerBorderBrush}">
                <Grid>
                    <TextBlock Text="{Binding DiscordCharCount}" FontSize="10"
                               Foreground="{Binding DiscordCharBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,4,10,0" Panel.ZIndex="1"
                               ToolTip="Nombre de caractères du message Discord (limite 2000)"/>
                <DataGrid x:Name="BountyGrid"
                          ItemsSource="{Binding Bounties}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          CanUserReorderColumns="True"
                          CanUserResizeRows="False"
                          SelectionMode="Single"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="Transparent"
                          HorizontalGridLinesBrush="Transparent"
                          VerticalGridLinesBrush="Transparent"
                          RowStyle="{StaticResource BountyRowStyle}"
                          CellStyle="{StaticResource BountyCellStyle}"
                          ColumnHeaderStyle="{StaticResource BountyHeaderStyle}"
                          MouseDoubleClick="BountyGrid_MouseDoubleClick">

                    <DataGrid.Columns>
                        <!-- CIBLE -->
                        <DataGridTemplateColumn Header="CIBLE" Width="140" MinWidth="80"
                                                SortMemberPath="TargetName" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="💀" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding TargetName}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{Binding TargetClass, Converter={StaticResource ClassColorConv}}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- PRIME -->
                        <DataGridTemplateColumn Header="PRIME" Width="80" MinWidth="60"
                                                SortMemberPath="TotalGold" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayTotal}" FontSize="13"
                                               FontWeight="Bold" Foreground="{DynamicResource BrightGoldBrush}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- CLASSE -->
                        <DataGridTemplateColumn Header="CLASSE" Width="90" MinWidth="60"
                                                SortMemberPath="TargetClass" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TargetClass}" FontSize="11"
                                               Foreground="{Binding TargetClass, Converter={StaticResource ClassColorConv}}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- RACE -->
                        <DataGridTemplateColumn Header="RACE" Width="90" MinWidth="60"
                                                SortMemberPath="TargetRace" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TargetRace}" FontSize="11"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource SubtextBrush}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- MOTIF -->
                        <DataGridTemplateColumn Header="MOTIF" Width="*" MinWidth="100"
                                                SortMemberPath="Reason" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Reason}" FontSize="12"
                                               FontStyle="Italic" Foreground="{DynamicResource SubtextBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Reason}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- COMMANDITAIRES -->
                        <DataGridTemplateColumn Header="COMMANDITAIRES" Width="140" MinWidth="80"
                                                SortMemberPath="ContributorNames" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ContributorNames}" FontSize="11"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ContributorNames}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ACTIONS -->
                        <DataGridTemplateColumn Header="ACTIONS" Width="130" MinWidth="100"
                                                CanUserSort="False" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="Édit" FontSize="9" Padding="5,2" Margin="1,0"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="LightSkyBlue" Cursor="Hand"
                                                ToolTip="Modifier la prime"
                                                Command="{Binding DataContext.EditBountyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Msg" FontSize="9" Padding="5,2" Margin="1,0"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="MediumAquamarine" Cursor="Hand"
                                                ToolTip="Copier la ligne Discord de cette prime"
                                                Command="{Binding DataContext.CopyIndividualDiscordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Img" FontSize="9" Padding="5,2" Margin="1,0"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource BrightGoldBrush}" Cursor="Hand"
                                                ToolTip="Copier le prompt ChatGPT pour l'affiche"
                                                Command="{Binding DataContext.CopyImagePromptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="✕" FontSize="10" Padding="5,2" Margin="1,0"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="#FF6B6B" Cursor="Hand"
                                                ToolTip="Supprimer"
                                                Command="{Binding DataContext.RemoveBountyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </Grid>
            </Border>
        </DockPanel>

        <!-- ═══ EDIT POPUP ═══ -->
        <Popup x:Name="PopupEdit" Placement="Center" PlacementTarget="{Binding ElementName=RootGrid}"
               StaysOpen="True" AllowsTransparency="True"
               IsOpen="{Binding IsPopupOpen}">
            <Border CornerRadius="8" Padding="24" Width="500"
                    Background="{DynamicResource PanelBg}"
                    BorderThickness="2" BorderBrush="{DynamicResource BrightGoldBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Content="✕" FontSize="13"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#FF6B6B" Cursor="Hand" Padding="4,0"
                                Command="{Binding CancelEditCommand}"/>
                        <TextBlock Text="🎯 AVIS DE RECHERCHE" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource BrightGoldBrush}"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Nom :" FontSize="11" Width="90" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtextBrush}"/>
                        <TextBox Text="{Binding EditingBounty.TargetName, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" FontWeight="Bold"
                                 Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                 Padding="4,3"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Alt :" FontSize="11" Width="90" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtextBrush}"/>
                        <TextBox Text="{Binding EditingBounty.AltName, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                 Padding="4,3"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Classe :" FontSize="11" Width="90" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtextBrush}"/>
                        <ComboBox ItemsSource="{Binding WowClasses}"
                                  SelectedItem="{Binding EditingBounty.TargetClass}"
                                  FontSize="11" Width="130" HorizontalAlignment="Left"/>
                        <TextBlock Text="Race :" FontSize="11" Width="50" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtextBrush}" Margin="12,0,0,0"/>
                        <ComboBox ItemsSource="{Binding WowRaces}"
                                  SelectedItem="{Binding EditingBounty.TargetRace}"
                                  FontSize="11" Width="130" HorizontalAlignment="Left"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Motif :" FontSize="11" Width="90" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtextBrush}"/>
                        <TextBox Text="{Binding EditingBounty.Reason, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" FontStyle="Italic" Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                 Padding="4,3"/>
                    </DockPanel>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12"/>

                    <TextBlock Text="💰 COMMANDITAIRES" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource BrightGoldBrush}" Margin="0,0,0,6"/>

                    <ItemsControl ItemsSource="{Binding EditingContributors}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="8,4" Margin="0,0,0,3"
                                        Background="#10FFFFFF" BorderThickness="1" BorderBrush="#15FFFFFF">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" FontSize="9"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="#FF6B6B" Cursor="Hand" Padding="4,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveContributorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" — " Foreground="{DynamicResource SubtextBrush}"/>
                                            <Run Text="{Binding GoldAmount, Mode=OneWay, StringFormat='{}{0}po'}"
                                                 Foreground="{DynamicResource BrightGoldBrush}"/>
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border CornerRadius="4" Padding="10,8" Background="#08AADDFF"
                            BorderThickness="1" BorderBrush="#18AADDFF" Margin="0,0,0,14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Ajouter" Style="{DynamicResource WowButton}"
                                    FontSize="10" Padding="12,4" Margin="8,0,0,0"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding AddContributorCommand}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Commanditaire" FontSize="9" Foreground="{DynamicResource SubtextBrush}"/>
                                    <TextBox Text="{Binding NewContribName, UpdateSourceTrigger=PropertyChanged}"
                                             Width="150" Height="24" FontSize="10" Padding="4,2"
                                             Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                             VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Or (po)" FontSize="9" Foreground="{DynamicResource SubtextBrush}"/>
                                    <TextBox Text="{Binding NewContribGold, UpdateSourceTrigger=PropertyChanged}"
                                             Width="70" Height="24" FontSize="10" Padding="4,2"
                                             Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                             VerticalContentAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="💾 Sauvegarder" Style="{DynamicResource WowButton}"
                                FontSize="11" Padding="20,7" Margin="0,0,8,0"
                                Command="{Binding SaveBountyCommand}"/>
                        <Button Content="Annuler" Style="{DynamicResource WowButton}"
                                FontSize="11" Padding="16,7"
                                Command="{Binding CancelEditCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ═══ RULES POPUP ═══ -->
        <Popup x:Name="PopupRules" Placement="Center" PlacementTarget="{Binding ElementName=RootGrid}"
               StaysOpen="True" AllowsTransparency="True">
            <Border CornerRadius="8" Padding="20" Width="500"
                    Background="{DynamicResource PanelBg}"
                    BorderThickness="2" BorderBrush="{DynamicResource BrightGoldBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="✕" FontSize="12"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#FF6B6B" Cursor="Hand" Padding="4,0"
                                Click="CloseRules_Click"/>
                        <TextBlock Text="📜 Règlement" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource BrightGoldBrush}"/>
                    </DockPanel>
                    <TextBox Text="{Binding Rules, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             MinHeight="200" MaxHeight="400" FontSize="11"
                             Background="Transparent" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                             Padding="8" VerticalScrollBarVisibility="Auto"/>
                    <Button Content="Enregistrer" Style="{DynamicResource WowButton}"
                            FontSize="11" Padding="20,6" Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Click="CloseRules_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
