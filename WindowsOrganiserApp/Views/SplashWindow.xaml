<Window x:Class="WindowsOrganiserApp.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Special Azeroth Service"
        Width="480" Height="220"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="Transparent"
        AllowsTransparency="True">
    <Border CornerRadius="10" Padding="2"
            BorderBrush="{DynamicResource BrightGoldBrush}" BorderThickness="1.5"
            Background="{DynamicResource PanelBg}">
        <Border CornerRadius="8" Background="{DynamicResource WindowBgBrush}" Padding="28,24">
            <StackPanel>
                <TextBlock Text="Special Azeroth Service" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource BrightGoldBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Chargement…" FontSize="11" Margin="0,4,0,16"
                           Foreground="{DynamicResource SubtextBrush}" HorizontalAlignment="Center"/>
                <ProgressBar x:Name="LoadProgressBar" Height="14" Minimum="0" Maximum="100"
                             Foreground="{DynamicResource BrightGoldBrush}"
                             Background="{DynamicResource PanelBg2}"/>
                <TextBlock x:Name="StatusText" Text="Démarrage…" FontSize="11" Margin="0,10,0,0"
                           Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center" MinHeight="32"/>
            </StackPanel>
        </Border>
    </Border>
</Window>
