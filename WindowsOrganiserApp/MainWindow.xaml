<Window x:Class="WindowsOrganiserApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WindowsOrganiserApp.ViewModels"
        xmlns:conv="clr-namespace:WindowsOrganiserApp.Converters"
        mc:Ignorable="d"
        Title="Special Azeroth Service — Multibox Organiser"
        Height="700" Width="900"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Foreground="#E8D5A3"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:BoolToMainLabelConverter x:Key="MainLabelConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- WoW Classic Color Palette -->
        <SolidColorBrush x:Key="GoldBrush" Color="#C9A44A"/>
        <SolidColorBrush x:Key="BrightGoldBrush" Color="#FFD100"/>
        <SolidColorBrush x:Key="PanelBg" Color="#CC0E0E1A"/>
        <SolidColorBrush x:Key="PanelBg2" Color="#DD151525"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#886B5A33"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8D5A3"/>
        <SolidColorBrush x:Key="SubtextBrush" Color="#9B8B6E"/>
        <SolidColorBrush x:Key="EpicBrush" Color="#A335EE"/>

        <!-- WoW Red Button (Connexion style) -->
        <Style x:Key="WowButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFD100"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                BorderThickness="2" BorderBrush="#8B6914">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#8B1A1A" Offset="0"/>
                                    <GradientStop Color="#5C0E0E" Offset="0.5"/>
                                    <GradientStop Color="#3D0808" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFD100"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#A52222" Offset="0"/>
                                            <GradientStop Color="#7A1414" Offset="0.5"/>
                                            <GradientStop Color="#5C0E0E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#4A0A0A" Offset="0"/>
                                            <GradientStop Color="#3D0808" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary stone button -->
        <Style x:Key="StoneButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="3" Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="#6B5A33">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#2A2535" Offset="0"/>
                                    <GradientStop Color="#1A1525" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab pill WoW style -->
        <Style x:Key="WowPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="3" Padding="16,7"
                                BorderThickness="1" BorderBrush="#443D2A">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#1E1A28" Offset="0"/>
                                    <GradientStop Color="#141020" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrightGoldBrush}"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#2E2840" Offset="0"/>
                                            <GradientStop Color="#1E1830" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6B5A33"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Window control buttons (close, minimize) -->
        <Style x:Key="WinCtrlBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33C9A44A"/>
                                <Setter Property="Foreground" Value="{StaticResource BrightGoldBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinCtrlBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3"
                                Width="32" Height="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CC8B1A1A"/>
                                <Setter Property="Foreground" Value="#FFD100"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Background image + overlay -->
    <Border CornerRadius="6" ClipToBounds="True">
        <Border.Background>
            <RadialGradientBrush Center="0.5,0.3" RadiusX="0.8" RadiusY="0.9">
                <GradientStop Color="#2A1F14" Offset="0"/>
                <GradientStop Color="#1A1208" Offset="0.5"/>
                <GradientStop Color="#0D0A06" Offset="1"/>
            </RadialGradientBrush>
        </Border.Background>

        <Grid>
            <Border Background="#BB080810" CornerRadius="6"/>

            <!-- Cadre doré extérieur -->
            <Border BorderThickness="3" CornerRadius="6"
                    BorderBrush="{StaticResource GoldBrush}">
                <!-- Cadre intérieur fin -->
                <Border BorderThickness="1" CornerRadius="4" Margin="2"
                        BorderBrush="#443D2A">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Custom title bar (draggable) -->
                        <Border Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="Arrow">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#22C9A44A" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <DockPanel Margin="12,6,6,2">
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                           Text="Special Azeroth Service" FontSize="11"
                                           Foreground="{StaticResource SubtextBrush}"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="—" Style="{StaticResource WinCtrlBtn}"
                                            Click="Minimize_Click"/>
                                    <Button Content="✕" Style="{StaticResource WinCloseBtn}"
                                            Click="Close_Click" Margin="2,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- App content -->
                        <Grid Grid.Row="1" Margin="16,4,16,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: Logo + Guild name + Player -->
                    <Grid Grid.Row="0" Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="Assets/wow_logo.png" Height="42"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFD100" Offset="0"/>
                                    <GradientStop Color="#FF8C00" Offset="0.5"/>
                                    <GradientStop Color="#FFD100" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            <Run Text="&lt;Special Azeroth Service&gt;"/>
                        </TextBlock>
                        <Button Grid.Column="2" Content="?" FontSize="11" Padding="6,2"
                                Style="{StaticResource StoneButton}" Click="About_Click"
                                VerticalAlignment="Center" ToolTip="À propos"/>
                    </Grid>

                    <!-- Gold separator -->
                    <Border Grid.Row="1" Height="2" Margin="30,4,30,8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#6B5A33" Offset="0.2"/>
                                <GradientStop Color="#C9A44A" Offset="0.5"/>
                                <GradientStop Color="#6B5A33" Offset="0.8"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Line 1: Mode + options -->
                    <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton Content="Principal" Style="{StaticResource WowPill}"
                                     IsChecked="{Binding IsMainMode}" GroupName="Mode"/>
                        <RadioButton Content="Fractionné" Style="{StaticResource WowPill}"
                                     IsChecked="{Binding IsSplitMode}" GroupName="Mode"/>

                        <!-- Split orientation (visible only in split mode) -->
                        <Border Width="2" Margin="10,4" Background="#443D2A"
                                Visibility="{Binding IsSplitMode, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsSplitMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Orientation :" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource SubtextBrush}" Margin="0,0,8,0"/>
                            <RadioButton Content="▥ Côte à côte" Style="{StaticResource WowPill}"
                                         IsChecked="{Binding IsSplitHorizontal}" GroupName="SplitDir"/>
                            <RadioButton Content="▤ Empilé" Style="{StaticResource WowPill}"
                                         IsChecked="{Binding IsSplitVertical}" GroupName="SplitDir"/>
                        </StackPanel>

                        <Border Width="2" Margin="10,4" Background="#443D2A"
                                Visibility="{Binding IsMainMode, Converter={StaticResource BoolToVis}}"/>

                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsMainMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Zones :" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource SubtextBrush}" Margin="0,0,8,0"/>
                            <CheckBox Content="▐ Latéral" IsChecked="{Binding HasLateral}"
                                      Foreground="{StaticResource GoldBrush}" FontSize="12"
                                      VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox Content="▬ Bandeau" IsChecked="{Binding HasBandeau}"
                                      Foreground="{StaticResource GoldBrush}" FontSize="12"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Width="2" Margin="10,4" Background="#443D2A"
                                Visibility="{Binding IsMainMode, Converter={StaticResource BoolToVis}}"/>

                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsMainMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Taille :" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource SubtextBrush}" Margin="0,0,8,0"/>
                            <RadioButton Content="Grand" Style="{StaticResource WowPill}"
                                         IsChecked="{Binding IsSizeGrand}" GroupName="Size"/>
                            <RadioButton Content="Moyen" Style="{StaticResource WowPill}"
                                         IsChecked="{Binding IsSizeMoyen}" GroupName="Size"/>
                            <RadioButton Content="Petit" Style="{StaticResource WowPill}"
                                         IsChecked="{Binding IsSizePetit}" GroupName="Size"/>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Line 2: Position + Monitor + Refresh -->
                    <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsMainMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Position :" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource SubtextBrush}" Margin="0,0,8,0"/>
                            <RadioButton Content="&#x2196; HG" Style="{StaticResource WowPill}"
                                         IsChecked="{Binding IsPosTopLeft}" GroupName="Pos"/>
                            <RadioButton Content="&#x2197; HD" Style="{StaticResource WowPill}"
                                         IsChecked="{Binding IsPosTopRight}" GroupName="Pos"/>
                            <RadioButton Content="&#x2198; BD" Style="{StaticResource WowPill}"
                                         IsChecked="{Binding IsPosBottomRight}" GroupName="Pos"/>
                            <RadioButton Content="&#x2199; BG" Style="{StaticResource WowPill}"
                                         IsChecked="{Binding IsPosBottomLeft}" GroupName="Pos"/>
                        </StackPanel>

                        <Border Width="2" Margin="10,4" Background="#443D2A"
                                Visibility="{Binding IsMainMode, Converter={StaticResource BoolToVis}}"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Écran :" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource SubtextBrush}" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding Monitors}"
                                      SelectedItem="{Binding SelectedMonitor}"
                                      DisplayMemberPath="DisplayLabel"
                                      MinWidth="100" FontSize="11"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Content="Rafraîchir" Style="{StaticResource StoneButton}"
                                Command="{Binding RefreshWindowsCommand}" Margin="16,0,0,0"/>
                    </WrapPanel>

                    <!-- Main content -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="500"/>
                        </Grid.ColumnDefinitions>

                        <!-- Window list panel -->
                        <Border Grid.Column="0" Background="{StaticResource PanelBg}" CornerRadius="6"
                                Padding="12" BorderThickness="1.5" BorderBrush="#6B5A33">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="Fenêtres du groupe" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrightGoldBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Tout" Style="{StaticResource StoneButton}"
                                                Command="{Binding SelectAllCommand}" FontSize="10" Padding="6,2"
                                                ToolTip="Tout cocher"/>
                                        <Button Content="Aucun" Style="{StaticResource StoneButton}"
                                                Command="{Binding DeselectAllCommand}" FontSize="10" Padding="6,2"
                                                Margin="4,0,0,0" ToolTip="Tout décocher"/>
                                    </StackPanel>
                                </DockPanel>

                                <ListBox x:Name="WindowListBox"
                                         ItemsSource="{Binding AvailableWindows}"
                                         AllowDrop="True" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonDown="WindowList_PreviewMouseDown"
                                         PreviewMouseMove="WindowList_PreviewMouseMove"
                                         Drop="WindowList_Drop"
                                         DragOver="WindowList_DragOver"
                                         DragLeave="WindowList_DragLeave">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource PanelBg2}" CornerRadius="4"
                                                    Padding="10,8" Margin="0,0,0,3"
                                                    BorderThickness="1" BorderBrush="#443D2A"
                                                    Cursor="Hand" ToolTip="Glisser pour réordonner">
    <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="☰" FontSize="14"
                                                               Foreground="{StaticResource SubtextBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                                               ToolTip="Glisser pour réordonner" Cursor="SizeAll"/>

                                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}"
                                                              VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <Grid>
                                                            <TextBlock FontSize="12" Foreground="{StaticResource BrightGoldBrush}"
                                                                       Text="{Binding DisplayName, Mode=OneWay}"
                                                                       VerticalAlignment="Center" Cursor="Hand"
                                                                       ToolTip="Cliquer pour renommer"
                                                                       MouseLeftButtonDown="DisplayName_DoubleClick"
                                                                       x:Name="NameLabel"/>
                                                            <TextBox FontSize="12" Padding="0" MinWidth="80"
                                                                     Visibility="Collapsed"
                                                                     Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="#1A1208" Foreground="{StaticResource GoldBrush}"
                                                                     BorderBrush="#6B5A33" BorderThickness="1"
                                                                     LostFocus="RenameBox_LostFocus"
                                                                     KeyDown="RenameBox_KeyDown"/>
                                                        </Grid>
                                                        <TextBlock FontSize="10" Foreground="{StaticResource SubtextBrush}"
                                                                   Text="{Binding ProcessName, Mode=OneWay}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0">
                                                        <Button Content="▲" FontSize="10" Padding="4,1" MinWidth="0"
                                                                Style="{StaticResource StoneButton}"
                                                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" ToolTip="Monter"/>
                                                        <Button Content="▼" FontSize="10" Padding="4,1" MinWidth="0"
                                                                Style="{StaticResource StoneButton}" Margin="2,0,0,0"
                                                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" ToolTip="Descendre"/>
                                                    </StackPanel>

                                                    <ComboBox Grid.Column="4"
                                                             ItemsSource="{Binding DataContext.Monitors, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             SelectedItem="{Binding AssignedMonitor}"
                                                             DisplayMemberPath="DisplayLabel"
                                                             FontSize="10" MinWidth="80" Margin="4,0"
                                                             VerticalAlignment="Center" ToolTip="Écran cible"/>

                                                    <Button Grid.Column="5"
                                                            Content="⛶" ToolTip="Plein écran"
                                                            Style="{StaticResource StoneButton}"
                                                            Command="{Binding DataContext.FullscreenWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            FontSize="13" Padding="6,3" Margin="0,0,4,0"/>

                                                    <Button Grid.Column="6"
                                                            Content="{Binding IsMainWindow, Converter={StaticResource MainLabelConverter}}"
                                                            Style="{StaticResource StoneButton}"
                                                            Command="{Binding DataContext.SetAsMainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            FontSize="11" Padding="8,4"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Preview panel -->
                        <Border Grid.Column="2" Background="{StaticResource PanelBg}" CornerRadius="6"
                                Padding="12" BorderThickness="1.5" BorderBrush="#6B5A33">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Aperçu du raid" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrightGoldBrush}" Margin="0,0,0,8"/>

                                <Border Background="#CC050508" CornerRadius="4" ClipToBounds="True"
                                        Width="480" Height="270" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        BorderThickness="1" BorderBrush="#443D2A">
                                    <ItemsControl ItemsSource="{Binding PreviewRects}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Width="480" Height="270"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding Width}" Height="{Binding Height}"
                                                        CornerRadius="2" Margin="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#220070DD"/>
                                                            <Setter Property="BorderBrush" Value="#0070DD"/>
                                                            <Setter Property="BorderThickness" Value="1.5"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMain}" Value="True">
                                                                    <Setter Property="Background" Value="#22FF8C00"/>
                                                                    <Setter Property="BorderBrush" Value="#FF8C00"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsMonitorOutline}" Value="True">
                                                                    <Setter Property="Background" Value="#0C1A1525"/>
                                                                    <Setter Property="BorderBrush" Value="#886B5A33"/>
                                                                    <Setter Property="BorderThickness" Value="2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid Margin="4">
                                                        <TextBlock Text="{Binding Title}" FontSize="10"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Cursor="Hand" ToolTip="Cliquer pour renommer"
                                                                   MouseLeftButtonDown="PreviewName_Click"
                                                                   x:Name="PreviewLabel">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMonitorOutline}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
                                                                            <Setter Property="FontSize" Value="9"/>
                                                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                                                            <Setter Property="VerticalAlignment" Value="Top"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBox FontSize="10" Padding="0" MinWidth="40"
                                                                 Visibility="Collapsed"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 Text="{Binding Window.CustomName, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="#1A1208" Foreground="{StaticResource GoldBrush}"
                                                                 BorderBrush="#6B5A33" BorderThickness="1"
                                                                 LostFocus="PreviewRenameBox_LostFocus"
                                                                 KeyDown="PreviewRenameBox_KeyDown"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Apply button -->
                    <StackPanel Grid.Row="5" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Content="Appliquer le layout" Style="{StaticResource WowButton}"
                                Command="{Binding ApplyLayoutCommand}" FontSize="15" Padding="40,12"/>
                    </StackPanel>

                            <!-- Status bar -->
                            <Border Grid.Row="6" Background="{StaticResource PanelBg}" CornerRadius="4"
                                    Padding="12,5" Margin="0,8,0,0" BorderThickness="1" BorderBrush="#443D2A">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding AppVersion}"
                                               FontSize="10" Foreground="{StaticResource SubtextBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                                               Foreground="{StaticResource SubtextBrush}"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
    </Grid>
    </Border>
</Window>
