<Window x:Class="WindowsOrganiserApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WindowsOrganiserApp.ViewModels"
        xmlns:conv="clr-namespace:WindowsOrganiserApp.Converters"
        mc:Ignorable="d"
        Title="Special Azeroth Service — Multibox Organiser"
        Height="700" Width="1200"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Foreground="#E8D5A3"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:BoolToMainLabelConverter x:Key="MainLabelConverter"/>
        <conv:EnumToBoolConverter x:Key="EnumToBool"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- WoW Classic Color Palette -->
        <SolidColorBrush x:Key="GoldBrush" Color="#C9A44A"/>
        <SolidColorBrush x:Key="BrightGoldBrush" Color="#FFD100"/>
        <SolidColorBrush x:Key="PanelBg" Color="#CC0E0E1A"/>
        <SolidColorBrush x:Key="PanelBg2" Color="#DD151525"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#886B5A33"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8D5A3"/>
        <SolidColorBrush x:Key="SubtextBrush" Color="#9B8B6E"/>
        <SolidColorBrush x:Key="EpicBrush" Color="#A335EE"/>

        <!-- WoW Red Button (Connexion style) -->
        <Style x:Key="WowButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFD100"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                BorderThickness="2" BorderBrush="#8B6914">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#8B1A1A" Offset="0"/>
                                    <GradientStop Color="#5C0E0E" Offset="0.5"/>
                                    <GradientStop Color="#3D0808" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFD100"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#A52222" Offset="0"/>
                                            <GradientStop Color="#7A1414" Offset="0.5"/>
                                            <GradientStop Color="#5C0E0E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#4A0A0A" Offset="0"/>
                                            <GradientStop Color="#3D0808" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary stone button -->
        <Style x:Key="StoneButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="3" Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="#6B5A33">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#2A2535" Offset="0"/>
                                    <GradientStop Color="#1A1525" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab pill WoW style -->
        <Style x:Key="WowPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="3" Padding="16,7"
                                BorderThickness="1" BorderBrush="#443D2A">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#1E1A28" Offset="0"/>
                                    <GradientStop Color="#141020" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrightGoldBrush}"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#2E2840" Offset="0"/>
                                            <GradientStop Color="#1E1830" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6B5A33"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" CornerRadius="3" Padding="10,5"
                                BorderThickness="1" BorderBrush="#443D2A">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#1E1A28" Offset="0"/>
                                    <GradientStop Color="#141020" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrightGoldBrush}"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#2E2840" Offset="0"/>
                                            <GradientStop Color="#1E1830" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6B5A33"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1E1A28" Offset="0"/>
                        <GradientStop Color="#141020" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#6B5A33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBtn" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" CornerRadius="3"
                                                BorderThickness="1" BorderBrush="#6B5A33"
                                                Background="{TemplateBinding Background}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="16"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="▾" FontSize="10"
                                                           Foreground="{StaticResource GoldBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ToggleButton.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1E1A28" Offset="0"/>
                                        <GradientStop Color="#141020" Offset="1"/>
                                    </LinearGradientBrush>
                                </ToggleButton.Background>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="6,3,20,3" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDown" CornerRadius="3" Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200"
                                        BorderThickness="1" BorderBrush="#6B5A33">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#1E1A28" Offset="0"/>
                                            <GradientStop Color="#0E0A14" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33C9A44A"/>
                                <Setter Property="Foreground" Value="{StaticResource BrightGoldBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectionCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Width="18" Height="18" CornerRadius="3"
                                BorderThickness="1.5" BorderBrush="#6B5A33"
                                Background="#1A1208">
                            <TextBlock x:Name="Check" Text="✓" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="Transparent"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A6B2A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                <Setter TargetName="Check" Property="Foreground" Value="{StaticResource BrightGoldBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrightGoldBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window control buttons (close, minimize) -->
        <Style x:Key="WinCtrlBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33C9A44A"/>
                                <Setter Property="Foreground" Value="{StaticResource BrightGoldBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinCtrlBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3"
                                Width="32" Height="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CC8B1A1A"/>
                                <Setter Property="Foreground" Value="#FFD100"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Background image + overlay -->
    <Border CornerRadius="6" ClipToBounds="True">
        <Border.Background>
            <RadialGradientBrush Center="0.5,0.3" RadiusX="0.8" RadiusY="0.9">
                <GradientStop Color="#2A1F14" Offset="0"/>
                <GradientStop Color="#1A1208" Offset="0.5"/>
                <GradientStop Color="#0D0A06" Offset="1"/>
            </RadialGradientBrush>
        </Border.Background>

        <Grid>
            <Border Background="#BB080810" CornerRadius="6"/>

            <!-- Cadre doré extérieur -->
            <Border BorderThickness="3" CornerRadius="6"
                    BorderBrush="{StaticResource GoldBrush}">
                <!-- Cadre intérieur fin -->
                <Border BorderThickness="1" CornerRadius="4" Margin="2"
                        BorderBrush="#443D2A">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Custom title bar (draggable) -->
                        <Border Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="Arrow">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#22C9A44A" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <DockPanel Margin="12,6,6,2">
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                           Text="Special Azeroth Service" FontSize="11"
                                           Foreground="{StaticResource SubtextBrush}"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="—" Style="{StaticResource WinCtrlBtn}"
                                            Click="Minimize_Click"/>
                                    <Button Content="✕" Style="{StaticResource WinCloseBtn}"
                                            Click="Close_Click" Margin="2,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- App content -->
                        <Grid Grid.Row="1" Margin="16,4,16,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: Logo + Guild name + Player -->
                    <Grid Grid.Row="0" Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="Assets/wow_logo.png" Height="42"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFD100" Offset="0"/>
                                    <GradientStop Color="#FF8C00" Offset="0.5"/>
                                    <GradientStop Color="#FFD100" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            <Run Text="&lt;Special Azeroth Service&gt;"/>
                        </TextBlock>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="⟳ Rafraîchir" Style="{StaticResource StoneButton}" FontSize="12" Padding="10,5"
                                    Command="{Binding RefreshWindowsCommand}" ToolTip="Rafraîchir la liste"/>
                            <Button Content="📖 Aide" Style="{StaticResource StoneButton}" FontSize="12" Padding="10,5"
                                    Click="Help_Click" ToolTip="Guide d'utilisation" Margin="6,0,0,0"/>
                            <Button Content="?" Style="{StaticResource StoneButton}" FontSize="12" Padding="10,5"
                                    Click="About_Click" ToolTip="À propos" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Gold separator -->
                    <Border Grid.Row="1" Height="2" Margin="30,4,30,8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#6B5A33" Offset="0.2"/>
                                <GradientStop Color="#C9A44A" Offset="0.5"/>
                                <GradientStop Color="#6B5A33" Offset="0.8"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>


                    <!-- Main content -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="470"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Window list panel -->
                        <Border Grid.Column="0" Background="{StaticResource PanelBg}" CornerRadius="6"
                                Padding="12" BorderThickness="1.5" BorderBrush="#6B5A33">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="Fenêtres du groupe" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrightGoldBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Tout" Style="{StaticResource StoneButton}"
                                                Command="{Binding SelectAllCommand}" FontSize="10" Padding="6,2"
                                                ToolTip="Tout cocher"/>
                                        <Button Content="Aucun" Style="{StaticResource StoneButton}"
                                                Command="{Binding DeselectAllCommand}" FontSize="10" Padding="6,2"
                                                Margin="4,0,0,0" ToolTip="Tout décocher"/>
                                    </StackPanel>
                                </DockPanel>

                                <ListBox x:Name="WindowListBox"
                                         ItemsSource="{Binding AvailableWindows}"
                                         AllowDrop="True" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonDown="WindowList_PreviewMouseDown"
                                         PreviewMouseMove="WindowList_PreviewMouseMove"
                                         Drop="WindowList_Drop"
                                         DragOver="WindowList_DragOver"
                                         DragLeave="WindowList_DragLeave">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource PanelBg2}" CornerRadius="4"
                                                    Padding="10,8" Margin="0,0,0,3"
                                                    BorderThickness="1" BorderBrush="#443D2A"
                                                    Cursor="Hand" ToolTip="Glisser pour réordonner">
    <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="☰" FontSize="14"
                                                               Foreground="{StaticResource SubtextBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                                               ToolTip="Glisser pour réordonner" Cursor="SizeAll"/>

                                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}"
                                                              Style="{StaticResource SelectionCheck}" Margin="0,0,8,0"/>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <Grid>
                                                            <TextBlock FontSize="12" Foreground="{StaticResource BrightGoldBrush}"
                                                                       Text="{Binding DisplayName, Mode=OneWay}"
                                                                       VerticalAlignment="Center" Cursor="Hand"
                                                                       ToolTip="Cliquer pour renommer"
                                                                       MouseLeftButtonDown="DisplayName_DoubleClick"
                                                                       x:Name="NameLabel"/>
                                                            <TextBox FontSize="12" Padding="0" MinWidth="80"
                                                                     Visibility="Collapsed"
                                                                     Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="#1A1208" Foreground="{StaticResource GoldBrush}"
                                                                     BorderBrush="#6B5A33" BorderThickness="1"
                                                                     LostFocus="RenameBox_LostFocus"
                                                                     KeyDown="RenameBox_KeyDown"/>
                                                        </Grid>
                                                        <TextBlock FontSize="10" Foreground="{StaticResource SubtextBrush}"
                                                                   Text="{Binding ProcessName, Mode=OneWay}"/>
                                                    </StackPanel>

                                                    <ComboBox Grid.Column="3"
                                                             ItemsSource="{Binding DataContext.Monitors, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             SelectedItem="{Binding AssignedMonitor}"
                                                             DisplayMemberPath="DisplayLabel"
                                                             FontSize="10" Width="75" Height="28" Margin="4,0"
                                                             VerticalAlignment="Center" ToolTip="Écran cible"/>

                                                    <Button Grid.Column="4"
                                                            ToolTip="Plein écran / Restaurer"
                                                            Style="{StaticResource StoneButton}"
                                                            Command="{Binding DataContext.FullscreenWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            FontSize="13" Padding="6,3" Width="32" Margin="0,0,4,0">
                                                        <Button.Content>
                                                            <TextBlock>
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="⛶"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                                                                <Setter Property="Text" Value="⊡"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button.Content>
                                                    </Button>

                                                    <Button Grid.Column="5"
                                                            Content="{Binding IsMainWindow, Converter={StaticResource MainLabelConverter}}"
                                                            Style="{StaticResource StoneButton}"
                                                            Command="{Binding DataContext.SetAsMainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            FontSize="10" Padding="4,4" Width="62"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Preview panel -->
                        <Border Grid.Column="2" Background="{StaticResource PanelBg}" CornerRadius="6"
                                Padding="8" BorderThickness="1.5" BorderBrush="#6B5A33">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                            HorizontalContentAlignment="Center">
                                <ItemsControl ItemsSource="{Binding MonitorConfigs}" HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Margin="4" Padding="10,6"
                                                    BorderThickness="1.5" BorderBrush="#6B5A33"
                                                    Width="290" VerticalAlignment="Stretch">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#1E1A28" Offset="0"/>
                                                        <GradientStop Color="#12101C" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel>
                                                    <TextBlock FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource BrightGoldBrush}" Margin="0,0,0,4"
                                                               Text="{Binding Monitor.DisplayLabel, StringFormat='⚙ {0}'}"/>
                                                    <Grid HorizontalAlignment="Stretch" Margin="8,0" MinHeight="120">
                                                        <!-- Grille mode Principal -->
                                                        <Grid>
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Split}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="50"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode" FontSize="10"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource SubtextBrush}" Margin="0,0,6,0"/>
                                                            <WrapPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <RadioButton Content="Principal" Style="{StaticResource WowPill}" FontSize="10"
                                                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Main}"/>
                                                                <RadioButton Content="Fractionné" Style="{StaticResource WowPill}" FontSize="10"
                                                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Split}"/>
                                                            </WrapPanel>

                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Taille" FontSize="10"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource SubtextBrush}" Margin="0,3,6,0"/>
                                                            <WrapPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,0">
                                                                <RadioButton Content="G" Style="{StaticResource WowPill}" FontSize="10" ToolTip="Grand"
                                                                             IsChecked="{Binding Size, Converter={StaticResource EnumToBool}, ConverterParameter=Grand}"/>
                                                                <RadioButton Content="M" Style="{StaticResource WowPill}" FontSize="10" ToolTip="Moyen"
                                                                             IsChecked="{Binding Size, Converter={StaticResource EnumToBool}, ConverterParameter=Moyen}"/>
                                                                <RadioButton Content="P" Style="{StaticResource WowPill}" FontSize="10" ToolTip="Petit"
                                                                             IsChecked="{Binding Size, Converter={StaticResource EnumToBool}, ConverterParameter=Petit}"/>
                                                            </WrapPanel>

                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Pos" FontSize="10"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource SubtextBrush}" Margin="0,3,6,0"/>
                                                            <WrapPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,0">
                                                                <RadioButton Content="↖" Style="{StaticResource WowPill}" FontSize="10"
                                                                             IsChecked="{Binding Position, Converter={StaticResource EnumToBool}, ConverterParameter=TopLeft}"/>
                                                                <RadioButton Content="↗" Style="{StaticResource WowPill}" FontSize="10"
                                                                             IsChecked="{Binding Position, Converter={StaticResource EnumToBool}, ConverterParameter=TopRight}"/>
                                                                <RadioButton Content="↘" Style="{StaticResource WowPill}" FontSize="10"
                                                                             IsChecked="{Binding Position, Converter={StaticResource EnumToBool}, ConverterParameter=BottomRight}"/>
                                                                <RadioButton Content="↙" Style="{StaticResource WowPill}" FontSize="10"
                                                                             IsChecked="{Binding Position, Converter={StaticResource EnumToBool}, ConverterParameter=BottomLeft}"/>
                                                            </WrapPanel>

                                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Zones" FontSize="10"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource SubtextBrush}" Margin="0,3,6,0"/>
                                                            <WrapPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,0">
                                                                <CheckBox Content="Latéral" IsChecked="{Binding HasLateral}"
                                                                          Foreground="{StaticResource GoldBrush}" FontSize="10"
                                                                          VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                <CheckBox Content="Bandeau" IsChecked="{Binding HasBandeau}"
                                                                          Foreground="{StaticResource GoldBrush}" FontSize="10"
                                                                          VerticalAlignment="Center"/>
                                                            </WrapPanel>
                                                        </Grid>

                                                        <!-- Grille mode Fractionné -->
                                                        <Grid>
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Split}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="50"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode" FontSize="10"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource SubtextBrush}" Margin="0,0,6,0"/>
                                                            <WrapPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <RadioButton Content="Principal" Style="{StaticResource WowPill}" FontSize="10"
                                                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Main}"/>
                                                                <RadioButton Content="Fractionné" Style="{StaticResource WowPill}" FontSize="10"
                                                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Split}"/>
                                                            </WrapPanel>

                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Orient." FontSize="10"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource SubtextBrush}" Margin="0,3,6,0"/>
                                                            <WrapPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,0">
                                                                <RadioButton Content="▥" Style="{StaticResource WowPill}" FontSize="10" ToolTip="Côte à côte"
                                                                             IsChecked="{Binding SplitOrientation, Converter={StaticResource EnumToBool}, ConverterParameter=Horizontal}"/>
                                                                <RadioButton Content="▤" Style="{StaticResource WowPill}" FontSize="10" ToolTip="Empilé"
                                                                             IsChecked="{Binding SplitOrientation, Converter={StaticResource EnumToBool}, ConverterParameter=Vertical}"/>
                                                            </WrapPanel>
                                                        </Grid>
                                                    </Grid>
                                                    <Border Background="#CC050508" CornerRadius="4" ClipToBounds="True"
                                                            Height="140" Margin="0,6,0,0"
                                                            BorderThickness="1" BorderBrush="#443D2A">
                                                        <ItemsControl ItemsSource="{Binding PreviewRects}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <Canvas Width="240" Height="140"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="{Binding Width}" Height="{Binding Height}"
                                                                            CornerRadius="2" Margin="1">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="#220070DD"/>
                                                                                <Setter Property="BorderBrush" Value="#0070DD"/>
                                                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsMain}" Value="True">
                                                                                        <Setter Property="Background" Value="#22FF8C00"/>
                                                                                        <Setter Property="BorderBrush" Value="#FF8C00"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="{Binding Title}" FontSize="9"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{StaticResource TextBrush}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Apply button -->
                    <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Content="Appliquer le layout" Style="{StaticResource WowButton}"
                                Command="{Binding ApplyLayoutCommand}" FontSize="15" Padding="40,12"/>
                    </StackPanel>

                            <!-- Status bar -->
                            <Border Grid.Row="4" Background="{StaticResource PanelBg}" CornerRadius="4"
                                    Padding="12,5" Margin="0,8,0,0" BorderThickness="1" BorderBrush="#443D2A">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding AppVersion}"
                                               FontSize="10" Foreground="{StaticResource SubtextBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                                               Foreground="{StaticResource SubtextBrush}"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
    </Grid>
    </Border>
</Window>
