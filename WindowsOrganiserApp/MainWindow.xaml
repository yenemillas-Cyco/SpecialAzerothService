<Window x:Class="WindowsOrganiserApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WindowsOrganiserApp.ViewModels"
        xmlns:conv="clr-namespace:WindowsOrganiserApp.Converters"
        xmlns:models="clr-namespace:WindowsOrganiserApp.Models"
        xmlns:views="clr-namespace:WindowsOrganiserApp.Views"
        mc:Ignorable="d"
        Title="Special Azeroth Service — Multibox Organiser"
        Height="650" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Foreground="#E8D5A3"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:EnumToBoolConverter x:Key="EnumToBool"/>
    </Window.Resources>

    <!-- Background image + overlay -->
    <Border CornerRadius="6" ClipToBounds="True"
            Background="{DynamicResource WindowBgBrush}">

        <Grid>
            <Border Background="{DynamicResource OverlayBrush}" CornerRadius="6"/>

            <!-- Cadre doré extérieur -->
            <Border BorderThickness="3" CornerRadius="6"
                    BorderBrush="{DynamicResource GoldBrush}">
                <!-- Cadre intérieur fin -->
                <Border BorderThickness="1" CornerRadius="4" Margin="2"
                        BorderBrush="{DynamicResource InnerBorderBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Custom title bar (draggable) -->
                        <Border Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="Arrow"
                                Background="{DynamicResource TitleBarBgBrush}">
                            <DockPanel Margin="12,6,6,2">
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                           Text="Special Azeroth Service" FontSize="11"
                                           Foreground="{DynamicResource SubtextBrush}"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="—" Style="{DynamicResource WinCtrlBtn}"
                                            Click="Minimize_Click"/>
                                    <Button Content="✕" Style="{DynamicResource WinCloseBtn}"
                                            Click="Close_Click" Margin="2,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- App content -->
                        <Grid Grid.Row="1" Margin="16,4,16,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: Logo + Guild name + Player -->
                    <Grid Grid.Row="0" Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="Assets/wow_logo.png" Height="42"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TitleTextBrush}">
                            <Run Text="&lt;Special Azeroth Service&gt;"/>
                        </TextBlock>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{DynamicResource StoneButton}" FontSize="12" Padding="10,5"
                                    Command="{Binding RefreshWindowsCommand}" ToolTip="Rafraîchir la liste">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⟳" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{DynamicResource Header_Refresh}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <ToggleButton IsChecked="{Binding WowOnly}" Margin="8,0,0,0"
                                         Style="{DynamicResource StoneToggle}" Padding="8,5" FontSize="10"
                                         Content="{DynamicResource Header_WowOnly}"
                                         ToolTip="Coché : uniquement WoW. Décoché : toutes les fenêtres"/>
                            <ComboBox Width="110" Height="28" Margin="6,0,0,0"
                                      ItemsSource="{Binding AvailableThemes}"
                                      SelectedItem="{Binding CurrentThemeLabel}"
                                      ToolTip="Changer de thème"/>
                            <ComboBox Width="90" Height="28" Margin="6,0,0,0"
                                      ItemsSource="{Binding AvailableLanguages}"
                                      SelectedItem="{Binding CurrentLanguage}"
                                      ToolTip="{DynamicResource Lang_Label}"/>
                            <Button Style="{DynamicResource StoneButton}" FontSize="11" Padding="8,5" Margin="6,0,0,0"
                                    Command="{Binding ToggleSyncCommand}"
                                    ToolTip="Connecter / Déconnecter le WebSocket">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#888"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSyncConnected}" Value="True">
                                                        <Setter Property="Fill" Value="#44FF44"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSyncConnected}" Value="False">
                                                        <Setter Property="Fill" Value="#FF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Connexion"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSyncConnected}" Value="True">
                                                        <Setter Property="Text" Value="Déconnexion"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Content="{DynamicResource Header_Help}" Style="{DynamicResource StoneButton}" FontSize="12" Padding="10,5"
                                    Click="Help_Click" ToolTip="{DynamicResource Help_Title}" Margin="6,0,0,0"/>
                            <Button Content="?" Style="{DynamicResource StoneButton}" FontSize="12" Padding="10,5"
                                    Click="About_Click" ToolTip="{DynamicResource About_WindowTitle}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Gold separator -->
                    <Border Grid.Row="1" Height="2" Margin="30,4,30,8"
                            Background="{DynamicResource GoldSepBrush}">
                    </Border>

                    <!-- Mode toggle -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <RadioButton Content="⚔ Fenêtres" Style="{DynamicResource WowPill}" FontSize="13" Height="34" Padding="14,4"
                                     IsChecked="{Binding IsOrganiserMode}" Margin="0,0,6,0"/>
                        <RadioButton Content="🗺 Carto" Style="{DynamicResource WowPill}" FontSize="13" Height="34" Padding="14,4"
                                     IsChecked="{Binding IsCartoMode}" Margin="0,0,6,0"/>
                        <RadioButton Content="💰 Primes" Style="{DynamicResource WowPill}" FontSize="13" Height="34" Padding="14,4"
                                     IsChecked="{Binding IsBountyMode}"/>
                    </StackPanel>

                    <!-- Unified Organiser content -->
                    <Grid Grid.Row="3" Visibility="{Binding IsOrganiserMode, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: Window list (from Standard) -->
                        <Border Grid.Column="0" Background="{DynamicResource PanelBg}" CornerRadius="6"
                                Padding="12" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource List_Title}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrightGoldBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{DynamicResource List_All}" Style="{DynamicResource StoneButton}"
                                                Command="{Binding SelectAllCommand}" FontSize="10" Padding="6,2"/>
                                        <Button Content="{DynamicResource List_None}" Style="{DynamicResource StoneButton}"
                                                Command="{Binding DeselectAllCommand}" FontSize="10" Padding="6,2"
                                                Margin="4,0,0,0"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Presets -->
                                <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8,6"
                                        Background="{DynamicResource PanelBg2}" CornerRadius="4"
                                        BorderThickness="1" BorderBrush="{DynamicResource InnerBorderBrush}">
                                    <StackPanel>
                                        <TextBlock Text="📁 Presets" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource GoldBrush}" Margin="0,0,0,4"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource StoneButton}" FontSize="11" Padding="6,3" Margin="4,0,0,0"
                                                    Command="{Binding AdvancedVm.DeletePresetCommand}" ToolTip="Supprimer" Foreground="#FF6B6B"/>
                                            <Button DockPanel.Dock="Right" Content="▶" Style="{DynamicResource StoneButton}" FontSize="11" Padding="6,3" Margin="4,0,0,0"
                                                    Command="{Binding AdvancedVm.LoadPresetCommand}" ToolTip="Charger"/>
                                            <ComboBox ItemsSource="{Binding AdvancedVm.Presets}"
                                                      SelectedItem="{Binding AdvancedVm.SelectedPreset}"
                                                      DisplayMemberPath="Name" Height="24" FontSize="10"
                                                      ToolTip="Configurations sauvegardées"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,4,0,0">
                                            <Button DockPanel.Dock="Right" Content="💾" Style="{DynamicResource StoneButton}" FontSize="11" Padding="6,3" Margin="4,0,0,0"
                                                    Command="{Binding AdvancedVm.SavePresetCommand}" ToolTip="Sauvegarder le layout actuel"/>
                                            <TextBox Text="{Binding AdvancedVm.NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="10" Padding="4,3" ToolTip="Nom du nouveau preset"
                                                     Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <Button DockPanel.Dock="Bottom" Content="⚔ Appliquer" Style="{DynamicResource WowButton}"
                                        Command="{Binding AdvancedVm.ApplyAdvancedCommand}" FontSize="13" Padding="20,10"
                                        HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                        ToolTip="Applique les positions du canvas aux fenêtres réelles"/>

                                <ListBox x:Name="WindowListBox"
                                         ItemsSource="{Binding AvailableWindows}"
                                         AllowDrop="True" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonDown="WindowList_PreviewMouseDown"
                                         PreviewMouseMove="WindowList_PreviewMouseMove"
                                         Drop="WindowList_Drop"
                                         DragOver="WindowList_DragOver"
                                         DragLeave="WindowList_DragLeave">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource PanelBg2}" CornerRadius="4"
                                                    Padding="8,8" Margin="0,0,0,4"
                                                    BorderThickness="1" BorderBrush="{DynamicResource InnerBorderBrush}"
                                                    Cursor="Hand" ToolTip="Glisser pour réordonner">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="☰" FontSize="14"
                                                               Foreground="{DynamicResource SubtextBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0"
                                                               Cursor="SizeAll"/>

                                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}"
                                                              Style="{DynamicResource SelectionCheck}" Margin="0,0,6,0"/>

                                                    <Border Grid.Column="2" Width="20" Height="20" CornerRadius="10"
                                                            Background="{DynamicResource GoldBrush}" Margin="0,0,6,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding LaunchOrder}" FontSize="10" FontWeight="Bold"
                                                                   Foreground="#FFFFFF" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                        <Grid>
                                                            <TextBlock FontSize="11" Foreground="{DynamicResource BrightGoldBrush}"
                                                                       Text="{Binding DisplayName, Mode=OneWay}"
                                                                       VerticalAlignment="Center" Cursor="Hand"
                                                                       ToolTip="Cliquer pour renommer"
                                                                       MouseLeftButtonDown="DisplayName_DoubleClick"/>
                                                            <TextBox FontSize="11" Padding="0" MinWidth="60"
                                                                     Visibility="Collapsed"
                                                                     Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="#1A1208" Foreground="{DynamicResource GoldBrush}"
                                                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                                     LostFocus="RenameBox_LostFocus"
                                                                     KeyDown="RenameBox_KeyDown"/>
                                                        </Grid>
                                                        <TextBlock FontSize="9" Foreground="{DynamicResource SubtextBrush}"
                                                                   Text="{Binding ProcessName, Mode=OneWay}"/>
                                                    </StackPanel>

                                                    <ComboBox Grid.Column="4"
                                                             ItemsSource="{Binding DataContext.Monitors, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             SelectedItem="{Binding AssignedMonitor}"
                                                             DisplayMemberPath="DisplayLabel"
                                                             FontSize="10" Width="70" Height="28" Margin="4,0"
                                                             VerticalAlignment="Center" ToolTip="Écran cible"/>

                                                    <Button Grid.Column="5"
                                                            ToolTip="Plein écran / Restaurer"
                                                            Style="{DynamicResource StoneButton}"
                                                            Command="{Binding DataContext.FullscreenWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            FontSize="14" Padding="6,4" Width="32" Height="28" Margin="0,0,3,0">
                                                        <Button.Content>
                                                            <TextBlock>
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="⛶"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                                                                <Setter Property="Text" Value="⊡"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button.Content>
                                                    </Button>

                                                    <Button Grid.Column="6"
                                                            Style="{DynamicResource StoneButton}"
                                                            Command="{Binding DataContext.SetAsMainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            FontSize="10" Padding="4,4" Width="60" Height="28">
                                                        <Button.Content>
                                                            <TextBlock>
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="Set Leader"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMainWindow}" Value="True">
                                                                                <Setter Property="Text" Value="★ Leader"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource BrightGoldBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button.Content>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- RIGHT: Canvas + Tools + Presets -->
                        <Border Grid.Column="2" Background="{DynamicResource PanelBg}" CornerRadius="6"
                                Padding="8" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}">
                            <DockPanel>
                                <!-- Per-monitor auto-layout + apply buttons (bottom) -->
                                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding MonitorConfigs}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel HorizontalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}"
                                                    Background="{DynamicResource PanelBg2}"
                                                    CornerRadius="6" Padding="10,6" Margin="4,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Monitor.DisplayLabel}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource BrightGoldBrush}"
                                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>

                                                    <!-- Layout mode (exclusive — one active at a time) -->
                                                    <WrapPanel HorizontalAlignment="Center" Margin="0,2,0,6">
                                                        <RadioButton Content="▣ Principal" GroupName="{Binding Monitor.DeviceName}"
                                                                     Style="{DynamicResource StoneRadioToggle}"
                                                                     IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Main}"/>
                                                        <RadioButton Content="▥ Frac. V" GroupName="{Binding Monitor.DeviceName}"
                                                                     Style="{DynamicResource StoneRadioToggle}"
                                                                     IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=SplitV}"/>
                                                        <RadioButton Content="▤ Frac. H" GroupName="{Binding Monitor.DeviceName}"
                                                                     Style="{DynamicResource StoneRadioToggle}"
                                                                     IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=SplitH}"/>
                                                    </WrapPanel>

                                                    <!-- Config options (keep space when hidden to avoid layout shift) -->
                                                    <StackPanel>
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMainMode}" Value="False">
                                                                        <Setter Property="Opacity" Value="0"/>
                                                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,4">
                                                            <TextBlock Text="Taille:" FontSize="10" Foreground="{DynamicResource SubtextBrush}"
                                                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <ComboBox FontSize="10" Width="65" Height="24"
                                                                      SelectedItem="{Binding Size}"
                                                                      ItemsSource="{Binding Source={x:Static models:MainSize.Grand}, Converter={x:Static conv:EnumValuesConverter.Instance}}"/>
                                                            <TextBlock Text="Pos:" FontSize="10" Foreground="{DynamicResource SubtextBrush}"
                                                                       VerticalAlignment="Center" Margin="8,0,4,0"/>
                                                            <ComboBox FontSize="10" Width="80" Height="24"
                                                                      SelectedItem="{Binding Position}"
                                                                      ItemsSource="{Binding Source={x:Static models:MainPosition.TopLeft}, Converter={x:Static conv:EnumValuesConverter.Instance}}"/>
                                                        </WrapPanel>
                                                        <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,6">
                                                            <ToggleButton Content="Latéral" IsChecked="{Binding HasLateral}"
                                                                          Style="{DynamicResource StoneToggle}"/>
                                                            <ToggleButton Content="Bandeau" IsChecked="{Binding HasBandeau}"
                                                                          Style="{DynamicResource StoneToggle}"/>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                    <Button Style="{DynamicResource WowButton}" Padding="12,6"
                                                            Command="{Binding DataContext.AdvancedVm.ApplyMonitorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Monitor}">
                                                        <TextBlock Text="{Binding Monitor.DisplayLabel, StringFormat='⚔ Appliquer {0}'}" FontSize="11" FontWeight="Bold"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Compact tools + presets bar (bottom) -->
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                    <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,4">
                                        <Button Content="{DynamicResource Adv_CopySize}" Style="{DynamicResource StoneButton}" FontSize="10" Padding="6,3" Margin="0,0,3,0"
                                                Command="{Binding AdvancedVm.CopySizeCommand}"/>
                                        <Button Content="{DynamicResource Adv_PasteSize}" Style="{DynamicResource StoneButton}" FontSize="10" Padding="6,3" Margin="0,0,3,0"
                                                Command="{Binding AdvancedVm.PasteSizeCommand}"
                                                IsEnabled="{Binding AdvancedVm.HasCopiedSize}"/>
                                        <Button Content="{DynamicResource Adv_ApplyAll}" Style="{DynamicResource StoneButton}" FontSize="10" Padding="6,3" Margin="0,0,3,0"
                                                Command="{Binding AdvancedVm.ApplySizeToAllCommand}"/>
                                        <Button Content="{DynamicResource Adv_Swap}" Style="{DynamicResource StoneButton}" FontSize="10" Padding="6,3" Margin="0,0,3,0"
                                                Command="{Binding AdvancedVm.StartSwapCommand}"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding AdvancedVm.StatusMessage}" FontSize="9"
                                               Foreground="{DynamicResource SubtextBrush}" HorizontalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Interactive canvas (fills remaining space) -->
                                <Grid>
                                    <TextBlock Text="Glisser pour déplacer · Coins pour redimensionner"
                                               FontSize="9" Foreground="{DynamicResource SubtextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <Border Background="{DynamicResource OverlayBrush}" CornerRadius="4"
                                            Margin="0,16,0,0" BorderThickness="1" BorderBrush="{DynamicResource InnerBorderBrush}"
                                            ClipToBounds="True">
                                        <Canvas x:Name="AdvancedCanvas" Width="600" Height="340"
                                                Background="Transparent"
                                                ClipToBounds="True"
                                                MouseLeftButtonDown="AdvCanvas_MouseDown"
                                                MouseMove="AdvCanvas_MouseMove"
                                                MouseLeftButtonUp="AdvCanvas_MouseUp"/>
                                    </Border>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Carto content -->
                    <views:CartoView Grid.Row="3" DataContext="{Binding CartoVm}"
                                     Visibility="{Binding DataContext.IsCartoMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                    <!-- Bounty content -->
                    <views:BountyView Grid.Row="3" DataContext="{Binding BountyVm}"
                                      Visibility="{Binding DataContext.IsBountyMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                            <!-- Status bar -->
                            <Border Grid.Row="4" Background="{DynamicResource PanelBg}" CornerRadius="4"
                                    Padding="12,5" Margin="0,8,0,0" BorderThickness="1" BorderBrush="{DynamicResource InnerBorderBrush}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding AppVersion}"
                                               FontSize="10" Foreground="{DynamicResource SubtextBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                                               Foreground="{DynamicResource SubtextBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}"
                                            Margin="10,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsCartoMode, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="🌐" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Visibility="{Binding IsCartoMode, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding CartoVm.SyncStatus}" FontSize="10"
                                               Foreground="LightSkyBlue" VerticalAlignment="Center"
                                               Visibility="{Binding IsCartoMode, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding CartoVm.FriendsSummary}" FontSize="10"
                                               Foreground="{DynamicResource BrightGoldBrush}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsCartoMode, Converter={StaticResource BoolToVis}}"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
    </Grid>
    </Border>
</Window>
