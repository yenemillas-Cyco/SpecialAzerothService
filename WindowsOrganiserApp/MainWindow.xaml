<Window x:Class="WindowsOrganiserApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WindowsOrganiserApp.ViewModels"
        xmlns:conv="clr-namespace:WindowsOrganiserApp.Converters"
        xmlns:views="clr-namespace:WindowsOrganiserApp.Views"
        mc:Ignorable="d"
        Title="Special Azeroth Service — Multibox Organiser"
        Height="700" Width="1200"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Foreground="#E8D5A3"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:BoolToMainLabelConverter x:Key="MainLabelConverter"/>
        <conv:EnumToBoolConverter x:Key="EnumToBool"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVis"/>
        <conv:BoolToCompletedLabelConverter x:Key="BoolToCompletedLabel"/>
    </Window.Resources>

    <!-- Background image + overlay -->
    <Border CornerRadius="6" ClipToBounds="True"
            Background="{DynamicResource WindowBgBrush}">

        <Grid>
            <Border Background="{DynamicResource OverlayBrush}" CornerRadius="6"/>

            <!-- Cadre doré extérieur -->
            <Border BorderThickness="3" CornerRadius="6"
                    BorderBrush="{DynamicResource GoldBrush}">
                <!-- Cadre intérieur fin -->
                <Border BorderThickness="1" CornerRadius="4" Margin="2"
                        BorderBrush="{DynamicResource InnerBorderBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Custom title bar (draggable) -->
                        <Border Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="Arrow"
                                Background="{DynamicResource TitleBarBgBrush}">
                            <DockPanel Margin="12,6,6,2">
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                           Text="Special Azeroth Service" FontSize="11"
                                           Foreground="{DynamicResource SubtextBrush}"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="—" Style="{DynamicResource WinCtrlBtn}"
                                            Click="Minimize_Click"/>
                                    <Button Content="✕" Style="{DynamicResource WinCloseBtn}"
                                            Click="Close_Click" Margin="2,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- App content -->
                        <Grid Grid.Row="1" Margin="16,4,16,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: Logo + Guild name + Player -->
                    <Grid Grid.Row="0" Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="Assets/wow_logo.png" Height="42"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TitleTextBrush}">
                            <Run Text="&lt;Special Azeroth Service&gt;"/>
                        </TextBlock>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{DynamicResource StoneButton}" FontSize="12" Padding="10,5"
                                    Command="{Binding RefreshWindowsCommand}" ToolTip="Rafraîchir la liste">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⟳" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{DynamicResource Header_Refresh}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <CheckBox IsChecked="{Binding WowOnly}" Margin="8,0,0,0"
                                      Style="{DynamicResource SelectionCheck}" VerticalAlignment="Center"
                                      ToolTip="Coché : uniquement WoW. Décoché : toutes les fenêtres"/>
                            <TextBlock Text="{DynamicResource Header_WowOnly}" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                                       Foreground="{DynamicResource SubtextBrush}"/>
                            <ComboBox Width="110" Height="28" Margin="6,0,0,0"
                                      ItemsSource="{Binding AvailableThemes}"
                                      SelectedItem="{Binding CurrentThemeLabel}"
                                      ToolTip="Changer de thème"/>
                            <ComboBox Width="90" Height="28" Margin="6,0,0,0"
                                      ItemsSource="{Binding AvailableLanguages}"
                                      SelectedItem="{Binding CurrentLanguage}"
                                      ToolTip="{DynamicResource Lang_Label}"/>
                            <Button Content="{DynamicResource Header_Help}" Style="{DynamicResource StoneButton}" FontSize="12" Padding="10,5"
                                    Click="Help_Click" ToolTip="{DynamicResource Help_Title}" Margin="6,0,0,0"/>
                            <Button Content="?" Style="{DynamicResource StoneButton}" FontSize="12" Padding="10,5"
                                    Click="About_Click" ToolTip="{DynamicResource About_WindowTitle}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Gold separator -->
                    <Border Grid.Row="1" Height="2" Margin="30,4,30,8"
                            Background="{DynamicResource GoldSepBrush}">
                    </Border>

                    <!-- Mode toggle -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <RadioButton Content="{DynamicResource Mode_Standard}" Style="{DynamicResource WowPill}" FontSize="12" Height="30"
                                     IsChecked="{Binding IsStandardMode}" Margin="0,0,6,0"/>
                        <RadioButton Content="{DynamicResource Mode_Advanced}" Style="{DynamicResource WowPill}" FontSize="12" Height="30"
                                     IsChecked="{Binding IsAdvancedMode}" Margin="0,0,6,0"/>
                        <RadioButton Content="Carto" Style="{DynamicResource WowPill}" FontSize="12" Height="30"
                                     IsChecked="{Binding IsCartoMode}" Margin="0,0,6,0"/>
                        <RadioButton Content="🏴‍☠️ Primes" Style="{DynamicResource WowPill}" FontSize="12" Height="30"
                                     IsChecked="{Binding IsBountyMode}"/>
                    </StackPanel>

                    <!-- Standard content -->
                    <DockPanel Grid.Row="3" Visibility="{Binding IsStandardMode, Converter={StaticResource BoolToVis}}">
                        <!-- Apply button always visible at bottom -->
                        <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button Content="{DynamicResource Layout_Apply}" Style="{DynamicResource WowButton}"
                                    Command="{Binding ApplyLayoutCommand}" FontSize="15" Padding="40,12"/>
                        </StackPanel>

                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="470"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Window list panel -->
                        <Border Grid.Column="0" Background="{DynamicResource PanelBg}" CornerRadius="6"
                                Padding="12" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource List_Title}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrightGoldBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{DynamicResource List_All}" Style="{DynamicResource StoneButton}"
                                                Command="{Binding SelectAllCommand}" FontSize="10" Padding="6,2"/>
                                        <Button Content="{DynamicResource List_None}" Style="{DynamicResource StoneButton}"
                                                Command="{Binding DeselectAllCommand}" FontSize="10" Padding="6,2"
                                                Margin="4,0,0,0"/>
                                    </StackPanel>
                                </DockPanel>

                                <ListBox x:Name="WindowListBox"
                                         ItemsSource="{Binding AvailableWindows}"
                                         AllowDrop="True" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonDown="WindowList_PreviewMouseDown"
                                         PreviewMouseMove="WindowList_PreviewMouseMove"
                                         Drop="WindowList_Drop"
                                         DragOver="WindowList_DragOver"
                                         DragLeave="WindowList_DragLeave">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource PanelBg2}" CornerRadius="4"
                                                    Padding="12,10" Margin="0,0,0,5"
                                                    BorderThickness="1" BorderBrush="{DynamicResource InnerBorderBrush}"
                                                    Cursor="Hand" ToolTip="Glisser pour réordonner">
    <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="☰" FontSize="14"
                                                               Foreground="{DynamicResource SubtextBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                                               ToolTip="Glisser pour réordonner" Cursor="SizeAll"/>

                                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}"
                                                              Style="{DynamicResource SelectionCheck}" Margin="0,0,6,0"/>

                                                    <Border Grid.Column="2" Width="22" Height="22" CornerRadius="11"
                                                            Background="{DynamicResource GoldBrush}" Margin="0,0,8,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding LaunchOrder}" FontSize="11" FontWeight="Bold"
                                                                   Foreground="#FFFFFF" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                        <Grid>
                                                            <TextBlock FontSize="12" Foreground="{DynamicResource BrightGoldBrush}"
                                                                       Text="{Binding DisplayName, Mode=OneWay}"
                                                                       VerticalAlignment="Center" Cursor="Hand"
                                                                       ToolTip="Cliquer pour renommer"
                                                                       MouseLeftButtonDown="DisplayName_DoubleClick"
                                                                       x:Name="NameLabel"/>
                                                            <TextBox FontSize="12" Padding="0" MinWidth="80"
                                                                     Visibility="Collapsed"
                                                                     Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="#1A1208" Foreground="{DynamicResource GoldBrush}"
                                                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                                     LostFocus="RenameBox_LostFocus"
                                                                     KeyDown="RenameBox_KeyDown"/>
                                                        </Grid>
                                                        <TextBlock FontSize="10" Foreground="{DynamicResource SubtextBrush}"
                                                                   Text="{Binding ProcessName, Mode=OneWay}"/>
                                                    </StackPanel>

                                                    <ComboBox Grid.Column="4"
                                                             ItemsSource="{Binding DataContext.Monitors, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             SelectedItem="{Binding AssignedMonitor}"
                                                             DisplayMemberPath="DisplayLabel"
                                                             FontSize="11" Width="80" Height="32" Margin="4,0"
                                                             VerticalAlignment="Center" ToolTip="Écran cible"/>

                                                    <Button Grid.Column="5"
                                                            ToolTip="Plein écran / Restaurer"
                                                            Style="{DynamicResource StoneButton}"
                                                            Command="{Binding DataContext.FullscreenWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            FontSize="15" Padding="8,5" Width="38" Height="32" Margin="0,0,4,0">
                                                        <Button.Content>
                                                            <TextBlock>
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="⛶"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                                                                <Setter Property="Text" Value="⊡"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button.Content>
                                                    </Button>

                                                    <Button Grid.Column="6"
                                                            Content="{Binding IsMainWindow, Converter={StaticResource MainLabelConverter}}"
                                                            Style="{DynamicResource StoneButton}"
                                                            Command="{Binding DataContext.SetAsMainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            FontSize="11" Padding="6,5" Width="70" Height="32"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Preview panel -->
                        <Border Grid.Column="2" Background="{DynamicResource PanelBg}" CornerRadius="6"
                                Padding="8" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                            HorizontalContentAlignment="Center">
                                <ItemsControl ItemsSource="{Binding MonitorConfigs}" HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Margin="4" Padding="10,6"
                                                    BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}"
                                                    Width="290" VerticalAlignment="Stretch"
                                                    Background="{DynamicResource MonitorCardBgBrush}">
                                                <StackPanel>
                                                    <TextBlock FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource BrightGoldBrush}" Margin="0,0,0,4"
                                                               Text="{Binding Monitor.DisplayLabel, StringFormat='⚙ {0}'}"/>
                                                    <Grid HorizontalAlignment="Stretch" Margin="8,0" MinHeight="120">
                                                        <!-- Grille mode Principal -->
                                                        <Grid>
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Split}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="50"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode" FontSize="11"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource SubtextBrush}" Margin="0,0,6,0"/>
                                                            <WrapPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <RadioButton Content="Principal" Style="{DynamicResource WowPill}" FontSize="11" Height="30"
                                                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Main}"/>
                                                                <RadioButton Content="Fractionné" Style="{DynamicResource WowPill}" FontSize="11" Height="30"
                                                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Split}"/>
                                                            </WrapPanel>

                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Taille" FontSize="11"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource SubtextBrush}" Margin="0,5,6,0"/>
                                                            <WrapPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                                                                <RadioButton Content="G" Style="{DynamicResource WowPill}" FontSize="11" Height="30" ToolTip="Grand"
                                                                             IsChecked="{Binding Size, Converter={StaticResource EnumToBool}, ConverterParameter=Grand}"/>
                                                                <RadioButton Content="M" Style="{DynamicResource WowPill}" FontSize="11" Height="30" ToolTip="Moyen"
                                                                             IsChecked="{Binding Size, Converter={StaticResource EnumToBool}, ConverterParameter=Moyen}"/>
                                                                <RadioButton Content="P" Style="{DynamicResource WowPill}" FontSize="11" Height="30" ToolTip="Petit"
                                                                             IsChecked="{Binding Size, Converter={StaticResource EnumToBool}, ConverterParameter=Petit}"/>
                                                            </WrapPanel>

                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Pos" FontSize="11"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource SubtextBrush}" Margin="0,5,6,0"/>
                                                            <WrapPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                                                                <RadioButton Style="{DynamicResource WowPill}" Height="30" Padding="10,4"
                                                                             IsChecked="{Binding Position, Converter={StaticResource EnumToBool}, ConverterParameter=TopLeft}">
                                                                    <TextBlock Text="↖" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                </RadioButton>
                                                                <RadioButton Style="{DynamicResource WowPill}" Height="30" Padding="10,4"
                                                                             IsChecked="{Binding Position, Converter={StaticResource EnumToBool}, ConverterParameter=TopRight}">
                                                                    <TextBlock Text="↗" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                </RadioButton>
                                                                <RadioButton Style="{DynamicResource WowPill}" Height="30" Padding="10,4"
                                                                             IsChecked="{Binding Position, Converter={StaticResource EnumToBool}, ConverterParameter=BottomRight}">
                                                                    <TextBlock Text="↘" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                </RadioButton>
                                                                <RadioButton Style="{DynamicResource WowPill}" Height="30" Padding="10,4"
                                                                             IsChecked="{Binding Position, Converter={StaticResource EnumToBool}, ConverterParameter=BottomLeft}">
                                                                    <TextBlock Text="↙" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                </RadioButton>
                                                            </WrapPanel>

                                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Zones" FontSize="11"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource SubtextBrush}" Margin="0,5,6,0"/>
                                                            <WrapPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                                                                <CheckBox Content="Latéral" IsChecked="{Binding HasLateral}"
                                                                          Foreground="{DynamicResource GoldBrush}" FontSize="11"
                                                                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <CheckBox Content="Bandeau" IsChecked="{Binding HasBandeau}"
                                                                          Foreground="{DynamicResource GoldBrush}" FontSize="11"
                                                                          VerticalAlignment="Center"/>
                                                            </WrapPanel>
                                                        </Grid>

                                                        <!-- Grille mode Fractionné -->
                                                        <Grid>
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Split}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="50"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode" FontSize="11"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource SubtextBrush}" Margin="0,0,6,0"/>
                                                            <WrapPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <RadioButton Content="Principal" Style="{DynamicResource WowPill}" FontSize="11" Height="30"
                                                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Main}"/>
                                                                <RadioButton Content="Fractionné" Style="{DynamicResource WowPill}" FontSize="11" Height="30"
                                                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Split}"/>
                                                            </WrapPanel>

                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Orient." FontSize="11"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource SubtextBrush}" Margin="0,5,6,0"/>
                                                            <WrapPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                                                                <RadioButton Content="▥" Style="{DynamicResource WowPill}" FontSize="14" Height="30" ToolTip="Côte à côte"
                                                                             IsChecked="{Binding SplitOrientation, Converter={StaticResource EnumToBool}, ConverterParameter=Horizontal}"/>
                                                                <RadioButton Content="▤" Style="{DynamicResource WowPill}" FontSize="14" Height="30" ToolTip="Empilé"
                                                                             IsChecked="{Binding SplitOrientation, Converter={StaticResource EnumToBool}, ConverterParameter=Vertical}"/>
                                                            </WrapPanel>
                                                        </Grid>
                                                    </Grid>
                                                    <Border Background="{DynamicResource OverlayBrush}" CornerRadius="4" ClipToBounds="True"
                                                            Height="140" Margin="0,6,0,0"
                                                            BorderThickness="1" BorderBrush="{DynamicResource InnerBorderBrush}">
                                                        <ItemsControl ItemsSource="{Binding PreviewRects}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <Canvas Width="240" Height="140"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="{Binding Width}" Height="{Binding Height}"
                                                                            CornerRadius="2" Margin="1">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="#220070DD"/>
                                                                                <Setter Property="BorderBrush" Value="#0070DD"/>
                                                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsMain}" Value="True">
                                                                                        <Setter Property="Background" Value="#22FF8C00"/>
                                                                                        <Setter Property="BorderBrush" Value="#FF8C00"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <Grid>
                                                                            <Border Width="16" Height="16" CornerRadius="8"
                                                                                    Background="{DynamicResource GoldBrush}"
                                                                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                                    Margin="2,2,0,0">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding BadgeNumber}" Value="0">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <TextBlock Text="{Binding BadgeNumber}" FontSize="9" FontWeight="Bold"
                                                                                           Foreground="#FFFFFF" HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Title}" FontSize="9"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           Cursor="Hand" ToolTip="Double-clic pour renommer"
                                                                                           MouseLeftButtonDown="PreviewName_Click"/>
                                                                                <TextBox FontSize="9" Padding="1" MinWidth="30"
                                                                                         Visibility="Collapsed"
                                                                                         Text="{Binding Window.CustomName, UpdateSourceTrigger=PropertyChanged}"
                                                                                         Background="#1A1208" Foreground="{DynamicResource GoldBrush}"
                                                                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                                                         LostFocus="PreviewRenameBox_LostFocus"
                                                                                         KeyDown="PreviewRenameBox_KeyDown"/>
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </ScrollViewer>
                        </Border>
                    </Grid>
                    </DockPanel>

                    <!-- Advanced content -->
                    <Grid Grid.Row="3" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <!-- Interactive Canvas -->
                        <Border Grid.Column="0" Background="{DynamicResource PanelBg}" CornerRadius="6"
                                Padding="8" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}">
                            <DockPanel>
                                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Monitors}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel HorizontalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}"
                                                    Background="{DynamicResource PanelBg2}"
                                                    CornerRadius="6" Padding="10,8" Margin="6,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayLabel}" FontSize="12" FontWeight="Bold"
                                                               Foreground="{DynamicResource BrightGoldBrush}"
                                                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                    <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,6">
                                                        <Button Content="▣ Principal" Style="{DynamicResource StoneButton}" FontSize="11" Padding="8,5" Margin="2,0"
                                                                Command="{Binding DataContext.AdvancedVm.AutoLayoutMainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="▥ Frac. V" Style="{DynamicResource StoneButton}" FontSize="11" Padding="8,5" Margin="2,0"
                                                                Command="{Binding DataContext.AdvancedVm.AutoLayoutSplitVCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="▤ Frac. H" Style="{DynamicResource StoneButton}" FontSize="11" Padding="8,5" Margin="2,0"
                                                                Command="{Binding DataContext.AdvancedVm.AutoLayoutSplitHCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </WrapPanel>
                                                    <Button Style="{DynamicResource WowButton}" Padding="16,8"
                                                            Command="{Binding DataContext.AdvancedVm.ApplyMonitorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="⚔ Appliquer le layout" FontSize="12" FontWeight="Bold"
                                                                       HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding DisplayLabel}" FontSize="10"
                                                                       HorizontalAlignment="Center" Opacity="0.8"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid>
                                    <TextBlock Text="Aperçu interactif — Glisser pour déplacer, coins pour redimensionner"
                                               FontSize="10" Foreground="{DynamicResource SubtextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <Border Background="{DynamicResource OverlayBrush}" CornerRadius="4"
                                            Margin="0,18,0,0" BorderThickness="1" BorderBrush="{DynamicResource InnerBorderBrush}"
                                            ClipToBounds="True">
                                        <Canvas x:Name="AdvancedCanvas" Width="600" Height="340"
                                                Background="Transparent"
                                                ClipToBounds="True"
                                                MouseLeftButtonDown="AdvCanvas_MouseDown"
                                                MouseMove="AdvCanvas_MouseMove"
                                                MouseLeftButtonUp="AdvCanvas_MouseUp"/>
                                    </Border>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- Controls panel -->
                        <Border Grid.Column="2" Background="{DynamicResource PanelBg}" CornerRadius="6"
                                Padding="12" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}">
                            <DockPanel>
                                <!-- Apply + status at bottom -->
                                <Button DockPanel.Dock="Bottom" Content="⚔ Appliquer (tous)" Style="{DynamicResource WowButton}"
                                        Command="{Binding AdvancedVm.ApplyAdvancedCommand}" FontSize="13" Padding="20,10"
                                        HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding AdvancedVm.StatusMessage}" FontSize="10"
                                           Foreground="{DynamicResource SubtextBrush}" Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>

                                <!-- Scrollable content above -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <!-- Window list -->
                                        <TextBlock Text="{DynamicResource Adv_Windows}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrightGoldBrush}" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding AvailableWindows}" Margin="0,0,0,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource PanelBg2}" CornerRadius="3"
                                                            Padding="4,3" Margin="0,0,0,2"
                                                            BorderThickness="1" BorderBrush="{DynamicResource InnerBorderBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                                      Style="{DynamicResource SelectionCheck}" Margin="0,0,4,0"
                                                                      VerticalAlignment="Center" ToolTip="Afficher/masquer"/>
                                                            <Border Grid.Column="1" Width="16" Height="16" CornerRadius="8"
                                                                    Background="{DynamicResource GoldBrush}" Margin="0,0,4,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding LaunchOrder}" FontSize="9" FontWeight="Bold"
                                                                           Foreground="#FFFFFF" HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="10"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Cursor="Hand" ToolTip="Cliquer pour renommer"
                                                                           MouseLeftButtonDown="AdvName_Click"/>
                                                                <TextBox FontSize="10" Padding="0" MinWidth="50"
                                                                         Visibility="Collapsed"
                                                                         Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}"
                                                                         Background="#1A1208" Foreground="{DynamicResource GoldBrush}"
                                                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                                         LostFocus="AdvRenameBox_LostFocus"
                                                                         KeyDown="AdvRenameBox_KeyDown"/>
                                                            </Grid>
                                                            <Button Grid.Column="3" FontSize="9" Height="18" Padding="4,1" Margin="2,0"
                                                                    Style="{DynamicResource StoneButton}"
                                                                    Command="{Binding DataContext.SetAsMainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="{Binding IsMainWindow, Converter={StaticResource MainLabelConverter}}"
                                                                    VerticalAlignment="Center" ToolTip="Définir comme leader"/>
                                                            <ComboBox Grid.Column="4" Width="70" Height="20" FontSize="9"
                                                                      ItemsSource="{Binding DataContext.Monitors, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding AssignedMonitor}"
                                                                      VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                                      ToolTip="Écran cible"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{DynamicResource Adv_FineTune}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrightGoldBrush}" Margin="0,0,0,8"/>

                                        <!-- Slot info -->
                                        <Border Background="{DynamicResource PanelBg2}" CornerRadius="4"
                                                Padding="8,6" Margin="0,0,0,8" BorderThickness="1" BorderBrush="{DynamicResource InnerBorderBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding AdvancedVm.SelectedSlot.Window.DisplayName, FallbackValue='Aucune sélection'}"
                                                           FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrightGoldBrush}"/>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X" FontSize="10" Foreground="{DynamicResource SubtextBrush}" Margin="0,0,4,2"/>
                                                    <TextBox Grid.Row="0" Grid.Column="1" FontSize="11" Padding="4,2" Margin="0,0,8,2"
                                                             Text="{Binding AdvancedVm.SelectedSlot.RealX, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Y" FontSize="10" Foreground="{DynamicResource SubtextBrush}" Margin="0,0,4,2"/>
                                                    <TextBox Grid.Row="0" Grid.Column="3" FontSize="11" Padding="4,2" Margin="0,0,0,2"
                                                             Text="{Binding AdvancedVm.SelectedSlot.RealY, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="L" FontSize="10" Foreground="{DynamicResource SubtextBrush}" Margin="0,0,4,0"/>
                                                    <TextBox Grid.Row="1" Grid.Column="1" FontSize="11" Padding="4,2" Margin="0,0,8,0"
                                                             Text="{Binding AdvancedVm.SelectedSlot.RealWidth, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="H" FontSize="10" Foreground="{DynamicResource SubtextBrush}" Margin="0,0,4,0"/>
                                                    <TextBox Grid.Row="1" Grid.Column="3" FontSize="11" Padding="4,2"
                                                             Text="{Binding AdvancedVm.SelectedSlot.RealHeight, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Copy size -->
                                        <TextBlock Text="{DynamicResource Adv_Tools}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource GoldBrush}" Margin="0,4,0,4"/>
                                        <WrapPanel Margin="0,0,0,8">
                                            <Button Content="{DynamicResource Adv_CopySize}" Style="{DynamicResource StoneButton}" FontSize="10" Padding="6,4" Margin="0,0,3,3"
                                                    Command="{Binding AdvancedVm.CopySizeCommand}"/>
                                            <Button Content="{DynamicResource Adv_PasteSize}" Style="{DynamicResource StoneButton}" FontSize="10" Padding="6,4" Margin="0,0,3,3"
                                                    Command="{Binding AdvancedVm.PasteSizeCommand}"
                                                    IsEnabled="{Binding AdvancedVm.HasCopiedSize}"/>
                                            <Button Content="{DynamicResource Adv_ApplyAll}" Style="{DynamicResource StoneButton}" FontSize="10" Padding="6,4" Margin="0,0,3,3"
                                                    Command="{Binding AdvancedVm.ApplySizeToAllCommand}"/>
                                            <Button Content="{DynamicResource Adv_Swap}" Style="{DynamicResource StoneButton}" FontSize="10" Padding="6,4" Margin="0,0,3,3"
                                                    Command="{Binding AdvancedVm.StartSwapCommand}"/>
                                        </WrapPanel>

                                        <!-- Presets -->
                                        <TextBlock Text="{DynamicResource Adv_Presets}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource GoldBrush}" Margin="0,4,0,4"/>
                                        <ComboBox ItemsSource="{Binding AdvancedVm.Presets}"
                                                  SelectedItem="{Binding AdvancedVm.SelectedPreset}"
                                                  DisplayMemberPath="Name" Height="28" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button Content="Charger" Style="{DynamicResource StoneButton}" FontSize="10" Padding="8,4"
                                                    Command="{Binding AdvancedVm.LoadPresetCommand}"/>
                                            <Button Content="Supprimer" Style="{DynamicResource StoneButton}" FontSize="10" Padding="8,4" Margin="4,0,0,0"
                                                    Command="{Binding AdvancedVm.DeletePresetCommand}"/>
                                        </StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Content="💾" Style="{DynamicResource StoneButton}" FontSize="12" Padding="8,4" Margin="4,0,0,0"
                                                    Command="{Binding AdvancedVm.SavePresetCommand}"/>
                                            <TextBox Text="{Binding AdvancedVm.NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="11" Padding="4,4" ToolTip="Nom du preset"
                                                     Background="{DynamicResource SelectionBgBrush}" Foreground="{DynamicResource TextBrush}"
                                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                        </DockPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Carto content -->
                    <views:CartoView Grid.Row="3" DataContext="{Binding CartoVm}"
                                     Visibility="{Binding DataContext.IsCartoMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                    <!-- Bounty content -->
                    <views:BountyView Grid.Row="3" DataContext="{Binding BountyVm}"
                                      Visibility="{Binding DataContext.IsBountyMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                            <!-- Status bar -->
                            <Border Grid.Row="4" Background="{DynamicResource PanelBg}" CornerRadius="4"
                                    Padding="12,5" Margin="0,8,0,0" BorderThickness="1" BorderBrush="{DynamicResource InnerBorderBrush}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding AppVersion}"
                                               FontSize="10" Foreground="{DynamicResource SubtextBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                                               Foreground="{DynamicResource SubtextBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}"
                                            Margin="10,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsCartoMode, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="🌐" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Visibility="{Binding IsCartoMode, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding CartoVm.SyncStatus}" FontSize="10"
                                               Foreground="LightSkyBlue" VerticalAlignment="Center"
                                               Visibility="{Binding IsCartoMode, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding CartoVm.FriendsSummary}" FontSize="10"
                                               Foreground="{DynamicResource BrightGoldBrush}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsCartoMode, Converter={StaticResource BoolToVis}}"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
    </Grid>
    </Border>
</Window>
