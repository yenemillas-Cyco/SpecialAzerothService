<UserControl x:Class="WindowsOrganiserApp.Controls.CartoItemSearchResultRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WindowsOrganiserApp.Converters"
             xmlns:local="clr-namespace:WindowsOrganiserApp.Controls"
             MinHeight="56">
    <UserControl.Resources>
        <conv:WowClassColorConverter x:Key="ClassColorConv"/>
    </UserControl.Resources>

    <Border Background="#1A221810" CornerRadius="5" Padding="6,5" BorderBrush="#33AA8833" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <local:WowItemSlot Grid.Column="0" DataContext="{Binding Item}"
                               Width="42" Height="42" Margin="0,0,8,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <DockPanel Margin="0,0,0,4">
                    <Image x:Name="ClassIconImage" DockPanel.Dock="Left"
                           Width="22" Height="22" Margin="0,0,6,0"
                           Stretch="Uniform" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource SubtextBrush}" Margin="6,0,0,0">
                        <Run Text="niv. "/><Run Text="{Binding CharacterLevel, Mode=OneWay}"/>
                    </TextBlock>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding CharacterName, Mode=OneWay}"
                                 Foreground="{Binding CharacterClass, Converter={StaticResource ClassColorConv}}"/>
                            <Run Text=" · " Foreground="{DynamicResource SubtextBrush}" FontSize="11" FontWeight="Normal"/>
                            <Run Text="{Binding ClassLabel, Mode=OneWay}"
                                 Foreground="{Binding CharacterClass, Converter={StaticResource ClassColorConv}}"
                                 FontSize="11" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <TextBlock Text="{Binding ItemName}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrightGoldBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding AccountName}"
                               FontSize="9" Foreground="{DynamicResource SubtextBrush}"
                               Opacity="0.75" VerticalAlignment="Center" Margin="6,0,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="90"/>
                    <TextBlock Text="{Binding LocationLine}" FontSize="10"
                               Foreground="#88CCAA" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
